# PACTACLOUD (MINUTEFLOW) - VARIABLES DE ENTORNO
# Copia este archivo a `.env` (NUNCA lo commitees; .gitignore ya excluye .env*).

# ── SERVIDOR (serverless /api/enhance) — NO usar prefijo VITE_ ───────────────
# Clave de Google Gemini AI. Solo existe en el servidor; jamás llega al navegador.
GEMINI_API_KEY=tu_gemini_api_key_aqui
# Origen permitido para /api/enhance (deja vacío para no restringir por origen).
ALLOWED_ORIGIN=https://pactacloud.vercel.app

# ── CLIENTE (prefijo VITE_ = se expone en el bundle, solo valores públicos) ──
# Conexión a Supabase (la anon key es pública por diseño; la seguridad depende de RLS).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_publica_aqui

# OAuth de Google Drive (Client ID público de Google Cloud Console).
VITE_GOOGLE_CLIENT_ID=

# Secreto del webhook de Apps Script (debe coincidir con SHARED_SECRET del script).
# Preferible configurarlo por organización en Configuración > Google Drive.
# Nota: al ser VITE_ queda en el bundle; es defensa en profundidad, no un secreto fuerte.
VITE_DRIVE_WEBHOOK_SECRET=
