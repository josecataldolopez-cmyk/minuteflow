    instruction: "Support custom directories, folder creation, and minute deletion in MinuteEditorView"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { MeetingMinute, Attendee, ActionItem } from \'../types\';\nimport { ContactPickerModal } from \'./ContactPickerModal\';\n\ninterface MinuteEditorViewProps {\n  minute: MeetingMinute | null;\n  onSave: (minute: MeetingMinute, isDraft: boolean) => void;\n  onOpenExport: (minute: MeetingMinute) => void;\n  onBack: () => void;\n  allAttendees: Attendee[];\n  onCreateContact: (newContact: Attendee) => void;\n  onUpdateContact?: (updatedContact: Attendee) => void;\n  onDeleteContact?: (id: string) => void;\n}\n\nexport const MinuteEditorView: React.FC<MinuteEditorViewProps> = ({\n  minute,\n  onSave,\n  onOpenExport,\n  onBack,\n  allAttendees,\n  onCreateContact,\n  onUpdateContact,\n  onDeleteContact\n}) => {\n  // Form State\n  const [title, setTitle] = useState(minute ? minute.title : \'\');\n  const [directory, setDirectory] = useState(minute ? minute.directory : \'Reuniones de Directorio Q3\');"
        replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { MeetingMinute, Attendee, ActionItem, DirectoryItem } from \'../types\';\nimport { ContactPickerModal } from \'./ContactPickerModal\';\n\ninterface MinuteEditorViewProps {\n  minute: MeetingMinute | null;\n  directories?: DirectoryItem[];\n  onSave: (minute: MeetingMinute, isDraft: boolean) => void;\n  onOpenExport: (minute: MeetingMinute) => void;\n  onBack: () => void;\n  allAttendees: Attendee[];\n  onCreateContact: (newContact: Attendee) => void;\n  onUpdateContact?: (updatedContact: Attendee) => void;\n  onDeleteContact?: (id: string) => void;\n  onCreateDirectory?: (name: string) => void;\n  onDeleteMinute?: (id: string) => void;\n}\n\nexport const MinuteEditorView: React.FC<MinuteEditorViewProps> = ({\n  minute,\n  directories = [],\n  onSave,\n  onOpenExport,\n  onBack,\n  allAttendees,\n  onCreateContact,\n  onUpdateContact,\n  onDeleteContact,\n  onCreateDirectory,\n  onDeleteMinute\n}) => {\n  // Form State\n  const defaultDir = directories.length > 0 ? directories[0].name : \'Reuniones de Directorio Q3\';\n  const [title, setTitle] = useState(minute ? minute.title : \'\');\n  const [directory, setDirectory] = useState(minute ? minute.directory : defaultDir);\n  const [isCreatingFolder, setIsCreatingFolder] = useState(false);\n  const [newFolderName, setNewFolderName] = useState(\'\');\n  const [showDeleteConfirm, setShowDeleteConfirm] = useState(false);"
