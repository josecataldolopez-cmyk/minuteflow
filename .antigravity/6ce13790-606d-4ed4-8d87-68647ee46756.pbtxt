    instruction: "Translate DashboardView strings, titles, action items, calendar modal, and FAB to Spanish"
    replacement_infos {
      original_chunk {
        target_content: "        {/* Welcome Briefing Header */}\n        <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4\">\n          <div>\n            <h2 className=\"text-2xl md:text-3xl font-bold text-slate-900 tracking-tight\">\n              Welcome back, Sarah\n            </h2>\n            <p className=\"text-sm text-slate-500 mt-1\">Here&apos;s your briefing for today.</p>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={() => onNavigate(\'library\')}\n              className=\"text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 px-3.5 py-2 rounded-xl transition-all shadow-xs flex items-center gap-1.5 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[18px] text-slate-500\">inventory_2</span>\n              <span>All Minutes ({recentMinutes.length})</span>\n            </button>\n            <button\n              onClick={onNewMinute}\n              className=\"text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 px-3.5 py-2 rounded-xl transition-all shadow-md shadow-indigo-100 flex items-center gap-1.5 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">add</span>\n              <span>Create Minute</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Bento Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 auto-rows-min\">\n          {/* Upcoming Schedule (Span 8) */}\n          <div className=\"bento-card md:col-span-8 flex flex-col h-full min-h-[300px] p-6 bg-white border border-slate-100 rounded-2xl shadow-sm hover:shadow-md transition-shadow\">\n            <div className=\"flex justify-between items-center mb-4\">\n              <h3 className=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n                <span className=\"material-symbols-outlined text-indigo-600 text-[22px]\">event</span>\n                Upcoming Schedule\n              </h3>\n              <button\n                onClick={() => setCalendarModalOpen(true)}\n                className=\"text-indigo-600 hover:text-indigo-700 text-xs font-semibold cursor-pointer flex items-center gap-1\"\n              >\n                <span>View Calendar</span>\n                <span className=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n              </button>\n            </div>\n\n            <div className=\"space-y-3 flex-1\">\n              {schedule.map((item, idx) => (\n                <div\n                  key={item.id}\n                  onClick={() => {\n                    // Quick-create or preview minute for this scheduled meeting\n                    onNewMinute();\n                  }}\n                  className=\"flex items-center gap-4 p-3.5 rounded-xl border border-slate-100 hover:border-indigo-200 hover:bg-slate-50/70 transition-all group cursor-pointer\"\n                >\n                  <div\n                    className={`${\n                      idx === 0\n                        ? \'bg-indigo-50 text-indigo-700 border border-indigo-100\'\n                        : \'bg-slate-100 text-slate-700 border border-slate-200/60\'\n                    } p-2 rounded-xl text-center min-w-[64px] shrink-0`}\n                  >\n                    <div className=\"text-base font-bold leading-none\">{item.time}</div>\n                    <div className=\"text-[10px] font-bold uppercase mt-0.5 tracking-wider\">\n                      {item.ampm}\n                    </div>\n                  </div>\n                  <div className=\"flex-1 min-w-0\">\n                    <h4 className=\"text-sm font-semibold text-slate-900 group-hover:text-indigo-600 transition-colors truncate\">\n                      {item.title}\n                    </h4>\n                    <p className=\"text-xs text-slate-500 flex items-center gap-1.5 mt-0.5\">\n                      <span className=\"material-symbols-outlined text-[14px] text-slate-400\">group</span>\n                      <span className=\"truncate\">{item.participants}</span>\n                    </p>\n                  </div>\n                  <div className=\"hidden sm:flex items-center gap-2\">\n                    <span className=\"bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full text-xs font-medium border border-slate-200/50\">\n                      {item.platform}\n                    </span>\n                    <span className=\"material-symbols-outlined text-slate-400 group-hover:text-indigo-600 text-[18px] opacity-0 group-hover:opacity-100 transition-opacity\">\n                      edit_note\n                    </span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Action Items (Span 4) */}\n          <div className=\"bento-card md:col-span-4 flex flex-col h-full min-h-[300px] p-6 bg-white border border-slate-100 rounded-2xl shadow-sm hover:shadow-md transition-shadow\">\n            <div className=\"flex justify-between items-center mb-4\">\n              <h3 className=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n                <span className=\"material-symbols-outlined text-emerald-600 text-[22px] material-symbols-fill\">\n                  task_alt\n                </span>\n                Action Items\n              </h3>\n              <button\n                onClick={() => setIsAddingAction(!isAddingAction)}\n                title=\"Add action item\"\n                className=\"text-indigo-600 hover:text-indigo-700 text-xs font-semibold hover:bg-indigo-50 p-1.5 rounded-lg transition-colors cursor-pointer\"\n              >\n                <span className=\"material-symbols-outlined text-[18px]\">add</span>\n              </button>\n            </div>\n\n            {/* Inline Add Action Item */}\n            {isAddingAction && (\n              <form onSubmit={handleActionSubmit} className=\"mb-3 flex gap-2\">\n                <input\n                  type=\"text\"\n                  value={newActionText}\n                  onChange={(e) => setNewActionText(e.target.value)}\n                  placeholder=\"New action item...\"\n                  className=\"flex-1 text-xs px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg outline-none focus:bg-white focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500\"\n                  autoFocus\n                />\n                <button\n                  type=\"submit\"\n                  className=\"bg-indigo-600 hover:bg-indigo-700 text-white text-xs px-3 py-1 rounded-lg font-medium shadow-xs\"\n                >\n                  Add\n                </button>\n              </form>\n            )}\n\n            <div className=\"space-y-2 flex-1 overflow-y-auto custom-scrollbar pr-1\">\n              {actionItems.map((action) => (\n                <label\n                  key={action.id}\n                  className={`flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-100 transition-colors cursor-pointer group ${\n                    action.completed ? \'opacity-50\' : \'\'\n                  }`}\n                >\n                  <div className=\"relative flex items-start pt-0.5\">\n                    <input\n                      type=\"checkbox\"\n                      checked={action.completed}\n                      onChange={() => onToggleActionItem(action.id)}\n                      className=\"w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n                    />\n                  </div>\n                  <div className=\"flex-1 min-w-0\">\n                    <p\n                      className={`text-xs font-medium text-slate-800 group-hover:text-indigo-600 transition-colors ${\n                        action.completed ? \'line-through text-slate-400\' : \'\'\n                      }`}\n                    >\n                      {action.text}\n                    </p>\n                    <div className=\"flex items-center gap-1.5 mt-1\">\n                      {action.dueLabel === \'Due Today\' ? (\n                        <span className=\"bg-rose-50 text-rose-700 border border-rose-200/60 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider\">\n                          Due Today\n                        </span>\n                      ) : action.dueLabel === \'Assigned to me\' ? (\n                        <span className=\"bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider border border-slate-200/50\">\n                          Assigned to me\n                        </span>\n                      ) : (\n                        <span className=\"bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full text-[10px] font-medium border border-slate-200/50\">\n                          {action.dueLabel || \'Pending\'}\n                        </span>\n                      )}\n                    </div>\n                  </div>\n                </label>\n              ))}\n            </div>\n          </div>\n\n          {/* Recent Minutes (Span 12) */}\n          <div className=\"bento-card md:col-span-12 p-6 bg-white border border-slate-100 rounded-2xl shadow-sm\">\n            <div className=\"flex justify-between items-center mb-6\">\n              <h3 className=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n                <span className=\"material-symbols-outlined text-indigo-600 text-[22px]\">history</span>\n                Recent Minutes\n              </h3>\n              <button\n                onClick={() => onNavigate(\'library\')}\n                className=\"text-indigo-600 hover:text-indigo-700 text-xs font-semibold cursor-pointer flex items-center gap-1\"\n              >\n                <span>View Library</span>\n                <span className=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n              </button>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6\">\n              {recentMinutes.slice(0, 3).map((minute) => (\n                <div\n                  key={minute.id}\n                  onClick={() => onSelectMinute(minute)}\n                  className=\"border border-slate-100 rounded-2xl p-5 hover:shadow-md hover:border-indigo-200 transition-all cursor-pointer bg-white group relative overflow-hidden flex flex-col justify-between\"\n                >\n                  {/* Status Indicator Bar */}\n                  <div\n                    className={`absolute top-0 left-0 w-1.5 h-full ${\n                      minute.status === \'Approved\' ? \'bg-emerald-500\' : \'bg-indigo-600\'\n                    }`}\n                  />\n\n                  <div>\n                    <div className=\"flex justify-between items-start mb-2 pl-2\">\n                      <span\n                        className={`px-2.5 py-0.5 rounded-full text-xs font-bold flex items-center gap-1 ${\n                          minute.status === \'Approved\'\n                            ? \'bg-emerald-50 text-emerald-700 border border-emerald-200/50\'\n                            : \'bg-indigo-50 text-indigo-700 border border-indigo-200/50\'\n                        }`}\n                      >\n                        <span className=\"material-symbols-outlined text-[14px]\">\n                          {minute.status === \'Approved\' ? \'check_circle\' : \'pending\'}\n                        </span>\n                        {minute.status}\n                      </span>\n                      <span className=\"text-xs text-slate-400 font-medium\">\n                        {minute.formattedDate}\n                      </span>\n                    </div>\n\n                    <h4 className=\"text-base font-semibold text-slate-900 mb-1 pl-2 group-hover:text-indigo-600 transition-colors\">\n                      {minute.title}\n                    </h4>\n                    <p className=\"text-xs text-slate-500 line-clamp-2 pl-2 mb-4 leading-relaxed\">\n                      {minute.pointsTreated.split(\'\\n\')[0]?.replace(/^[\342\200\242\\-\\*]\\s*/, \'\') ||\n                        minute.objectives ||\n                        \'Discussion points captured during executive briefing.\'}\n                    </p>\n                  </div>\n\n                  <div className=\"pl-2 pt-3 border-t border-slate-100 flex items-center justify-between mt-auto\">\n                    <div className=\"flex -space-x-2 overflow-hidden\">\n                      {minute.attendees.map((att) => (\n                        <img\n                          key={att.id}\n                          src={att.avatarUrl}\n                          alt={att.name}\n                          title={att.name}\n                          className=\"w-7 h-7 rounded-full border-2 border-white object-cover\"\n                        />\n                      ))}\n                    </div>\n                    <button\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        onOpenExport(minute);\n                      }}\n                      title=\"Export & Share\"\n                      className=\"text-xs text-indigo-600 hover:text-indigo-700 hover:bg-indigo-50 p-1.5 rounded-lg flex items-center gap-1 transition-colors\"\n                    >\n                      <span className=\"material-symbols-outlined text-[18px]\">ios_share</span>\n                      <span className=\"hidden sm:inline font-semibold\">Export</span>\n                    </button>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Calendar Quick Modal */}\n      {calendarModalOpen && (\n        <div className=\"fixed inset-0 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4 z-50\">\n          <div className=\"bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 animate-in fade-in\">\n            <div className=\"flex justify-between items-center pb-4 border-b border-slate-100\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"material-symbols-outlined text-indigo-600\">calendar_month</span>\n                <h3 className=\"font-bold text-base text-slate-900\">Executive Calendar</h3>\n              </div>\n              <button\n                onClick={() => setCalendarModalOpen(false)}\n                className=\"text-slate-400 hover:text-slate-600 p-1\"\n              >\n                <span className=\"material-symbols-outlined text-[20px]\">close</span>\n              </button>\n            </div>\n            <div className=\"py-4 space-y-3\">\n              <div className=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">\n                Today&apos;s Sessions\n              </div>\n              {schedule.map((s) => (\n                <div\n                  key={s.id}\n                  className=\"p-3 rounded-xl bg-slate-50 border border-slate-100 flex justify-between items-center\"\n                >\n                  <div>\n                    <h4 className=\"font-semibold text-sm text-slate-900\">{s.title}</h4>\n                    <p className=\"text-xs text-slate-500\">{s.time} {s.ampm} \342\200\242 {s.platform}</p>\n                  </div>\n                  <button\n                    onClick={() => {\n                      setCalendarModalOpen(false);\n                      onNewMinute();\n                    }}\n                    className=\"text-xs bg-indigo-600 text-white px-3 py-1.5 rounded-lg font-semibold hover:bg-indigo-700 shadow-sm shadow-indigo-100\"\n                  >\n                    Start Minute\n                  </button>\n                </div>\n              ))}\n            </div>\n            <div className=\"pt-2 text-right\">\n              <button\n                onClick={() => setCalendarModalOpen(false)}\n                className=\"text-xs text-slate-600 font-semibold px-4 py-2 hover:bg-slate-50 rounded-lg\"\n              >\n                Close\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Floating Action Button (FAB) */}\n      <button\n        onClick={onNewMinute}\n        id=\"btn-fab-new-minute\"\n        title=\"Start New Minute Entry\"\n        className=\"fixed bottom-6 right-6 bg-indigo-600 hover:bg-indigo-700 text-white rounded-full p-4 shadow-xl shadow-indigo-200 hover:scale-105 transition-all duration-200 flex items-center justify-center z-40 group cursor-pointer ring-4 ring-white\"\n      >\n        <span className=\"material-symbols-outlined text-[28px] material-symbols-fill\">mic</span>\n        <span className=\"max-w-0 overflow-hidden whitespace-nowrap group-hover:max-w-xs group-hover:ml-2.5 transition-all duration-300 font-semibold text-sm\">\n          New Minute\n        </span>\n      </button>"
        replacement_content: "        {/* Welcome Briefing Header */}\n        <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4\">\n          <div>\n            <h2 className=\"text-2xl md:text-3xl font-bold text-slate-900 tracking-tight\">\n              Bienvenida de nuevo, Sarah\n            </h2>\n            <p className=\"text-sm text-slate-500 mt-1\">Este es tu resumen ejecutivo para hoy.</p>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={() => onNavigate(\'library\')}\n              className=\"text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 px-3.5 py-2 rounded-xl transition-all shadow-xs flex items-center gap-1.5 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[18px] text-slate-500\">inventory_2</span>\n              <span>Todas las Actas ({recentMinutes.length})</span>\n            </button>\n            <button\n              onClick={onNewMinute}\n              className=\"text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 px-3.5 py-2 rounded-xl transition-all shadow-md shadow-indigo-100 flex items-center gap-1.5 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">add</span>\n              <span>Crear Acta</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Bento Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 auto-rows-min\">\n          {/* Upcoming Schedule (Span 8) */}\n          <div className=\"bento-card md:col-span-8 flex flex-col h-full min-h-[300px] p-6 bg-white border border-slate-100 rounded-2xl shadow-sm hover:shadow-md transition-shadow\">\n            <div className=\"flex justify-between items-center mb-4\">\n              <h3 className=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n                <span className=\"material-symbols-outlined text-indigo-600 text-[22px]\">event</span>\n                Agenda Programada\n              </h3>\n              <button\n                onClick={() => setCalendarModalOpen(true)}\n                className=\"text-indigo-600 hover:text-indigo-700 text-xs font-semibold cursor-pointer flex items-center gap-1\"\n              >\n                <span>Ver Calendario</span>\n                <span className=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n              </button>\n            </div>\n\n            <div className=\"space-y-3 flex-1\">\n              {schedule.map((item, idx) => (\n                <div\n                  key={item.id}\n                  onClick={() => {\n                    // Quick-create or preview minute for this scheduled meeting\n                    onNewMinute();\n                  }}\n                  className=\"flex items-center gap-4 p-3.5 rounded-xl border border-slate-100 hover:border-indigo-200 hover:bg-slate-50/70 transition-all group cursor-pointer\"\n                >\n                  <div\n                    className={`${\n                      idx === 0\n                        ? \'bg-indigo-50 text-indigo-700 border border-indigo-100\'\n                        : \'bg-slate-100 text-slate-700 border border-slate-200/60\'\n                    } p-2 rounded-xl text-center min-w-[64px] shrink-0`}\n                  >\n                    <div className=\"text-base font-bold leading-none\">{item.time}</div>\n                    <div className=\"text-[10px] font-bold uppercase mt-0.5 tracking-wider\">\n                      {item.ampm}\n                    </div>\n                  </div>\n                  <div className=\"flex-1 min-w-0\">\n                    <h4 className=\"text-sm font-semibold text-slate-900 group-hover:text-indigo-600 transition-colors truncate\">\n                      {item.title}\n                    </h4>\n                    <p className=\"text-xs text-slate-500 flex items-center gap-1.5 mt-0.5\">\n                      <span className=\"material-symbols-outlined text-[14px] text-slate-400\">group</span>\n                      <span className=\"truncate\">{item.participants}</span>\n                    </p>\n                  </div>\n                  <div className=\"hidden sm:flex items-center gap-2\">\n                    <span className=\"bg-slate-100 text-slate-600 px-2.5 py-1 rounded-full text-xs font-medium border border-slate-200/50\">\n                      {item.platform}\n                    </span>\n                    <span className=\"material-symbols-outlined text-slate-400 group-hover:text-indigo-600 text-[18px] opacity-0 group-hover:opacity-100 transition-opacity\">\n                      edit_note\n                    </span>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          {/* Action Items (Span 4) */}\n          <div className=\"bento-card md:col-span-4 flex flex-col h-full min-h-[300px] p-6 bg-white border border-slate-100 rounded-2xl shadow-sm hover:shadow-md transition-shadow\">\n            <div className=\"flex justify-between items-center mb-4\">\n              <h3 className=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n                <span className=\"material-symbols-outlined text-emerald-600 text-[22px] material-symbols-fill\">\n                  task_alt\n                </span>\n                Tareas y Acuerdos\n              </h3>\n              <button\n                onClick={() => setIsAddingAction(!isAddingAction)}\n                title=\"Agregar tarea o acuerdo\"\n                className=\"text-indigo-600 hover:text-indigo-700 text-xs font-semibold hover:bg-indigo-50 p-1.5 rounded-lg transition-colors cursor-pointer\"\n              >\n                <span className=\"material-symbols-outlined text-[18px]\">add</span>\n              </button>\n            </div>\n\n            {/* Inline Add Action Item */}\n            {isAddingAction && (\n              <form onSubmit={handleActionSubmit} className=\"mb-3 flex gap-2\">\n                <input\n                  type=\"text\"\n                  value={newActionText}\n                  onChange={(e) => setNewActionText(e.target.value)}\n                  placeholder=\"Nueva tarea o compromiso...\"\n                  className=\"flex-1 text-xs px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg outline-none focus:bg-white focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500\"\n                  autoFocus\n                />\n                <button\n                  type=\"submit\"\n                  className=\"bg-indigo-600 hover:bg-indigo-700 text-white text-xs px-3 py-1 rounded-lg font-medium shadow-xs\"\n                >\n                  Agregar\n                </button>\n              </form>\n            )}\n\n            <div className=\"space-y-2 flex-1 overflow-y-auto custom-scrollbar pr-1\">\n              {actionItems.map((action) => (\n                <label\n                  key={action.id}\n                  className={`flex items-start gap-3 p-2.5 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-100 transition-colors cursor-pointer group ${\n                    action.completed ? \'opacity-50\' : \'\'\n                  }`}\n                >\n                  <div className=\"relative flex items-start pt-0.5\">\n                    <input\n                      type=\"checkbox\"\n                      checked={action.completed}\n                      onChange={() => onToggleActionItem(action.id)}\n                      className=\"w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n                    />\n                  </div>\n                  <div className=\"flex-1 min-w-0\">\n                    <p\n                      className={`text-xs font-medium text-slate-800 group-hover:text-indigo-600 transition-colors ${\n                        action.completed ? \'line-through text-slate-400\' : \'\'\n                      }`}\n                    >\n                      {action.text}\n                    </p>\n                    <div className=\"flex items-center gap-1.5 mt-1\">\n                      {action.dueLabel === \'Due Today\' || action.dueLabel === \'Vence hoy\' ? (\n                        <span className=\"bg-rose-50 text-rose-700 border border-rose-200/60 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider\">\n                          Vence hoy\n                        </span>\n                      ) : action.dueLabel === \'Assigned to me\' || action.dueLabel === \'Asignado a m\303\255\' ? (\n                        <span className=\"bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider border border-slate-200/50\">\n                          Asignado a m\303\255\n                        </span>\n                      ) : (\n                        <span className=\"bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full text-[10px] font-medium border border-slate-200/50\">\n                          {action.dueLabel || \'Pendiente\'}\n                        </span>\n                      )}\n                    </div>\n                  </div>\n                </label>\n              ))}\n            </div>\n          </div>\n\n          {/* Recent Minutes (Span 12) */}\n          <div className=\"bento-card md:col-span-12 p-6 bg-white border border-slate-100 rounded-2xl shadow-sm\">\n            <div className=\"flex justify-between items-center mb-6\">\n              <h3 className=\"text-lg font-bold text-slate-900 flex items-center gap-2\">\n                <span className=\"material-symbols-outlined text-indigo-600 text-[22px]\">history</span>\n                Actas Recientes\n              </h3>\n              <button\n                onClick={() => onNavigate(\'library\')}\n                className=\"text-indigo-600 hover:text-indigo-700 text-xs font-semibold cursor-pointer flex items-center gap-1\"\n              >\n                <span>Ver Biblioteca</span>\n                <span className=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n              </button>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6\">\n              {recentMinutes.slice(0, 3).map((minute) => (\n                <div\n                  key={minute.id}\n                  onClick={() => onSelectMinute(minute)}\n                  className=\"border border-slate-100 rounded-2xl p-5 hover:shadow-md hover:border-indigo-200 transition-all cursor-pointer bg-white group relative overflow-hidden flex flex-col justify-between\"\n                >\n                  {/* Status Indicator Bar */}\n                  <div\n                    className={`absolute top-0 left-0 w-1.5 h-full ${\n                      minute.status === \'Approved\' || minute.status === \'Aprobada\' ? \'bg-emerald-500\' : \'bg-indigo-600\'\n                    }`}\n                  />\n\n                  <div>\n                    <div className=\"flex justify-between items-start mb-2 pl-2\">\n                      <span\n                        className={`px-2.5 py-0.5 rounded-full text-xs font-bold flex items-center gap-1 ${\n                          minute.status === \'Approved\' || minute.status === \'Aprobada\'\n                            ? \'bg-emerald-50 text-emerald-700 border border-emerald-200/50\'\n                            : \'bg-indigo-50 text-indigo-700 border border-indigo-200/50\'\n                        }`}\n                      >\n                        <span className=\"material-symbols-outlined text-[14px]\">\n                          {minute.status === \'Approved\' || minute.status === \'Aprobada\' ? \'check_circle\' : \'pending\'}\n                        </span>\n                        {minute.status}\n                      </span>\n                      <span className=\"text-xs text-slate-400 font-medium\">\n                        {minute.formattedDate}\n                      </span>\n                    </div>\n\n                    <h4 className=\"text-base font-semibold text-slate-900 mb-1 pl-2 group-hover:text-indigo-600 transition-colors\">\n                      {minute.title}\n                    </h4>\n                    <p className=\"text-xs text-slate-500 line-clamp-2 pl-2 mb-4 leading-relaxed\">\n                      {minute.pointsTreated.split(\'\\n\')[0]?.replace(/^[\342\200\242\\-\\*]\\s*/, \'\') ||\n                        minute.objectives ||\n                        \'Puntos de acuerdo capturados durante la reuni\303\263n ejecutiva.\'}\n                    </p>\n                  </div>\n\n                  <div className=\"pl-2 pt-3 border-t border-slate-100 flex items-center justify-between mt-auto\">\n                    <div className=\"flex -space-x-2 overflow-hidden\">\n                      {minute.attendees.map((att) => (\n                        <img\n                          key={att.id}\n                          src={att.avatarUrl}\n                          alt={att.name}\n                          title={att.name}\n                          className=\"w-7 h-7 rounded-full border-2 border-white object-cover\"\n                        />\n                      ))}\n                    </div>\n                    <button\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        onOpenExport(minute);\n                      }}\n                      title=\"Exportar y Compartir\"\n                      className=\"text-xs text-indigo-600 hover:text-indigo-700 hover:bg-indigo-50 p-1.5 rounded-lg flex items-center gap-1 transition-colors\"\n                    >\n                      <span className=\"material-symbols-outlined text-[18px]\">ios_share</span>\n                      <span className=\"hidden sm:inline font-semibold\">Exportar</span>\n                    </button>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Calendar Quick Modal */}\n      {calendarModalOpen && (\n        <div className=\"fixed inset-0 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4 z-50\">\n          <div className=\"bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 animate-in fade-in\">\n            <div className=\"flex justify-between items-center pb-4 border-b border-slate-100\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"material-symbols-outlined text-indigo-600\">calendar_month</span>\n                <h3 className=\"font-bold text-base text-slate-900\">Calendario Ejecutivo</h3>\n              </div>\n              <button\n                onClick={() => setCalendarModalOpen(false)}\n                className=\"text-slate-400 hover:text-slate-600 p-1\"\n              >\n                <span className=\"material-symbols-outlined text-[20px]\">close</span>\n              </button>\n            </div>\n            <div className=\"py-4 space-y-3\">\n              <div className=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">\n                Sesiones de Hoy\n              </div>\n              {schedule.map((s) => (\n                <div\n                  key={s.id}\n                  className=\"p-3 rounded-xl bg-slate-50 border border-slate-100 flex justify-between items-center\"\n                >\n                  <div>\n                    <h4 className=\"font-semibold text-sm text-slate-900\">{s.title}</h4>\n                    <p className=\"text-xs text-slate-500\">{s.time} {s.ampm} \342\200\242 {s.platform}</p>\n                  </div>\n                  <button\n                    onClick={() => {\n                      setCalendarModalOpen(false);\n                      onNewMinute();\n                    }}\n                    className=\"text-xs bg-indigo-600 text-white px-3 py-1.5 rounded-lg font-semibold hover:bg-indigo-700 shadow-sm shadow-indigo-100\"\n                  >\n                    Iniciar Acta\n                  </button>\n                </div>\n              ))}\n            </div>\n            <div className=\"pt-2 text-right\">\n              <button\n                onClick={() => setCalendarModalOpen(false)}\n                className=\"text-xs text-slate-600 font-semibold px-4 py-2 hover:bg-slate-50 rounded-lg\"\n              >\n                Cerrar\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Floating Action Button (FAB) */}\n      <button\n        onClick={onNewMinute}\n        id=\"btn-fab-new-minute\"\n        title=\"Iniciar Nueva Acta con Voz o Texto\"\n        className=\"fixed bottom-6 right-6 bg-indigo-600 hover:bg-indigo-700 text-white rounded-full p-4 shadow-xl shadow-indigo-200 hover:scale-105 transition-all duration-200 flex items-center justify-center z-40 group cursor-pointer ring-4 ring-white\"\n      >\n        <span className=\"material-symbols-outlined text-[28px] material-symbols-fill\">mic</span>\n        <span className=\"max-w-0 overflow-hidden whitespace-nowrap group-hover:max-w-xs group-hover:ml-2.5 transition-all duration-300 font-semibold text-sm\">\n          Nueva Acta\n        </span>\n      </button>"
      }
      num_matches: 1
    }
  }
}
