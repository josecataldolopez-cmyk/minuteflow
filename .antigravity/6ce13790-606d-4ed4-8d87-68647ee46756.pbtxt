    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Attendee } from \'../types\';\nimport { INITIAL_ATTENDEES } from \'../data/mockData\';\n\ninterface ContactPickerModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  currentAttendees: Attendee[];\n  onAddAttendee: (attendee: Attendee) => void;\n}\n\nexport const ContactPickerModal: React.FC<ContactPickerModalProps> = ({\n  isOpen,\n  onClose,\n  currentAttendees,\n  onAddAttendee\n}) => {\n  const [search, setSearch] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  const filtered = INITIAL_ATTENDEES.filter(\n    (c) =>\n      c.name.toLowerCase().includes(search.toLowerCase()) ||\n      c.email.toLowerCase().includes(search.toLowerCase()) ||\n      (c.role && c.role.toLowerCase().includes(search.toLowerCase()))\n  );\n\n  return (\n    <div className=\"fixed inset-0 bg-black/40 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n      <div className=\"bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-[#c6c5d4]/40 animate-in fade-in\">\n        <div className=\"flex justify-between items-center pb-3 border-b border-[#e2e2e2]\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-[#000666]\">contacts</span>\n            <h3 className=\"font-bold text-base text-[#1a1c1c]\">Select Attendees</h3>\n          </div>\n          <button onClick={onClose} className=\"text-[#767683] hover:text-[#1a1c1c] p-1\">\n            <span className=\"material-symbols-outlined text-[20px]\">close</span>\n          </button>\n        </div>\n\n        <div className=\"my-4\">\n          <input\n            type=\"text\"\n            value={search}\n            onChange={(e) => setSearch(e.target.value)}\n            placeholder=\"Search team by name, role or email...\"\n            className=\"w-full text-xs px-3.5 py-2.5 rounded-xl border border-[#c6c5d4] bg-[#f9f9f9] focus:bg-white outline-none focus:ring-2 focus:ring-[#000666]/20\"\n            autoFocus\n          />\n        </div>\n\n        <div className=\"space-y-2 max-h-64 overflow-y-auto custom-scrollbar pr-1\">\n          {filtered.map((contact) => {\n            const isAlreadyAdded = currentAttendees.some((a) => a.id === contact.id);\n            return (\n              <div\n                key={contact.id}\n                onClick={() => {\n                  if (!isAlreadyAdded) {\n                    onAddAttendee(contact);\n                    onClose();\n                  }\n                }}\n                className={`flex items-center justify-between p-2.5 rounded-xl transition-colors ${\n                  isAlreadyAdded\n                    ? \'bg-[#f3f3f3] opacity-60 cursor-not-allowed\'\n                    : \'hover:bg-[#f9f9f9] cursor-pointer border border-transparent hover:border-[#e2e2e2]\'\n                }`}\n              >\n                <div className=\"flex items-center gap-3\">\n                  <img\n                    src={contact.avatarUrl}\n                    alt={contact.name}\n                    className=\"w-9 h-9 rounded-full object-cover\"\n                  />\n                  <div>\n                    <h4 className=\"text-xs font-bold text-[#1a1c1c]\">{contact.name}</h4>\n                    <p className=\"text-[11px] text-[#767683]\">{contact.role} \342\200\242 {contact.email}</p>\n                  </div>\n                </div>\n\n                <span\n                  className={`text-xs px-2.5 py-1 rounded-full font-semibold ${\n                    isAlreadyAdded\n                      ? \'text-[#767683] bg-[#e2e2e2]\'\n                      : \'text-[#000666] bg-[#e0e0ff] hover:bg-[#bdc2ff]\'\n                  }`}\n                >\n                  {isAlreadyAdded ? \'Added\' : \'+ Add\'}\n                </span>\n              </div>\n            );\n          })}\n        </div>\n\n        <div className=\"mt-4 pt-3 border-t border-[#e2e2e2] text-right\">\n          <button\n            onClick={onClose}\n            className=\"text-xs text-[#000666] font-semibold px-4 py-2 hover:bg-[#f3f3f3] rounded-lg\"\n          >\n            Done\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
