  file_change {
    absolute_path_uri: "file:///src/components/MinuteEditorView.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { MeetingMinute, Attendee, ActionItem } from \'../types\';\nimport { INITIAL_ATTENDEES } from \'../data/mockData\';\n\ninterface MinuteEditorViewProps {\n  minute: MeetingMinute | null;\n  onSave: (minute: MeetingMinute, isDraft: boolean) => void;\n  onOpenExport: (minute: MeetingMinute) => void;\n  onBack: () => void;\n  allAttendees: Attendee[];\n  onOpenContactPicker: () => void;\n}\n\nexport const MinuteEditorView: React.FC<MinuteEditorViewProps> = ({\n  minute,\n  onSave,\n  onOpenExport,\n  onBack,\n  onOpenContactPicker\n}) => {\n  // Form State\n  const [title, setTitle] = useState(minute ? minute.title : \'\');\n  const [directory, setDirectory] = useState(minute ? minute.directory : \'Reuniones de Directorio Q3\');\n  const [date, setDate] = useState(minute ? minute.date : new Date().toISOString().split(\'T\')[0]);\n  const [time, setTime] = useState(minute?.time || \'10:00\');\n  const [objectives, setObjectives] = useState(minute?.objectives || \'\');\n  const [pointsTreated, setPointsTreated] = useState(\n    minute?.pointsTreated ||\n      \'\342\200\242 Se revisaron las m\303\251tricas de rendimiento y objetivos estrat\303\251gicos.\\n\342\200\242 Se aprob\303\263 la reasignaci\303\263n de presupuesto para adquisici\303\263n digital.\\n\342\200\242 El equipo legal proceder\303\241 con la redacci\303\263n de contratos.\'\n  );\n  const [attendees, setAttendees] = useState<Attendee[]>(\n    minute?.attendees || [INITIAL_ATTENDEES[0], INITIAL_ATTENDEES[1]]\n  );\n  const [nextSessionDate, setNextSessionDate] = useState(\n    minute?.nextSessionDate || \'2026-11-15\'\n  );\n  const [syncCalendar, setSyncCalendar] = useState(\n    minute?.syncCalendar !== undefined ? minute.syncCalendar : true\n  );\n  const [actionItems, setActionItems] = useState<ActionItem[]>(\n    minute?.actionItems || [\n      {\n        id: \'act-ed-1\',\n        text: \'Finalizar informe de presupuesto Q4\',\n        completed: false,\n        assignedTo: INITIAL_ATTENDEES[0]\n      },\n      {\n        id: \'act-ed-2\',\n        text: \'Preparar modelos financieros para revisi\303\263n\',\n        completed: false,\n        assignedTo: INITIAL_ATTENDEES[1]\n      }\n    ]\n  );"
      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { MeetingMinute, Attendee, ActionItem } from \'../types\';\nimport { ContactPickerModal } from \'./ContactPickerModal\';\n\ninterface MinuteEditorViewProps {\n  minute: MeetingMinute | null;\n  onSave: (minute: MeetingMinute, isDraft: boolean) => void;\n  onOpenExport: (minute: MeetingMinute) => void;\n  onBack: () => void;\n  allAttendees: Attendee[];\n  onCreateContact: (newContact: Attendee) => void;\n  onDeleteContact?: (id: string) => void;\n}\n\nexport const MinuteEditorView: React.FC<MinuteEditorViewProps> = ({\n  minute,\n  onSave,\n  onOpenExport,\n  onBack,\n  allAttendees,\n  onCreateContact,\n  onDeleteContact\n}) => {\n  // Form State\n  const [title, setTitle] = useState(minute ? minute.title : \'\');\n  const [directory, setDirectory] = useState(minute ? minute.directory : \'Reuniones de Directorio Q3\');\n  const [date, setDate] = useState(minute ? minute.date : new Date().toISOString().split(\'T\')[0]);\n  const [time, setTime] = useState(minute?.time || \'10:00\');\n  const [objectives, setObjectives] = useState(minute?.objectives || \'\');\n  const [pointsTreated, setPointsTreated] = useState(\n    minute?.pointsTreated ||\n      \'\342\200\242 Se revisaron las m\303\251tricas de rendimiento y objetivos estrat\303\251gicos.\\n\342\200\242 Se aprob\303\263 la reasignaci\303\263n de presupuesto para adquisici\303\263n digital.\\n\342\200\242 El equipo legal proceder\303\241 con la redacci\303\263n de contratos.\'\n  );\n  const [attendees, setAttendees] = useState<Attendee[]>(\n    minute?.attendees || (allAttendees.length >= 2 ? [allAttendees[0], allAttendees[1]] : allAttendees)\n  );\n  const [nextSessionDate, setNextSessionDate] = useState(\n    minute?.nextSessionDate || \'2026-11-15\'\n  );\n  const [syncCalendar, setSyncCalendar] = useState(\n    minute?.syncCalendar !== undefined ? minute.syncCalendar : true\n  );\n  const [actionItems, setActionItems] = useState<ActionItem[]>(\n    minute?.actionItems || [\n      {\n        id: \'act-ed-1\',\n        text: \'Finalizar informe de presupuesto Q4\',\n        completed: false,\n        assignedTo: allAttendees[0]\n      },\n      {\n        id: \'act-ed-2\',\n        text: \'Preparar modelos financieros para revisi\303\263n\',\n        completed: false,\n        assignedTo: allAttendees[1] || allAttendees[0]\n      }\n    ]\n  );\n\n  const [contactPickerOpen, setContactPickerOpen] = useState(false);\n  const [assigningActionId, setAssigningActionId] = useState<string | null>(null);\n\n  // Dictation / Voice Transcription State\n  const [isListening, setIsListening] = useState(false);\n  const [transcriptionText, setTranscriptionText] = useState(\n    \'El acuerdo principal es que el \303\241rea de operaciones gestionar\303\241 el despliegue regional...\'\n  );\n  const [showTranscriptionBox, setShowTranscriptionBox] = useState(true);\n  const speechRecognitionRef = useRef<any>(null);\n\n  // Speech Recognition setup with simulation fallback\n  useEffect(() => {\n    const SpeechRecognition =\n      (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;\n\n    if (SpeechRecognition) {\n      try {\n        const recognition = new SpeechRecognition();\n        recognition.continuous = true;\n        recognition.interimResults = true;\n        recognition.lang = \'es-ES\';\n\n        recognition.onresult = (event: any) => {\n          let currentTranscript = \'\';\n          for (let i = event.resultIndex; i < event.results.length; i++) {\n            currentTranscript += event.results[i][0].transcript;\n          }\n          if (currentTranscript) {\n            setTranscriptionText(currentTranscript);\n          }\n        };\n\n        recognition.onerror = () => {\n          simulateVoiceNotes();\n        };\n\n        speechRecognitionRef.current = recognition;\n      } catch (err) {\n        console.warn(\'SpeechRecognition init failed, using simulation mode\', err);\n      }\n    }\n  }, []);\n\n  const simulateVoiceNotes = () => {\n    const samplePhrases = [\n      \'Se revis\303\263 la hoja de ruta de producto y se alinearon los hitos del trimestre...\',\n      \'Aprobada la asignaci\303\263n presupuestaria para auditor\303\255a de ciberseguridad...\',\n      \'Punto de acci\303\263n para que el equipo env\303\255e la presentaci\303\263n final antes del viernes...\',\n      \'Se acuerda iniciar el dimensionamiento t\303\251cnico con los proveedores de ingenier\303\255a...\'\n    ];\n    let phraseIndex = 0;\n    const interval = setInterval(() => {\n      if (!isListening) {\n        clearInterval(interval);\n        return;\n      }\n      setTranscriptionText(samplePhrases[phraseIndex % samplePhrases.length]);\n      phraseIndex++;\n    }, 4000);\n  };\n\n  const toggleListening = () => {\n    if (isListening) {\n      setIsListening(false);\n      try {\n        speechRecognitionRef.current?.stop();\n      } catch (e) {}\n    } else {\n      setIsListening(true);\n      setShowTranscriptionBox(true);\n      try {\n        speechRecognitionRef.current?.start();\n      } catch (e) {\n        simulateVoiceNotes();\n      }\n    }\n  };\n\n  const handleInsertTranscription = () => {\n    if (transcriptionText.trim()) {\n      setPointsTreated((prev) => `${prev.trim()}\\n\342\200\242 ${transcriptionText.trim()}`);\n    }\n  };\n\n  const handleAddActionItem = () => {\n    const newItem: ActionItem = {\n      id: `act-${Date.now()}`,\n      text: \'\',\n      completed: false\n    };\n    setActionItems([...actionItems, newItem]);\n  };\n\n  const handleUpdateActionItem = (id: string, text: string) => {\n    setActionItems(actionItems.map((item) => (item.id === id ? { ...item, text } : item)));\n  };\n\n  const handleToggleActionItem = (id: string) => {\n    setActionItems(\n      actionItems.map((item) =>\n        item.id === id ? { ...item, completed: !item.completed } : item\n      )\n    );\n  };\n\n  const handleDeleteActionItem = (id: string) => {\n    setActionItems(actionItems.filter((item) => item.id !== id));\n  };\n\n  const handleAssignActionItem = (actionId: string, attendee: Attendee | undefined) => {\n    setActionItems(\n      actionItems.map((item) =>\n        item.id === actionId ? { ...item, assignedTo: attendee } : item\n      )\n    );\n    setAssigningActionId(null);\n  };\n\n  const handleToggleAttendee = (attendee: Attendee) => {\n    const exists = attendees.some((a) => a.id === attendee.id);\n    if (exists) {\n      setAttendees(attendees.filter((a) => a.id !== attendee.id));\n    } else {\n      setAttendees([...attendees, attendee]);\n    }\n  };\n\n  const handleRemoveAttendee = (attId: string) => {\n    setAttendees(attendees.filter((a) => a.id !== attId));\n  };\n\n  const handleSave = (isDraft: boolean) => {\n    const updatedMinute: MeetingMinute = {\n      id: minute?.id || `min-${Date.now()}`,\n      title: title.trim() || \'Acta de Reuni\303\263n Sin T\303\255tulo\',\n      directory,\n      date,\n      formattedDate: new Date(date).toLocaleDateString(\'es-ES\', {\n        month: \'short\',\n        day: \'numeric\',\n        year: \'numeric\'\n      }),\n      time,\n      status: isDraft ? \'Borrador\' : \'Aprobada\',\n      objectives,\n      pointsTreated,\n      keyDecisions: pointsTreated\n        .split(\'\\n\')\n        .filter((l) => l.trim().length > 0)\n        .slice(0, 3)\n        .map((l) => l.replace(/^[\342\200\242\\-\\*]\\s*/, \'\')),\n      actionItems: actionItems.filter((a) => a.text.trim().length > 0),\n      attendees,\n      nextSessionDate,\n      syncCalendar,\n      folderPath: `${directory} / Notas`,\n      lastEdited: \'Justo ahora\'\n    };\n\n    onSave(updatedMinute, isDraft);\n  };\n\n  // Text formatting helpers for toolbar\n  const insertFormatting = (prefix: string, suffix: string = \'\') => {\n    const textarea = document.getElementById(\'points-treated-textarea\') as HTMLTextAreaElement;\n    if (!textarea) return;\n    const start = textarea.selectionStart;\n    const end = textarea.selectionEnd;\n    const selectedText = pointsTreated.substring(start, end) || \'Punto de discusi\303\263n\';\n    const replacement = `${prefix}${selectedText}${suffix}`;\n    const newText = pointsTreated.substring(0, start) + replacement + pointsTreated.substring(end);\n    setPointsTreated(newText);\n  };\n\n  return (\n    <div className=\"flex-1 flex flex-col h-screen overflow-hidden relative bg-slate-50\">\n      {/* Header Area for Editor */}\n      <header className=\"px-4 md:px-8 py-4 border-b border-slate-100 bg-white/90 backdrop-blur-md flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 shrink-0 z-20\">\n        <div>\n          <div className=\"flex items-center gap-1.5 text-slate-500 text-xs font-medium mb-1\">\n            <button\n              onClick={onBack}\n              className=\"hover:text-indigo-600 flex items-center gap-1 cursor-pointer transition-colors\"\n            >\n              <span className=\"material-symbols-outlined text-[16px]\">arrow_back</span>\n              <span>Proyectos</span>\n            </button>\n            <span className=\"material-symbols-outlined text-[14px] text-slate-300\">chevron_right</span>\n            <span className=\"text-slate-900 font-semibold truncate max-w-[200px]\">\n              {directory}\n            </span>\n          </div>\n          <h1 className=\"text-xl md:text-2xl font-bold text-slate-900 tracking-tight\">\n            {minute ? minute.title : \'Nueva Entrada de Acta\'}\n          </h1>\n        </div>\n\n        <div className=\"flex items-center gap-3 w-full sm:w-auto justify-end\">\n          {minute && (\n            <button\n              onClick={() => onOpenExport(minute)}\n              className=\"px-3.5 py-2 rounded-xl border border-slate-200 hover:border-indigo-600 text-indigo-600 text-xs font-semibold hover:bg-indigo-50/50 transition-all flex items-center gap-1.5 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[16px]\">ios_share</span>\n              <span>Exportar</span>\n            </button>\n          )}\n\n          <button\n            onClick={() => handleSave(true)}\n            id=\"btn-save-draft\"\n            className=\"px-4 py-2 rounded-xl border border-slate-200 text-slate-700 font-semibold text-xs hover:bg-slate-50 transition-colors cursor-pointer\"\n          >\n            Guardar Borrador\n          </button>\n          <button\n            onClick={() => handleSave(false)}\n            id=\"btn-publish-minute\"\n            className=\"px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs transition-colors shadow-md shadow-indigo-100 cursor-pointer flex items-center gap-1.5\"\n          >\n            <span className=\"material-symbols-outlined text-[16px]\">check</span>\n            <span>Publicar Acta</span>\n          </button>\n        </div>\n      </header>\n\n      {/* Main Editor Body */}\n      <div className=\"flex-1 overflow-y-auto p-4 md:p-8 pb-32 custom-scrollbar\">\n        <div className=\"max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-6\">\n          {/* Left Column: Details & Scheduling (4 cols) */}\n          <div className=\"md:col-span-4 flex flex-col gap-6\">\n            {/* Meta Info Card */}\n            <div className=\"bg-white rounded-2xl p-5 flex flex-col gap-4 shadow-sm border border-slate-100\">\n              <h2 className=\"text-sm font-bold text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-2.5\">\n                <span className=\"material-symbols-outlined text-indigo-600 text-[20px]\">info</span>\n                Detalles de la Reuni\303\263n\n              </h2>\n\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-xs font-semibold text-slate-600\">T\303\255tulo</label>\n                <input\n                  type=\"text\"\n                  value={title}\n                  onChange={(e) => setTitle(e.target.value)}\n                  placeholder=\"ej. Revisi\303\263n Estrat\303\251gica Q3\"\n                  className=\"w-full rounded-xl border border-slate-200 bg-slate-50 p-2.5 text-sm text-slate-900 focus:bg-white focus:ring-2 focus:ring-indigo-100 focus:border-indigo-600 outline-none transition-all\"\n                />\n              </div>\n\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-xs font-semibold text-slate-600\">Carpeta de Destino</label>\n                <select\n                  value={directory}\n                  onChange={(e) => setDirectory(e.target.value)}\n                  className=\"w-full rounded-xl border border-slate-200 bg-slate-50 p-2.5 text-xs text-slate-900 focus:bg-white focus:ring-2 focus:ring-indigo-100 focus:border-indigo-600 outline-none font-medium transition-all\"\n                >\n                  <option value=\"Reuniones de Directorio Q3\">Reuniones de Directorio Q3</option>\n                  <option value=\"Fusiones Cliente Alfa\">Fusiones Cliente Alfa</option>\n                  <option value=\"Recursos Humanos\">Recursos Humanos</option>\n                  <option value=\"Revisiones Anuales 2026\">Revisiones Anuales 2026</option>\n                </select>\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-2\">\n                <div className=\"flex flex-col gap-1.5\">\n                  <label className=\"text-xs font-semibold text-slate-600\">Fecha</label>\n                  <input\n                    type=\"date\"\n                    value={date}\n                    onChange={(e) => setDate(e.target.value)}\n                    className=\"w-full rounded-xl border border-slate-200 bg-slate-50 p-2 text-xs text-slate-900 focus:bg-white focus:ring-2 focus:ring-indigo-100 focus:border-indigo-600 outline-none transition-all\"\n                  />\n                </div>\n                <div className=\"flex flex-col gap-1.5\">\n                  <label className=\"text-xs font-semibold text-slate-600\">Hora</label>\n                  <input\n                    type=\"time\"\n                    value={time}\n                    onChange={(e) => setTime(e.target.value)}\n                    className=\"w-full rounded-xl border border-slate-200 bg-slate-50 p-2 text-xs text-slate-900 focus:bg-white focus:ring-2 focus:ring-indigo-100 focus:border-indigo-600 outline-none transition-all\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-xs font-semibold text-slate-600\">Objetivos</label>\n                <textarea\n                  rows={3}\n                  value={objectives}\n                  onChange={(e) => setObjectives(e.target.value)}\n                  placeholder=\"Define las metas y prop\303\263sitos principales...\"\n                  className=\"w-full rounded-xl border border-slate-200 bg-slate-50 p-2.5 text-xs text-slate-900 focus:bg-white focus:ring-2 focus:ring-indigo-100 focus:border-indigo-600 outline-none resize-none transition-all\"\n                />\n              </div>\n            </div>\n\n            {/* Attendees Card with Enhanced Picker */}\n            <div className=\"bg-white rounded-2xl p-5 flex flex-col gap-3 shadow-sm border border-slate-100\">\n              <div className=\"flex justify-between items-center border-b border-slate-100 pb-2\">\n                <div>\n                  <h2 className=\"text-sm font-bold text-slate-900 flex items-center gap-2\">\n                    <span className=\"material-symbols-outlined text-indigo-600 text-[20px]\">groups</span>\n                    Asistentes a la Reuni\303\263n ({attendees.length})\n                  </h2>\n                  <p className=\"text-[11px] text-slate-500\">\n                    Seleccionados para participar y recibir el acta\n                  </p>\n                </div>\n                <button\n                  onClick={() => setContactPickerOpen(true)}\n                  className=\"text-indigo-600 hover:bg-indigo-50 p-1.5 rounded-xl transition-colors cursor-pointer flex items-center gap-1 text-xs font-bold\"\n                  title=\"Gestionar Asistentes\"\n                >\n                  <span className=\"material-symbols-outlined text-[18px]\">person_add</span>\n                  <span>Gestionar</span>\n                </button>\n              </div>\n\n              <div className=\"flex flex-wrap gap-2 pt-1\">\n                {attendees.map((att) => (\n                  <div\n                    key={att.id}\n                    className=\"flex items-center gap-1.5 bg-slate-100/80 hover:bg-slate-100 rounded-full pl-1 pr-2.5 py-1 border border-slate-200 shadow-xs transition-colors\"\n                  >\n                    <img\n                      src={att.avatarUrl}\n                      alt={att.name}\n                      className=\"w-6 h-6 rounded-full object-cover border border-slate-200\"\n                    />\n                    <div className=\"flex flex-col\">\n                      <span className=\"text-xs font-bold text-slate-800 leading-tight\">{att.name}</span>\n                      {att.role && (\n                        <span className=\"text-[9px] text-slate-500 leading-none\">{att.role}</span>\n                      )}\n                    </div>\n                    <button\n                      onClick={() => handleRemoveAttendee(att.id)}\n                      className=\"text-slate-400 hover:text-rose-600 ml-1 text-[16px] leading-none cursor-pointer\"\n                      title=\"Quitar de esta reuni\303\263n\"\n                    >\n                      \303\227\n                    </button>\n                  </div>\n                ))}\n\n                <button\n                  onClick={() => setContactPickerOpen(true)}\n                  className=\"flex items-center gap-1 bg-indigo-50/60 border border-dashed border-indigo-300 rounded-full px-3 py-1.5 cursor-pointer hover:bg-indigo-50 text-xs font-bold text-indigo-600 transition-all\"\n                >\n                  <span className=\"material-symbols-outlined text-[16px]\">add</span>\n                  <span>+ Agregar / Crear Asistente</span>\n                </button>\n              </div>\n            </div>\n\n            {/* Next Session Scheduler */}\n            <div className=\"bg-white rounded-2xl p-5 flex flex-col gap-3 shadow-sm border border-slate-100\">\n              <h2 className=\"text-sm font-bold text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-2\">\n                <span className=\"material-symbols-outlined text-indigo-600 text-[20px]\">\n                  event_upcoming\n                </span>\n                Pr\303\263xima Sesi\303\263n\n              </h2>\n\n              <div className=\"flex flex-col gap-2\">\n                <input\n                  type=\"date\"\n                  value={nextSessionDate}\n                  onChange={(e) => setNextSessionDate(e.target.value)}\n                  className=\"w-full rounded-xl border border-slate-200 bg-slate-50 p-2.5 text-xs text-slate-900 focus:bg-white focus:ring-2 focus:ring-indigo-100 focus:border-indigo-600 outline-none transition-all\"\n                />\n\n                <label className=\"flex items-center gap-2 mt-1 cursor-pointer text-xs font-medium text-slate-700\">\n                  <input\n                    type=\"checkbox\"\n                    checked={syncCalendar}\n                    onChange={(e) => setSyncCalendar(e.target.checked)}\n                    className=\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-4 h-4 cursor-pointer\"\n                  />\n                  <span>Sincronizar con Google Calendar</span>\n                </label>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Column: Note-taking & Action Items (8 cols) */}\n          <div className=\"md:col-span-8 flex flex-col gap-6\">\n            {/* Main Notes Area */}\n            <div className=\"bg-white rounded-2xl flex flex-col h-[460px] shadow-sm border border-slate-100 overflow-hidden\">\n              <div className=\"px-5 py-3 border-b border-slate-100 flex justify-between items-center bg-slate-50/70\">\n                <h2 className=\"text-sm font-bold text-slate-900 flex items-center gap-2\">\n                  <span className=\"material-symbols-outlined text-indigo-600 text-[20px]\">\n                    edit_note\n                  </span>\n                  Puntos Tratados y Acuerdos\n                </h2>\n\n                <div className=\"flex items-center gap-1 bg-white p-1 rounded-xl border border-slate-200 shadow-xs\">\n                  <button\n                    onClick={() => insertFormatting(\'**\', \'**\')}\n                    className=\"p-1 text-slate-600 hover:text-indigo-600 hover:bg-slate-50 rounded-lg transition-colors cursor-pointer\"\n                    title=\"Negrita\"\n                  >\n                    <span className=\"material-symbols-outlined text-[18px]\">format_bold</span>\n                  </button>\n                  <button\n                    onClick={() => insertFormatting(\'*\', \'*\')}\n                    className=\"p-1 text-slate-600 hover:text-indigo-600 hover:bg-slate-50 rounded-lg transition-colors cursor-pointer\"\n                    title=\"Cursiva\"\n                  >\n                    <span className=\"material-symbols-outlined text-[18px]\">format_italic</span>\n                  </button>\n                  <button\n                    onClick={() => insertFormatting(\'\\n\342\200\242 \')}\n                    className=\"p-1 text-slate-600 hover:text-indigo-600 hover:bg-slate-50 rounded-lg transition-colors cursor-pointer\"\n                    title=\"Lista con vi\303\261etas\"\n                  >\n                    <span className=\"material-symbols-outlined text-[18px]\">format_list_bulleted</span>\n                  </button>\n                  <button\n                    onClick={() => insertFormatting(\'\\n1. \')}\n                    className=\"p-1 text-slate-600 hover:text-indigo-600 hover:bg-slate-50 rounded-lg transition-colors cursor-pointer\"\n                    title=\"Lista numerada\"\n                  >\n                    <span className=\"material-symbols-outlined text-[18px]\">format_list_numbered</span>\n                  </button>\n                </div>\n              </div>\n\n              <textarea\n                id=\"points-treated-textarea\"\n                rows={12}\n                value={pointsTreated}\n                onChange={(e) => setPointsTreated(e.target.value)}\n                placeholder=\"Escribe o dicta aqu\303\255 los temas discutidos, acuerdos tomados y notas...\"\n                className=\"w-full flex-1 p-5 text-sm text-slate-900 border-none outline-none resize-none font-sans leading-relaxed custom-scrollbar\"\n              />\n            </div>\n\n            {/* Action Items & Commitments Card */}\n            <div className=\"bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col gap-4\">\n              <div className=\"flex justify-between items-center border-b border-slate-100 pb-3\">\n                <div>\n                  <h3 className=\"text-base font-bold text-slate-900 flex items-center gap-2\">\n                    <span className=\"material-symbols-outlined text-indigo-600 text-[20px]\">\n                      check_circle\n                    </span>\n                    Compromisos y Tareas Derivadas ({actionItems.length})\n                  </h3>\n                  <p className=\"text-xs text-slate-500\">\n                    Asigna responsables de la lista de asistentes a cada tarea\n                  </p>\n                </div>\n                <button\n                  onClick={handleAddActionItem}\n                  className=\"text-xs bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-bold px-3 py-1.5 rounded-xl transition-colors flex items-center gap-1 cursor-pointer\"\n                >\n                  <span className=\"material-symbols-outlined text-[16px]\">add</span>\n                  <span>Nueva Tarea</span>\n                </button>\n              </div>\n\n              <div className=\"flex flex-col gap-2\">\n                {actionItems.map((action) => (\n                  <div\n                    key={action.id}\n                    className=\"flex flex-col sm:flex-row sm:items-center gap-2 p-2.5 rounded-xl hover:bg-slate-50 border border-slate-100 transition-colors group\"\n                  >\n                    <div className=\"flex items-center gap-3 flex-1\">\n                      <input\n                        type=\"checkbox\"\n                        checked={action.completed}\n                        onChange={() => handleToggleActionItem(action.id)}\n                        className=\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-4 h-4 cursor-pointer shrink-0\"\n                      />\n\n                      <input\n                        type=\"text\"\n                        value={action.text}\n                        onChange={(e) => handleUpdateActionItem(action.id, e.target.value)}\n                        placeholder=\"Describir tarea o compromiso...\"\n                        className={`flex-1 bg-transparent border-none focus:ring-0 text-xs text-slate-900 p-0 outline-none ${\n                          action.completed ? \'line-through text-slate-400\' : \'\'\n                        }`}\n                      />\n                    </div>\n\n                    <div className=\"flex items-center justify-end gap-2 pl-7 sm:pl-0 relative\">\n                      {/* Assignee Picker */}\n                      {action.assignedTo ? (\n                        <div className=\"relative\">\n                          <button\n                            type=\"button\"\n                            onClick={() =>\n                              setAssigningActionId(\n                                assigningActionId === action.id ? null : action.id\n                              )\n                            }\n                            className=\"bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200/60 px-2.5 py-1 rounded-full text-[11px] font-semibold flex items-center gap-1.5 transition-colors cursor-pointer\"\n                          >\n                            <img\n                              src={action.assignedTo.avatarUrl}\n                              alt={action.assignedTo.name}\n                              className=\"w-4 h-4 rounded-full object-cover\"\n                            />\n                            <span>{action.assignedTo.name}</span>\n                            <span className=\"material-symbols-outlined text-[12px] text-emerald-600\">\n                              expand_more\n                            </span>\n                          </button>\n                        </div>\n                      ) : (\n                        <button\n                          type=\"button\"\n                          onClick={() =>\n                            setAssigningActionId(\n                              assigningActionId === action.id ? null : action.id\n                            )\n                          }\n                          className=\"text-slate-600 text-[11px] font-medium hover:text-indigo-600 flex items-center gap-1 bg-slate-100 px-2.5 py-1 rounded-full hover:bg-indigo-50 transition-colors cursor-pointer\"\n                        >\n                          <span className=\"material-symbols-outlined text-[14px]\">person_add</span>\n                          <span>Asignar</span>\n                        </button>\n                      )}\n\n                      {/* Dropdown for selecting assignee */}\n                      {assigningActionId === action.id && (\n                        <div className=\"absolute right-0 top-full mt-1 w-56 bg-white rounded-xl shadow-xl border border-slate-100 p-2 z-30 animate-in fade-in\">\n                          <div className=\"text-[10px] uppercase font-bold text-slate-400 px-2 py-1\">\n                            Asignar a:\n                          </div>\n                          <div className=\"space-y-1 max-h-40 overflow-y-auto custom-scrollbar\">\n                            {attendees.map((att) => (\n                              <button\n                                key={att.id}\n                                type=\"button\"\n                                onClick={() => handleAssignActionItem(action.id, att)}\n                                className=\"w-full text-left flex items-center gap-2 p-1.5 rounded-lg hover:bg-indigo-50 transition-colors cursor-pointer\"\n                              >\n                                <img\n                                  src={att.avatarUrl}\n                                  alt={att.name}\n                                  className=\"w-5 h-5 rounded-full object-cover\"\n                                />\n                                <div className=\"min-w-0 flex-1\">\n                                  <div className=\"text-xs font-bold text-slate-900 truncate\">\n                                    {att.name}\n                                  </div>\n                                  <div className=\"text-[10px] text-slate-500 truncate\">{att.role}</div>\n                                </div>\n                              </button>\n                            ))}\n                            {action.assignedTo && (\n                              <button\n                                type=\"button\"\n                                onClick={() => handleAssignActionItem(action.id, undefined)}\n                                className=\"w-full text-left text-xs text-rose-600 hover:bg-rose-50 p-1.5 rounded-lg font-medium transition-colors\"\n                              >\n                                Desasignar\n                              </button>\n                            )}\n                          </div>\n                        </div>\n                      )}\n\n                      <button\n                        onClick={() => handleDeleteActionItem(action.id)}\n                        className=\"text-slate-400 hover:text-rose-600 opacity-80 hover:opacity-100 transition-opacity p-1 cursor-pointer\"\n                        title=\"Eliminar tarea\"\n                      >\n                        <span className=\"material-symbols-outlined text-[18px]\">delete</span>\n                      </button>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Floating Dictation Tool (Bottom-Right) */}\n      <div className=\"fixed bottom-6 right-6 flex flex-col items-end gap-3 z-40\">\n        {/* Live Transcription Box */}\n        {showTranscriptionBox && (\n          <div className=\"bg-white rounded-2xl p-4 w-80 sm:w-96 shadow-2xl border border-slate-100 flex flex-col gap-2 animate-in fade-in slide-in-from-bottom-4\">\n            <div className=\"flex justify-between items-center border-b border-slate-100 pb-1.5\">\n              <span className=\"text-xs font-bold text-indigo-600 flex items-center gap-1.5\">\n                <span\n                  className={`w-2.5 h-2.5 rounded-full ${\n                    isListening ? \'bg-rose-600 animate-ping\' : \'bg-emerald-600\'\n                  }`}\n                />\n                {isListening ? \'Escuchando y transcribiendo...\' : \'Asistente de Voz\'}\n              </span>\n              <button\n                onClick={() => setShowTranscriptionBox(false)}\n                className=\"text-slate-400 hover:text-slate-600 cursor-pointer\"\n              >\n                <span className=\"material-symbols-outlined text-[16px]\">close</span>\n              </button>\n            </div>\n\n            <p className=\"text-xs text-slate-600 italic min-h-[48px] max-h-24 overflow-y-auto leading-relaxed\">\n              &ldquo;{transcriptionText}&rdquo;\n            </p>\n\n            <div className=\"flex justify-between items-center pt-1 border-t border-slate-100\">\n              <span className=\"text-[10px] text-slate-400\">\n                {isListening ? \'Voz a texto en tiempo real\' : \'Haz clic en el micr\303\263fono para dictar\'}\n              </span>\n              <button\n                onClick={handleInsertTranscription}\n                className=\"text-xs font-bold text-indigo-600 hover:bg-indigo-50 px-2.5 py-1 rounded-xl transition-colors cursor-pointer flex items-center gap-1\"\n              >\n                <span className=\"material-symbols-outlined text-[14px]\">add_circle</span>\n                <span>Insertar en Notas</span>\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Mic FAB with Audio Wave Animation */}\n        <button\n          onClick={toggleListening}\n          id=\"btn-voice-dictation-toggle\"\n          title={isListening ? \'Detener grabaci\303\263n de voz\' : \'Iniciar dictado por voz\'}\n          className={`w-14 h-14 rounded-full text-white shadow-xl hover:shadow-2xl hover:scale-105 transition-all flex items-center justify-center relative overflow-hidden group cursor-pointer ring-4 ring-white ${\n            isListening ? \'bg-rose-600\' : \'bg-indigo-600 hover:bg-indigo-700\'\n          }`}\n        >\n          {/* Audio Wave Animation Overlay when recording */}\n          {isListening && (\n            <div className=\"absolute inset-0 flex items-center justify-center gap-[3px] bg-black/20 backdrop-blur-xs\">\n              <div className=\"wave-bar\" />\n              <div className=\"wave-bar\" />\n              <div className=\"wave-bar\" />\n              <div className=\"wave-bar\" />\n              <div className=\"wave-bar\" />\n            </div>\n          )}\n\n          {/* Mic Icon */}\n          <span className=\"material-symbols-outlined text-[28px] relative z-10 material-symbols-fill\">\n            {isListening ? \'mic\' : \'mic_none\'}\n          </span>\n        </button>\n      </div>\n\n      {/* Integrated Contact Picker Modal */}\n      <ContactPickerModal\n        isOpen={contactPickerOpen}\n        onClose={() => setContactPickerOpen(false)}\n        currentAttendees={attendees}\n        allContacts={allAttendees}\n        onToggleAttendee={handleToggleAttendee}\n        onCreateContact={onCreateContact}\n        onDeleteContact={onDeleteContact}\n      />\n    </div>\n  );\n};"
    }
