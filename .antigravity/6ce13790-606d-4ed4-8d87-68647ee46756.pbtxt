    instruction: "Upgrade SettingsView to support full User Profile editing and Attendee Directory management"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\n\ninterface SettingsViewProps {\n  onShowToast: (msg: string) => void;\n}\n\nexport const SettingsView: React.FC<SettingsViewProps> = ({ onShowToast }) => {\n  const [driveEnabled, setDriveEnabled] = useState(true);\n  const [whatsappEnabled, setWhatsappEnabled] = useState(true);\n  const [emailAutoSend, setEmailAutoSend] = useState(false);\n  const [language, setLanguage] = useState(\'en-US\');\n  const [autoSync, setAutoSync] = useState(true);\n\n  const handleSave = () => {\n    onShowToast(\'Configuraci\303\263n actualizada y sincronizada con \303\251xito.\');\n  };\n\n  return (\n    <div className=\"flex-1 overflow-y-auto p-4 md:p-8 bg-slate-50 custom-scrollbar\">\n      <div className=\"max-w-4xl mx-auto pb-24 space-y-6\">\n        <div>\n          <h1 className=\"text-2xl md:text-3xl font-bold text-slate-900 tracking-tight\">\n            Configuraci\303\263n e Integraciones\n          </h1>\n          <p className=\"text-sm text-slate-500 mt-1\">\n            Configura canales de sincronizaci\303\263n ejecutiva, dictado por voz y par\303\241metros de cuenta.\n          </p>\n        </div>\n\n        {/* Profile Card */}\n        <div className=\"bento-card bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n          <h3 className=\"text-base font-bold text-slate-900 border-b border-slate-100 pb-3 mb-4 flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-indigo-600\">person</span>\n            Perfil Ejecutivo\n          </h3>\n          <div className=\"flex flex-col sm:flex-row items-start sm:items-center gap-5\">\n            <img\n              src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBV2OuN03O8TiLGOHeUBlq6SXBGf8lu4IgMQ-YEwmkRLA3qmC5MXmTjD0hdDmGNIRi5FD7n4Jr4C5hxmvn08IMoW0D5BgnfPJ8yGD3aLGOBngDzkgC9FkjKycbeGTIzQGFyxQtY6_7j_X_OzNasGTKLIi0JyIEGvmudlvb_NOD6DAfqYwpN-un5H22BsxXmiJpZvXo-kS4kUri558jTy3GzN6mE-ugOSrdOsAVDbFg03GQqz06YZ1r2_g\"\n              alt=\"Sarah Jenkins\"\n              className=\"w-16 h-16 rounded-full object-cover border-2 border-indigo-600\"\n            />\n            <div className=\"space-y-1\">\n              <h4 className=\"font-bold text-base text-slate-900\">Sarah Jenkins</h4>\n              <p className=\"text-xs text-slate-500\">Vicepresidenta de Operaciones y Miembro del Directorio</p>\n              <p className=\"text-xs text-indigo-600 font-medium\">sarah.j@minuteflow.com</p>\n            </div>\n            <div className=\"sm:ml-auto\">\n              <span className=\"px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-full border border-emerald-200\">\n                Plan Enterprise Activo\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Connected Channels */}\n        <div className=\"bento-card bg-white rounded-2xl p-6 shadow-sm border border-slate-100 space-y-4\">\n          <h3 className=\"text-base font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-indigo-600\">cloud_sync</span>\n            Canales de Sincronizaci\303\263n y Exportaci\303\263n\n          </h3>\n\n          <div className=\"divide-y divide-slate-100\">\n            <div className=\"py-3.5 flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600\">\n                  <span className=\"material-symbols-outlined text-[22px]\">add_to_drive</span>\n                </div>\n                <div>\n                  <h4 className=\"text-sm font-bold text-slate-900\">Sincronizaci\303\263n con Google Drive</h4>\n                  <p className=\"text-xs text-slate-500\">\n                    Genera autom\303\241ticamente versiones en PDF y Google Docs en las carpetas seleccionadas.\n                  </p>\n                </div>\n              </div>\n              <input\n                type=\"checkbox\"\n                checked={driveEnabled}\n                onChange={(e) => setDriveEnabled(e.target.checked)}\n                className=\"w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n              />\n            </div>\n\n            <div className=\"py-3.5 flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600\">\n                  <span className=\"material-symbols-outlined text-[22px]\">chat</span>\n                </div>\n                <div>\n                  <h4 className=\"text-sm font-bold text-slate-900\">Distribuci\303\263n por WhatsApp Business</h4>\n                  <p className=\"text-xs text-slate-500\">\n                    Env\303\255o instant\303\241neo de res\303\272menes ejecutivos con vi\303\261etas estructuradas a grupos de chat.\n                  </p>\n                </div>\n              </div>\n              <input\n                type=\"checkbox\"\n                checked={whatsappEnabled}\n                onChange={(e) => setWhatsappEnabled(e.target.checked)}\n                className=\"w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n              />\n            </div>\n\n            <div className=\"py-3.5 flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600\">\n                  <span className=\"material-symbols-outlined text-[22px]\">mail</span>\n                </div>\n                <div>\n                  <h4 className=\"text-sm font-bold text-slate-900\">Pasarela de Correo Corporativo</h4>\n                  <p className=\"text-xs text-slate-500\">\n                    Env\303\255o formal de actas con archivos PDF adjuntos desde el correo ejecutivo.\n                  </p>\n                </div>\n              </div>\n              <input\n                type=\"checkbox\"\n                checked={emailAutoSend}\n                onChange={(e) => setEmailAutoSend(e.target.checked)}\n                className=\"w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Audio & Speech Dictation Settings */}\n        <div className=\"bento-card bg-white rounded-2xl p-6 shadow-sm border border-slate-100 space-y-4\">\n          <h3 className=\"text-base font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-indigo-600\">mic</span>\n            Dictado por Voz y Transcripci\303\263n\n          </h3>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-xs font-semibold text-slate-500\">Idioma Principal de Dictado</label>\n              <select\n                value={language}\n                onChange={(e) => setLanguage(e.target.value)}\n                className=\"text-xs p-2.5 rounded-xl border border-slate-200 bg-slate-50 outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500\"\n              >\n                <option value=\"es-ES\">Espa\303\261ol (Espa\303\261a / LATAM)</option>\n                <option value=\"en-US\">English (United States / Corporate)</option>\n                <option value=\"fr-FR\">Fran\303\247ais</option>\n                <option value=\"de-DE\">Deutsch</option>\n              </select>\n            </div>\n\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-xs font-semibold text-slate-500\">Autoguardado en Tiempo Real</label>\n              <div className=\"flex items-center gap-2 pt-2\">\n                <input\n                  type=\"checkbox\"\n                  checked={autoSync}\n                  onChange={(e) => setAutoSync(e.target.checked)}\n                  className=\"w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n                />\n                <span className=\"text-xs text-slate-700 font-medium\">\n                  Guardar borradores autom\303\241ticamente cada 30 segundos\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Save button */}\n        <div className=\"flex justify-end gap-3 pt-2\">\n          <button\n            onClick={handleSave}\n            className=\"px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-md shadow-indigo-100 transition-all cursor-pointer\"\n          >\n            Guardar Cambios\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport { UserProfile, Attendee } from \'../types\';\nimport { AVATAR_PRESETS } from \'../data/mockData\';\n\ninterface SettingsViewProps {\n  userProfile: UserProfile;\n  onUpdateUserProfile: (updated: UserProfile) => void;\n  allAttendees: Attendee[];\n  onCreateContact: (newContact: Attendee) => void;\n  onDeleteContact: (id: string) => void;\n  onShowToast: (msg: string) => void;\n}\n\nexport const SettingsView: React.FC<SettingsViewProps> = ({\n  userProfile,\n  onUpdateUserProfile,\n  allAttendees,\n  onCreateContact,\n  onDeleteContact,\n  onShowToast\n}) => {\n  // Profile Edit State\n  const [isEditingProfile, setIsEditingProfile] = useState(false);\n  const [profileName, setProfileName] = useState(userProfile.name);\n  const [profileRole, setProfileRole] = useState(userProfile.role);\n  const [profileEmail, setProfileEmail] = useState(userProfile.email);\n  const [profileDept, setProfileDept] = useState(\n    userProfile.department || \'Direcci\303\263n General de Operaciones\'\n  );\n  const [profileAvatar, setProfileAvatar] = useState(userProfile.avatarUrl);\n  const [customAvatarInput, setCustomAvatarInput] = useState(\'\');\n\n  // Add Contact to Directory State\n  const [isAddingContact, setIsAddingContact] = useState(false);\n  const [contactName, setContactName] = useState(\'\');\n  const [contactRole, setContactRole] = useState(\'\');\n  const [contactEmail, setContactEmail] = useState(\'\');\n  const [contactAvatar, setContactAvatar] = useState(AVATAR_PRESETS[1]);\n\n  // System Settings State\n  const [driveEnabled, setDriveEnabled] = useState(true);\n  const [whatsappEnabled, setWhatsappEnabled] = useState(true);\n  const [emailAutoSend, setEmailAutoSend] = useState(false);\n  const [language, setLanguage] = useState(\'es-ES\');\n  const [autoSync, setAutoSync] = useState(true);\n\n  const handleSaveProfile = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!profileName.trim()) {\n      onShowToast(\'El nombre no puede estar vac\303\255o\');\n      return;\n    }\n\n    const updated: UserProfile = {\n      ...userProfile,\n      name: profileName.trim(),\n      role: profileRole.trim() || \'Ejecutivo\',\n      email: profileEmail.trim() || userProfile.email,\n      department: profileDept.trim(),\n      avatarUrl: customAvatarInput.trim() || profileAvatar\n    };\n\n    onUpdateUserProfile(updated);\n    setIsEditingProfile(false);\n    onShowToast(\'Perfil de usuario actualizado exitosamente.\');\n  };\n\n  const handleCreateContactSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!contactName.trim()) {\n      onShowToast(\'Ingresa el nombre del asistente\');\n      return;\n    }\n\n    const newContact: Attendee = {\n      id: `att-custom-${Date.now()}`,\n      name: contactName.trim(),\n      role: contactRole.trim() || \'Miembro del Equipo\',\n      email:\n        contactEmail.trim() ||\n        `${contactName.toLowerCase().replace(/\\s+/g, \'.\')}@empresa.com`,\n      avatarUrl: contactAvatar\n    };\n\n    onCreateContact(newContact);\n    setContactName(\'\');\n    setContactRole(\'\');\n    setContactEmail(\'\');\n    setIsAddingContact(false);\n    onShowToast(`Asistente \"${newContact.name}\" agregado al directorio.`);\n  };\n\n  const handleSaveGeneral = () => {\n    onShowToast(\'Configuraci\303\263n general y par\303\241metros sincronizados.\');\n  };\n\n  return (\n    <div className=\"flex-1 overflow-y-auto p-4 md:p-8 bg-slate-50 custom-scrollbar\">\n      <div className=\"max-w-4xl mx-auto pb-24 space-y-6\">\n        <div>\n          <h1 className=\"text-2xl md:text-3xl font-bold text-slate-900 tracking-tight\">\n            Configuraci\303\263n y Perfil\n          </h1>\n          <p className=\"text-sm text-slate-500 mt-1\">\n            Personaliza tu identidad ejecutiva, administra los asistentes del directorio y configura canales de exportaci\303\263n.\n          </p>\n        </div>\n\n        {/* Profile Card / Editor */}\n        <div className=\"bento-card bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n          <div className=\"flex justify-between items-center border-b border-slate-100 pb-3 mb-4\">\n            <h3 className=\"text-base font-bold text-slate-900 flex items-center gap-2\">\n              <span className=\"material-symbols-outlined text-indigo-600\">person</span>\n              Perfil del Usuario Ejecutivo\n            </h3>\n            {!isEditingProfile ? (\n              <button\n                onClick={() => {\n                  setProfileName(userProfile.name);\n                  setProfileRole(userProfile.role);\n                  setProfileEmail(userProfile.email);\n                  setProfileDept(userProfile.department || \'\');\n                  setProfileAvatar(userProfile.avatarUrl);\n                  setIsEditingProfile(true);\n                }}\n                className=\"text-xs bg-indigo-50 hover:bg-indigo-100 text-indigo-700 font-semibold px-3.5 py-1.5 rounded-xl transition-all flex items-center gap-1.5 cursor-pointer\"\n              >\n                <span className=\"material-symbols-outlined text-[16px]\">edit</span>\n                <span>Editar Perfil</span>\n              </button>\n            ) : (\n              <button\n                onClick={() => setIsEditingProfile(false)}\n                className=\"text-xs text-slate-500 hover:text-slate-700 font-semibold px-3 py-1.5 rounded-xl hover:bg-slate-100 transition-all cursor-pointer\"\n              >\n                Cancelar\n              </button>\n            )}\n          </div>\n\n          {!isEditingProfile ? (\n            <div className=\"flex flex-col sm:flex-row items-start sm:items-center gap-5\">\n              <img\n                src={userProfile.avatarUrl}\n                alt={userProfile.name}\n                className=\"w-16 h-16 rounded-full object-cover border-2 border-indigo-600 shadow-sm shrink-0\"\n              />\n              <div className=\"space-y-1 min-w-0\">\n                <h4 className=\"font-bold text-lg text-slate-900 truncate\">{userProfile.name}</h4>\n                <p className=\"text-xs text-slate-600 font-medium\">\n                  {userProfile.role} \342\200\242 {userProfile.department || \'Direcci\303\263n General\'}\n                </p>\n                <p className=\"text-xs text-indigo-600 font-medium\">{userProfile.email}</p>\n              </div>\n              <div className=\"sm:ml-auto shrink-0\">\n                <span className=\"px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-full border border-emerald-200\">\n                  {userProfile.plan || \'Plan Enterprise Activo\'}\n                </span>\n              </div>\n            </div>\n          ) : (\n            <form onSubmit={handleSaveProfile} className=\"space-y-4 pt-1\">\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 block mb-1\">\n                    Nombre Completo <span className=\"text-rose-500\">*</span>\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={profileName}\n                    onChange={(e) => setProfileName(e.target.value)}\n                    placeholder=\"ej. Jos\303\251 Cataldo L\303\263pez\"\n                    className=\"w-full text-xs px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500 transition-all\"\n                    required\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 block mb-1\">\n                    Cargo / T\303\255tulo Ejecutivo\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={profileRole}\n                    onChange={(e) => setProfileRole(e.target.value)}\n                    placeholder=\"ej. Director General, Vicepresidente\"\n                    className=\"w-full text-xs px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500 transition-all\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 block mb-1\">\n                    Correo Electr\303\263nico\n                  </label>\n                  <input\n                    type=\"email\"\n                    value={profileEmail}\n                    onChange={(e) => setProfileEmail(e.target.value)}\n                    placeholder=\"jose.cataldo@empresa.com\"\n                    className=\"w-full text-xs px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500 transition-all\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 block mb-1\">\n                    Departamento u Organizaci\303\263n\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={profileDept}\n                    onChange={(e) => setProfileDept(e.target.value)}\n                    placeholder=\"ej. Consejo Directivo, Operaciones\"\n                    className=\"w-full text-xs px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500 transition-all\"\n                  />\n                </div>\n              </div>\n\n              {/* Avatar Selector */}\n              <div>\n                <label className=\"text-xs font-semibold text-slate-700 block mb-1.5\">\n                  Seleccionar Foto de Perfil / Avatar\n                </label>\n                <div className=\"flex items-center gap-2 mb-2 overflow-x-auto pb-1\">\n                  {AVATAR_PRESETS.map((preset, idx) => (\n                    <button\n                      key={idx}\n                      type=\"button\"\n                      onClick={() => {\n                        setProfileAvatar(preset);\n                        setCustomAvatarInput(\'\');\n                      }}\n                      className={`relative rounded-full p-0.5 transition-all cursor-pointer shrink-0 ${\n                        profileAvatar === preset && !customAvatarInput\n                          ? \'ring-2 ring-indigo-600 scale-105\'\n                          : \'opacity-70 hover:opacity-100\'\n                      }`}\n                    >\n                      <img\n                        src={preset}\n                        alt=\"Avatar preset\"\n                        className=\"w-10 h-10 rounded-full object-cover border border-slate-200\"\n                      />\n                    </button>\n                  ))}\n                </div>\n                <input\n                  type=\"text\"\n                  value={customAvatarInput}\n                  onChange={(e) => setCustomAvatarInput(e.target.value)}\n                  placeholder=\"O ingresa un enlace (URL) de foto personalizada...\"\n                  className=\"w-full text-[11px] px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white outline-none focus:ring-1 focus:ring-indigo-500\"\n                />\n              </div>\n\n              <div className=\"flex justify-end gap-2 pt-2 border-t border-slate-100\">\n                <button\n                  type=\"button\"\n                  onClick={() => setIsEditingProfile(false)}\n                  className=\"px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 cursor-pointer\"\n                >\n                  Cancelar\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-md shadow-indigo-100 transition-all cursor-pointer flex items-center gap-1.5\"\n                >\n                  <span className=\"material-symbols-outlined text-[16px]\">save</span>\n                  <span>Guardar Perfil</span>\n                </button>\n              </div>\n            </form>\n          )}\n        </div>\n\n        {/* Directory & Attendees Management */}\n        <div className=\"bento-card bg-white rounded-2xl p-6 shadow-sm border border-slate-100 space-y-4\">\n          <div className=\"flex justify-between items-center border-b border-slate-100 pb-3\">\n            <div>\n              <h3 className=\"text-base font-bold text-slate-900 flex items-center gap-2\">\n                <span className=\"material-symbols-outlined text-indigo-600\">contacts</span>\n                Directorio Corporativo de Asistentes ({allAttendees.length})\n              </h3>\n              <p className=\"text-xs text-slate-500 mt-0.5\">\n                Contactos precargados y personalizados disponibles para incluir en cualquier acta.\n              </p>\n            </div>\n\n            <button\n              onClick={() => setIsAddingContact(!isAddingContact)}\n              className=\"text-xs bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-3.5 py-1.5 rounded-xl shadow-sm shadow-indigo-100 transition-all flex items-center gap-1.5 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[16px]\">person_add</span>\n              <span>+ A\303\261adir Asistente</span>\n            </button>\n          </div>\n\n          {/* Quick Add Contact Form */}\n          {isAddingContact && (\n            <form\n              onSubmit={handleCreateContactSubmit}\n              className=\"p-4 rounded-xl bg-indigo-50/50 border border-indigo-100 space-y-3\"\n            >\n              <div className=\"flex justify-between items-center\">\n                <h4 className=\"text-xs font-bold text-indigo-900\">\n                  Registrar Nuevo Asistente en el Directorio\n                </h4>\n                <button\n                  type=\"button\"\n                  onClick={() => setIsAddingContact(false)}\n                  className=\"text-slate-400 hover:text-slate-600 text-xs\"\n                >\n                  Cerrar\n                </button>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                <div>\n                  <label className=\"text-[11px] font-semibold text-slate-600 block mb-1\">\n                    Nombre Completo *\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={contactName}\n                    onChange={(e) => setContactName(e.target.value)}\n                    placeholder=\"ej. Dra. Claudia Rivas\"\n                    className=\"w-full text-xs px-3 py-2 rounded-lg border border-slate-200 bg-white outline-none focus:ring-1 focus:ring-indigo-500\"\n                    autoFocus\n                    required\n                  />\n                </div>\n                <div>\n                  <label className=\"text-[11px] font-semibold text-slate-600 block mb-1\">\n                    Cargo / Rol\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={contactRole}\n                    onChange={(e) => setContactRole(e.target.value)}\n                    placeholder=\"ej. Auditora Externa\"\n                    className=\"w-full text-xs px-3 py-2 rounded-lg border border-slate-200 bg-white outline-none focus:ring-1 focus:ring-indigo-500\"\n                  />\n                </div>\n                <div>\n                  <label className=\"text-[11px] font-semibold text-slate-600 block mb-1\">\n                    Correo Electr\303\263nico\n                  </label>\n                  <input\n                    type=\"email\"\n                    value={contactEmail}\n                    onChange={(e) => setContactEmail(e.target.value)}\n                    placeholder=\"claudia.r@empresa.com\"\n                    className=\"w-full text-xs px-3 py-2 rounded-lg border border-slate-200 bg-white outline-none focus:ring-1 focus:ring-indigo-500\"\n                  />\n                </div>\n              </div>\n\n              {/* Avatar Selector for Contact */}\n              <div className=\"flex items-center justify-between pt-1\">\n                <div className=\"flex items-center gap-1.5 overflow-x-auto\">\n                  <span className=\"text-[11px] font-medium text-slate-500 mr-1\">Foto:</span>\n                  {AVATAR_PRESETS.map((preset, idx) => (\n                    <button\n                      key={idx}\n                      type=\"button\"\n                      onClick={() => setContactAvatar(preset)}\n                      className={`p-0.5 rounded-full cursor-pointer ${\n                        contactAvatar === preset ? \'ring-2 ring-indigo-600\' : \'opacity-70\'\n                      }`}\n                    >\n                      <img src={preset} alt=\"Avatar\" className=\"w-6 h-6 rounded-full object-cover\" />\n                    </button>\n                  ))}\n                </div>\n\n                <button\n                  type=\"submit\"\n                  className=\"bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-4 py-1.5 rounded-lg shadow-xs cursor-pointer\"\n                >\n                  Guardar en Directorio\n                </button>\n              </div>\n            </form>\n          )}\n\n          {/* Directory Contact Grid */}\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-80 overflow-y-auto custom-scrollbar pr-1\">\n            {allAttendees.map((att) => {\n              const isCustom = att.id.startsWith(\'att-custom-\');\n              return (\n                <div\n                  key={att.id}\n                  className=\"flex items-center justify-between p-3 rounded-xl border border-slate-100 hover:border-slate-200 bg-white hover:bg-slate-50/70 transition-all\"\n                >\n                  <div className=\"flex items-center gap-3 min-w-0\">\n                    <img\n                      src={att.avatarUrl}\n                      alt={att.name}\n                      className=\"w-9 h-9 rounded-full object-cover border border-slate-200 shrink-0\"\n                    />\n                    <div className=\"min-w-0\">\n                      <div className=\"flex items-center gap-1.5\">\n                        <h4 className=\"text-xs font-bold text-slate-900 truncate\">{att.name}</h4>\n                        <span\n                          className={`text-[9px] px-1.5 py-0.5 rounded font-medium ${\n                            isCustom\n                              ? \'bg-amber-50 text-amber-700 border border-amber-200/60\'\n                              : \'bg-slate-100 text-slate-600\'\n                          }`}\n                        >\n                          {isCustom ? \'Personalizado\' : \'Equipo Base\'}\n                        </span>\n                      </div>\n                      <p className=\"text-[11px] text-slate-500 truncate\">\n                        {att.role || \'Asistente\'} \342\200\242 {att.email}\n                      </p>\n                    </div>\n                  </div>\n\n                  {isCustom && (\n                    <button\n                      onClick={() => {\n                        onDeleteContact(att.id);\n                        onShowToast(`Asistente \"${att.name}\" eliminado del directorio.`);\n                      }}\n                      className=\"text-slate-300 hover:text-rose-600 p-1 rounded transition-colors cursor-pointer shrink-0\"\n                      title=\"Eliminar del directorio\"\n                    >\n                      <span className=\"material-symbols-outlined text-[18px]\">delete</span>\n                    </button>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Connected Channels */}\n        <div className=\"bento-card bg-white rounded-2xl p-6 shadow-sm border border-slate-100 space-y-4\">\n          <h3 className=\"text-base font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-indigo-600\">cloud_sync</span>\n            Canales de Sincronizaci\303\263n y Exportaci\303\263n\n          </h3>\n\n          <div className=\"divide-y divide-slate-100\">\n            <div className=\"py-3.5 flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600\">\n                  <span className=\"material-symbols-outlined text-[22px]\">add_to_drive</span>\n                </div>\n                <div>\n                  <h4 className=\"text-sm font-bold text-slate-900\">Sincronizaci\303\263n con Google Drive</h4>\n                  <p className=\"text-xs text-slate-500\">\n                    Genera autom\303\241ticamente versiones en PDF y Google Docs en las carpetas seleccionadas.\n                  </p>\n                </div>\n              </div>\n              <input\n                type=\"checkbox\"\n                checked={driveEnabled}\n                onChange={(e) => setDriveEnabled(e.target.checked)}\n                className=\"w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n              />\n            </div>\n\n            <div className=\"py-3.5 flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600\">\n                  <span className=\"material-symbols-outlined text-[22px]\">chat</span>\n                </div>\n                <div>\n                  <h4 className=\"text-sm font-bold text-slate-900\">Distribuci\303\263n por WhatsApp Business</h4>\n                  <p className=\"text-xs text-slate-500\">\n                    Env\303\255o instant\303\241neo de res\303\272menes ejecutivos con vi\303\261etas estructuradas a grupos de chat.\n                  </p>\n                </div>\n              </div>\n              <input\n                type=\"checkbox\"\n                checked={whatsappEnabled}\n                onChange={(e) => setWhatsappEnabled(e.target.checked)}\n                className=\"w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n              />\n            </div>\n\n            <div className=\"py-3.5 flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600\">\n                  <span className=\"material-symbols-outlined text-[22px]\">mail</span>\n                </div>\n                <div>\n                  <h4 className=\"text-sm font-bold text-slate-900\">Pasarela de Correo Corporativo</h4>\n                  <p className=\"text-xs text-slate-500\">\n                    Env\303\255o formal de actas con archivos PDF adjuntos desde el correo ejecutivo.\n                  </p>\n                </div>\n              </div>\n              <input\n                type=\"checkbox\"\n                checked={emailAutoSend}\n                onChange={(e) => setEmailAutoSend(e.target.checked)}\n                className=\"w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Audio & Speech Dictation Settings */}\n        <div className=\"bento-card bg-white rounded-2xl p-6 shadow-sm border border-slate-100 space-y-4\">\n          <h3 className=\"text-base font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-indigo-600\">mic</span>\n            Dictado por Voz y Transcripci\303\263n\n          </h3>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-xs font-semibold text-slate-500\">Idioma Principal de Dictado</label>\n              <select\n                value={language}\n                onChange={(e) => setLanguage(e.target.value)}\n                className=\"text-xs p-2.5 rounded-xl border border-slate-200 bg-slate-50 outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500\"\n              >\n                <option value=\"es-ES\">Espa\303\261ol (Espa\303\261a / LATAM)</option>\n                <option value=\"en-US\">English (United States / Corporate)</option>\n                <option value=\"fr-FR\">Fran\303\247ais</option>\n                <option value=\"de-DE\">Deutsch</option>\n              </select>\n            </div>\n\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-xs font-semibold text-slate-500\">Autoguardado en Tiempo Real</label>\n              <div className=\"flex items-center gap-2 pt-2\">\n                <input\n                  type=\"checkbox\"\n                  checked={autoSync}\n                  onChange={(e) => setAutoSync(e.target.checked)}\n                  className=\"w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n                />\n                <span className=\"text-xs text-slate-700 font-medium\">\n                  Guardar borradores autom\303\241ticamente cada 30 segundos\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Save button */}\n        <div className=\"flex justify-end gap-3 pt-2\">\n          <button\n            onClick={handleSaveGeneral}\n            className=\"px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-md shadow-indigo-100 transition-all cursor-pointer\"\n          >\n            Guardar Todos los Ajustes\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
