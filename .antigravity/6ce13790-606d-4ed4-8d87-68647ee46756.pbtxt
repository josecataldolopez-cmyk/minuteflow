    instruction: "Implement folder selection/creation and minute deletion in MinuteEditorView"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"flex-1 flex flex-col h-screen overflow-hidden relative bg-slate-50\">\n      {/* Header Area for Editor */}\n      <header className=\"px-4 md:px-8 py-4 border-b border-slate-100 bg-white/90 backdrop-blur-md flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 shrink-0 z-20\">\n        <div>\n          <div className=\"flex items-center gap-1.5 text-slate-500 text-xs font-medium mb-1\">\n            <button\n              onClick={onBack}\n              className=\"hover:text-indigo-600 flex items-center gap-1 cursor-pointer transition-colors\"\n            >\n              <span className=\"material-symbols-outlined text-[16px]\">arrow_back</span>\n              <span>Proyectos</span>\n            </button>\n            <span className=\"material-symbols-outlined text-[14px] text-slate-300\">chevron_right</span>\n            <span className=\"text-slate-900 font-semibold truncate max-w-[200px]\">\n              {directory}\n            </span>\n          </div>\n          <h1 className=\"text-xl md:text-2xl font-bold text-slate-900 tracking-tight\">\n            {minute ? minute.title : \'Nueva Entrada de Acta\'}\n          </h1>\n        </div>\n\n        <div className=\"flex items-center gap-3 w-full sm:w-auto justify-end\">\n          {minute && (\n            <button\n              onClick={() => onOpenExport(minute)}\n              className=\"px-3.5 py-2 rounded-xl border border-slate-200 hover:border-indigo-600 text-indigo-600 text-xs font-semibold hover:bg-indigo-50/50 transition-all flex items-center gap-1.5 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[16px]\">ios_share</span>\n              <span>Exportar</span>\n            </button>\n          )}\n\n          <button\n            onClick={() => handleSave(true)}\n            id=\"btn-save-draft\"\n            className=\"px-4 py-2 rounded-xl border border-slate-200 text-slate-700 font-semibold text-xs hover:bg-slate-50 transition-colors cursor-pointer\"\n          >\n            Guardar Borrador\n          </button>\n          <button\n            onClick={() => handleSave(false)}\n            id=\"btn-publish-minute\"\n            className=\"px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs transition-colors shadow-md shadow-indigo-100 cursor-pointer flex items-center gap-1.5\"\n          >\n            <span className=\"material-symbols-outlined text-[16px]\">check</span>\n            <span>Publicar Acta</span>\n          </button>\n        </div>\n      </header>\n\n      {/* Main Editor Body */}\n      <div className=\"flex-1 overflow-y-auto p-4 md:p-8 pb-32 custom-scrollbar\">\n        <div className=\"max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-6\">\n          {/* Left Column: Details & Scheduling (4 cols) */}\n          <div className=\"md:col-span-4 flex flex-col gap-6\">\n            {/* Meta Info Card */}\n            <div className=\"bg-white rounded-2xl p-5 flex flex-col gap-4 shadow-sm border border-slate-100\">\n              <h2 className=\"text-sm font-bold text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-2.5\">\n                <span className=\"material-symbols-outlined text-indigo-600 text-[20px]\">info</span>\n                Detalles de la Reuni\303\263n\n              </h2>\n\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-xs font-semibold text-slate-600\">T\303\255tulo</label>\n                <input\n                  type=\"text\"\n                  value={title}\n                  onChange={(e) => setTitle(e.target.value)}\n                  placeholder=\"ej. Revisi\303\263n Estrat\303\251gica Q3\"\n                  className=\"w-full rounded-xl border border-slate-200 bg-slate-50 p-2.5 text-sm text-slate-900 focus:bg-white focus:ring-2 focus:ring-indigo-100 focus:border-indigo-600 outline-none transition-all\"\n                />\n              </div>\n\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-xs font-semibold text-slate-600\">Carpeta de Destino</label>\n                <select\n                  value={directory}\n                  onChange={(e) => setDirectory(e.target.value)}\n                  className=\"w-full rounded-xl border border-slate-200 bg-slate-50 p-2.5 text-xs text-slate-900 focus:bg-white focus:ring-2 focus:ring-indigo-100 focus:border-indigo-600 outline-none font-medium transition-all\"\n                >\n                  <option value=\"Reuniones de Directorio Q3\">Reuniones de Directorio Q3</option>\n                  <option value=\"Fusiones Cliente Alfa\">Fusiones Cliente Alfa</option>\n                  <option value=\"Recursos Humanos\">Recursos Humanos</option>\n                  <option value=\"Revisiones Anuales 2026\">Revisiones Anuales 2026</option>\n                </select>\n              </div>"
        replacement_content: "  const handleCreateFolderInline = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newFolderName.trim()) return;\n    const name = newFolderName.trim();\n    if (onCreateDirectory) {\n      onCreateDirectory(name);\n    }\n    setDirectory(name);\n    setNewFolderName(\'\');\n    setIsCreatingFolder(false);\n  };\n\n  const handleDeleteMinuteConfirm = () => {\n    if (minute && onDeleteMinute) {\n      onDeleteMinute(minute.id);\n      setShowDeleteConfirm(false);\n      onBack();\n    }\n  };\n\n  return (\n    <div className=\"flex-1 flex flex-col h-screen overflow-hidden relative bg-slate-50\">\n      {/* Header Area for Editor */}\n      <header className=\"px-4 md:px-8 py-4 border-b border-slate-100 bg-white/90 backdrop-blur-md flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 shrink-0 z-20\">\n        <div>\n          <div className=\"flex items-center gap-1.5 text-slate-500 text-xs font-medium mb-1\">\n            <button\n              onClick={onBack}\n              className=\"hover:text-indigo-600 flex items-center gap-1 cursor-pointer transition-colors\"\n            >\n              <span className=\"material-symbols-outlined text-[16px]\">arrow_back</span>\n              <span>Biblioteca</span>\n            </button>\n            <span className=\"material-symbols-outlined text-[14px] text-slate-300\">chevron_right</span>\n            <span className=\"text-slate-900 font-semibold truncate max-w-[200px]\">\n              {directory}\n            </span>\n          </div>\n          <h1 className=\"text-xl md:text-2xl font-bold text-slate-900 tracking-tight\">\n            {minute ? minute.title : \'Nueva Entrada de Acta\'}\n          </h1>\n        </div>\n\n        <div className=\"flex items-center gap-2.5 w-full sm:w-auto justify-end\">\n          {minute && (\n            <>\n              <button\n                onClick={() => setShowDeleteConfirm(true)}\n                className=\"px-3 py-2 rounded-xl border border-rose-200 text-rose-600 hover:bg-rose-50 text-xs font-semibold transition-all flex items-center gap-1.5 cursor-pointer\"\n                title=\"Eliminar esta acta\"\n              >\n                <span className=\"material-symbols-outlined text-[16px]\">delete</span>\n                <span className=\"hidden sm:inline\">Eliminar</span>\n              </button>\n              <button\n                onClick={() => onOpenExport(minute)}\n                className=\"px-3.5 py-2 rounded-xl border border-slate-200 hover:border-indigo-600 text-indigo-600 text-xs font-semibold hover:bg-indigo-50/50 transition-all flex items-center gap-1.5 cursor-pointer\"\n              >\n                <span className=\"material-symbols-outlined text-[16px]\">ios_share</span>\n                <span>Exportar</span>\n              </button>\n            </>\n          )}\n\n          <button\n            onClick={() => handleSave(true)}\n            id=\"btn-save-draft\"\n            className=\"px-4 py-2 rounded-xl border border-slate-200 text-slate-700 font-semibold text-xs hover:bg-slate-50 transition-colors cursor-pointer\"\n          >\n            Guardar Borrador\n          </button>\n          <button\n            onClick={() => handleSave(false)}\n            id=\"btn-publish-minute\"\n            className=\"px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs transition-colors shadow-md shadow-indigo-100 cursor-pointer flex items-center gap-1.5\"\n          >\n            <span className=\"material-symbols-outlined text-[16px]\">check</span>\n            <span>Publicar Acta</span>\n          </button>\n        </div>\n      </header>\n\n      {/* Delete Confirmation Modal */}\n      {showDeleteConfirm && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-in fade-in\">\n          <div className=\"bg-white rounded-2xl p-6 max-w-sm w-full shadow-2xl border border-slate-100 space-y-4\">\n            <div className=\"w-12 h-12 rounded-full bg-rose-50 text-rose-600 flex items-center justify-center mx-auto\">\n              <span className=\"material-symbols-outlined text-[28px]\">delete_forever</span>\n            </div>\n            <div className=\"text-center\">\n              <h3 className=\"text-base font-bold text-slate-900\">\302\277Eliminar esta acta de reuni\303\263n?</h3>\n              <p className=\"text-xs text-slate-500 mt-1.5\">\n                Esta acci\303\263n eliminar\303\241 permanentemente \"<span className=\"font-semibold text-slate-700\">{minute?.title}</span>\". No se podr\303\241 recuperar.\n              </p>\n            </div>\n            <div className=\"flex gap-2.5 pt-2\">\n              <button\n                type=\"button\"\n                onClick={() => setShowDeleteConfirm(false)}\n                className=\"flex-1 py-2.5 px-4 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors cursor-pointer\"\n              >\n                Cancelar\n              </button>\n              <button\n                type=\"button\"\n                onClick={handleDeleteMinuteConfirm}\n                className=\"flex-1 py-2.5 px-4 text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 rounded-xl transition-colors shadow-sm shadow-rose-200 cursor-pointer\"\n              >\n                S\303\255, Eliminar\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Main Editor Body */}\n      <div className=\"flex-1 overflow-y-auto p-4 md:p-8 pb-32 custom-scrollbar\">\n        <div className=\"max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-6\">\n          {/* Left Column: Details & Scheduling (4 cols) */}\n          <div className=\"md:col-span-4 flex flex-col gap-6\">\n            {/* Meta Info Card */}\n            <div className=\"bg-white rounded-2xl p-5 flex flex-col gap-4 shadow-sm border border-slate-100\">\n              <h2 className=\"text-sm font-bold text-slate-900 flex items-center gap-2 border-b border-slate-100 pb-2.5\">\n                <span className=\"material-symbols-outlined text-indigo-600 text-[20px]\">info</span>\n                Detalles de la Reuni\303\263n\n              </h2>\n\n              <div className=\"flex flex-col gap-1.5\">\n                <label className=\"text-xs font-semibold text-slate-600\">T\303\255tulo</label>\n                <input\n                  type=\"text\"\n                  value={title}\n                  onChange={(e) => setTitle(e.target.value)}\n                  placeholder=\"ej. Revisi\303\263n Estrat\303\251gica Q3\"\n                  className=\"w-full rounded-xl border border-slate-200 bg-slate-50 p-2.5 text-sm text-slate-900 focus:bg-white focus:ring-2 focus:ring-indigo-100 focus:border-indigo-600 outline-none transition-all\"\n                />\n              </div>\n\n              {/* Destination Folder Selector with Inline Create */}\n              <div className=\"flex flex-col gap-1.5\">\n                <div className=\"flex items-center justify-between\">\n                  <label className=\"text-xs font-semibold text-slate-600\">Carpeta de Destino</label>\n                  <button\n                    type=\"button\"\n                    onClick={() => setIsCreatingFolder(!isCreatingFolder)}\n                    className=\"text-[11px] font-semibold text-indigo-600 hover:text-indigo-700 flex items-center gap-0.5 cursor-pointer\"\n                  >\n                    <span className=\"material-symbols-outlined text-[14px]\">\n                      {isCreatingFolder ? \'close\' : \'create_new_folder\'}\n                    </span>\n                    <span>{isCreatingFolder ? \'Cancelar\' : \'+ Nueva Carpeta\'}</span>\n                  </button>\n                </div>\n\n                {isCreatingFolder ? (\n                  <form onSubmit={handleCreateFolderInline} className=\"flex items-center gap-1.5 mt-0.5\">\n                    <input\n                      type=\"text\"\n                      value={newFolderName}\n                      onChange={(e) => setNewFolderName(e.target.value)}\n                      placeholder=\"Nombre de la nueva carpeta...\"\n                      autoFocus\n                      className=\"flex-1 rounded-xl border border-indigo-300 bg-indigo-50/40 px-3 py-2 text-xs text-slate-900 focus:bg-white focus:ring-2 focus:ring-indigo-100 focus:border-indigo-600 outline-none\"\n                    />\n                    <button\n                      type=\"submit\"\n                      className=\"px-3 py-2 bg-indigo-600 text-white rounded-xl text-xs font-semibold hover:bg-indigo-700 shrink-0 cursor-pointer shadow-xs\"\n                    >\n                      Guardar\n                    </button>\n                  </form>\n                ) : (\n                  <select\n                    value={directory}\n                    onChange={(e) => {\n                      if (e.target.value === \'__create_new__\') {\n                        setIsCreatingFolder(true);\n                      } else {\n                        setDirectory(e.target.value);\n                      }\n                    }}\n                    className=\"w-full rounded-xl border border-slate-200 bg-slate-50 p-2.5 text-xs text-slate-900 focus:bg-white focus:ring-2 focus:ring-indigo-100 focus:border-indigo-600 outline-none font-medium transition-all cursor-pointer\"\n                  >\n                    {directories.map((dir) => (\n                      <option key={dir.id} value={dir.name}>\n                        \360\237\223\201 {dir.name}\n                      </option>\n                    ))}\n                    {/* If current directory is not in list, add it */}\n                    {directory && !directories.some((d) => d.name === directory) && (\n                      <option value={directory}>\360\237\223\201 {directory}</option>\n                    )}\n                    <option value=\"__create_new__\">+ Agregar nueva carpeta...</option>\n                  </select>\n                )}\n              </div>"
      }
      num_matches: 1
    }
  }
}
