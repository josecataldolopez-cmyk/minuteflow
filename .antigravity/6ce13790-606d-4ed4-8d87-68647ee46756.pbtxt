className=\"bg-white text-slate-900 p-3.5 rounded-2xl rounded-tr-none shadow-sm max-w-[95%] ml-auto relative z-10 text-xs leading-relaxed border border-slate-200\">\n                    <p className=\"font-bold text-[13px] text-slate-900\">\n                      \360\237\223\213 *MinuteFlow Summary: {minute.title}*\n                    </p>\n                    <p className=\"text-[11px] text-slate-500 mt-0.5\">{minute.formattedDate}</p>\n\n                    <p className=\"mt-2.5 font-bold text-[12px] text-slate-900\">\360\237\216\257 Key Decisions:</p>\n                    <ul className=\"list-none pl-0 mt-1 space-y-1 text-[12px]\">\n                      {minute.keyDecisions.length > 0 ? (\n                        minute.keyDecisions.map((dec, i) => (\n                          <li key={i}>\342\200\242 {dec}</li>\n                        ))\n                      ) : (\n                        <li>\342\200\242 Approved revised Q4 marketing budget (Shift to digital APAC).</li>\n                      )}\n                    </ul>\n\n                    <p className=\"mt-2.5 font-bold text-[12px] text-slate-900\">\342\232\241 Action Items:</p>\n                    <ul className=\"list-none pl-0 mt-1 space-y-1 text-[12px]\">\n                      {minute.actionItems.length > 0 ? (\n                        minute.actionItems.map((act) => (\n                          <li key={act.id}>\n                            \342\200\242 @{act.assignedTo ? act.assignedTo.name : \'Team\'} - {act.text}\n                          </li>\n                        ))\n                      ) : (\n                        <>\n                          <li>\342\200\242 @Finance - Prepare financial models (High)</li>\n                          <li>\342\200\242 @Legal - Draft NDA for AlphaCorp</li>\n                        </>\n                      )}\n                    </ul>\n\n                    <p className=\"mt-3 text-[11px] text-indigo-600 underline cursor-pointer\">\n            