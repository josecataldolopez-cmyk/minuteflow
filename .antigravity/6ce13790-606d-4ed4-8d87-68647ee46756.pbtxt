    replacement_infos {
      original_chunk {
        target_content: "    showToast(isDraft ? \'Draft saved successfully\' : \'Minute published and synced\');\n    setActiveMinute(savedMinute);\n    setCurrentView(\'library\');\n  };\n\n  const handleDeleteMinute = (id: string) => {\n    setMinutes((prev) => prev.filter((m) => m.id !== id));\n    showToast(\'Meeting minute deleted\');\n  };\n\n  const handleDuplicateMinute = (min: MeetingMinute) => {\n    const duplicated: MeetingMinute = {\n      ...min,\n      id: `min-${Date.now()}`,\n      title: `${min.title} (Copy)`,\n      status: \'Draft\',\n      formattedDate: \'Today\'\n    };\n    setMinutes((prev) => [duplicated, ...prev]);\n    showToast(\'Minute duplicated to Drafts\');\n  };\n\n  const handleToggleActionItem = (id: string) => {\n    setActionItems((prev) =>\n      prev.map((item) => (item.id === id ? { ...item, completed: !item.completed } : item))\n    );\n  };\n\n  const handleAddActionItem = (text: string) => {\n    const newItem: ActionItem = {\n      id: `act-${Date.now()}`,\n      text,\n      completed: false,\n      dueLabel: \'Due Today\',\n      dueDate: new Date().toISOString().split(\'T\')[0]\n    };\n    setActionItems((prev) => [newItem, ...prev]);\n    showToast(\'Action item added\');\n  };\n\n  const handleTriggerSync = () => {\n    setIsSyncing(true);\n    setTimeout(() => {\n      setIsSyncing(false);\n      showToast(\'Cloud Sync completed: 7 folders up to date\');\n    }, 1200);\n  };\n\n  const handleExportSuccess = (channel: string) => {\n    const channelNames: Record<string, string> = {\n      drive: \'Google Drive (PDF & GDoc generated)\',\n      whatsapp: \'WhatsApp (Executive Summary distributed)\',\n      email: \'Corporate Email (PDF attachment sent)\'\n    };\n    showToast(`Successfully exported to ${channelNames[channel] || channel}`);\n  };"
        replacement_content: "    showToast(isDraft ? \'Borrador guardado con \303\251xito\' : \'Acta publicada y sincronizada\');\n    setActiveMinute(savedMinute);\n    setCurrentView(\'library\');\n  };\n\n  const handleDeleteMinute = (id: string) => {\n    setMinutes((prev) => prev.filter((m) => m.id !== id));\n    showToast(\'Acta de reuni\303\263n eliminada\');\n  };\n\n  const handleDuplicateMinute = (min: MeetingMinute) => {\n    const duplicated: MeetingMinute = {\n      ...min,\n      id: `min-${Date.now()}`,\n      title: `${min.title} (Copia)`,\n      status: \'Borrador\',\n      formattedDate: \'Hoy\'\n    };\n    setMinutes((prev) => [duplicated, ...prev]);\n    showToast(\'Acta duplicada en Borradores\');\n  };\n\n  const handleToggleActionItem = (id: string) => {\n    setActionItems((prev) =>\n      prev.map((item) => (item.id === id ? { ...item, completed: !item.completed } : item))\n    );\n  };\n\n  const handleAddActionItem = (text: string) => {\n    const newItem: ActionItem = {\n      id: `act-${Date.now()}`,\n      text,\n      completed: false,\n      dueLabel: \'Vence Hoy\',\n      dueDate: new Date().toISOString().split(\'T\')[0]\n    };\n    setActionItems((prev) => [newItem, ...prev]);\n    showToast(\'Tarea agregada\');\n  };\n\n  const handleTriggerSync = () => {\n    setIsSyncing(true);\n    setTimeout(() => {\n      setIsSyncing(false);\n      showToast(\'Sincronizaci\303\263n en la nube completada: 7 carpetas al d\303\255a\');\n    }, 1200);\n  };\n\n  const handleExportSuccess = (channel: string) => {\n    const channelNames: Record<string, string> = {\n      drive: \'Google Drive (PDF y Google Doc generados)\',\n      whatsapp: \'WhatsApp (Resumen Ejecutivo distribuido)\',\n      email: \'Correo Corporativo (Archivo PDF adjunto enviado)\'\n    };\n    showToast(`Exportado con \303\251xito a ${channelNames[channel] || channel}`);\n  };"
      }
      num_matches: 1
    }
  }
}
