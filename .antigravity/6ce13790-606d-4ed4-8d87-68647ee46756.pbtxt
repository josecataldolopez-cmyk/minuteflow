    replacement_infos {
      original_chunk {
        target_content: "  const handleSave = () => {\n    onShowToast(\'Settings successfully updated and synchronized.\');\n  };\n\n  return (\n    <div className=\"flex-1 overflow-y-auto p-4 md:p-8 bg-slate-50 custom-scrollbar\">\n      <div className=\"max-w-4xl mx-auto pb-24 space-y-6\">\n        <div>\n          <h1 className=\"text-2xl md:text-3xl font-bold text-slate-900 tracking-tight\">\n            Settings &amp; Integrations\n          </h1>\n          <p className=\"text-sm text-slate-500 mt-1\">\n            Configure executive sync channels, speech dictation, and account parameters.\n          </p>\n        </div>\n\n        {/* Profile Card */}\n        <div className=\"bento-card bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n          <h3 className=\"text-base font-bold text-slate-900 border-b border-slate-100 pb-3 mb-4 flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-indigo-600\">person</span>\n            Executive Profile\n          </h3>\n          <div className=\"flex flex-col sm:flex-row items-start sm:items-center gap-5\">\n            <img\n              src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBV2OuN03O8TiLGOHeUBlq6SXBGf8lu4IgMQ-YEwmkRLA3qmC5MXmTjD0hdDmGNIRi5FD7n4Jr4C5hxmvn08IMoW0D5BgnfPJ8yGD3aLGOBngDzkgC9FkjKycbeGTIzQGFyxQtY6_7j_X_OzNasGTKLIi0JyIEGvmudlvb_NOD6DAfqYwpN-un5H22BsxXmiJpZvXo-kS4kUri558jTy3GzN6mE-ugOSrdOsAVDbFg03GQqz06YZ1r2_g\"\n              alt=\"Sarah Jenkins\"\n              className=\"w-16 h-16 rounded-full object-cover border-2 border-indigo-600\"\n            />\n            <div className=\"space-y-1\">\n              <h4 className=\"font-bold text-base text-slate-900\">Sarah Jenkins</h4>\n              <p className=\"text-xs text-slate-500\">VP Operations &amp; Executive Suite Member</p>\n              <p className=\"text-xs text-indigo-600 font-medium\">sarah.j@minuteflow.com</p>\n            </div>\n            <div className=\"sm:ml-auto\">\n              <span className=\"px-3 py-1 bg-emerald-50 text-emerald-700 text-xs font-bold rounded-full border border-emerald-200\">\n                Enterprise Active\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Connected Channels */}\n        <div className=\"bento-card bg-white rounded-2xl p-6 shadow-sm border border-slate-100 space-y-4\">\n          <h3 className=\"text-base font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-indigo-600\">cloud_sync</span>\n            Sync &amp; Export Channels\n          </h3>\n\n          <div className=\"divide-y divide-slate-100\">\n            <div className=\"py-3.5 flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600\">\n                  <span className=\"material-symbols-outlined text-[22px]\">add_to_drive</span>\n                </div>\n                <div>\n                  <h4 className=\"text-sm font-bold text-slate-900\">Google Drive Sync</h4>\n                  <p className=\"text-xs text-slate-500\">\n                    Automatically generates PDF and GDoc versions into designated folders.\n                  </p>\n                </div>\n              </div>\n              <input\n                type=\"checkbox\"\n                checked={driveEnabled}\n                onChange={(e) => setDriveEnabled(e.target.checked)}\n                className=\"w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n              />\n            </div>\n\n            <div className=\"py-3.5 flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600\">\n                  <span className=\"material-symbols-outlined text-[22px]\">chat</span>\n                </div>\n                <div>\n                  <h4 className=\"text-sm font-bold text-slate-900\">WhatsApp Business Distribution</h4>\n                  <p className=\"text-xs text-slate-500\">\n                    Instant formatted bullet summaries to executive chat channels.\n                  </p>\n                </div>\n              </div>\n              <input\n                type=\"checkbox\"\n                checked={whatsappEnabled}\n                onChange={(e) => setWhatsappEnabled(e.target.checked)}\n                className=\"w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n              />\n            </div>\n\n            <div className=\"py-3.5 flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600\">\n                  <span className=\"material-symbols-outlined text-[22px]\">mail</span>\n                </div>\n                <div>\n                  <h4 className=\"text-sm font-bold text-slate-900\">Corporate Email Gateway</h4>\n                  <p className=\"text-xs text-slate-500\">\n                    Send formal minutes PDF attachments directly from executive email.\n                  </p>\n                </div>\n              </div>\n              <input\n                type=\"checkbox\"\n                checked={emailAutoSend}\n                onChange={(e) => setEmailAutoSend(e.target.checked)}\n                className=\"w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Audio & Speech Dictation Settings */}\n        <div className=\"bento-card bg-white rounded-2xl p-6 shadow-sm border border-slate-100 space-y-4\">\n          <h3 className=\"text-base font-bold text-slate-900 border-b border-slate-100 pb-3 flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-indigo-600\">mic</span>\n            Voice Dictation &amp; Transcription\n          </h3>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-xs font-semibold text-slate-500\">Dictation Primary Language</label>\n              <select\n                value={language}\n                onChange={(e) => setLanguage(e.target.value)}\n                className=\"text-xs p-2.5 rounded-xl border border-slate-200 bg-slate-50 outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500\"\n              >\n                <option value=\"en-US\">English (United States / Corporate)</option>\n                <option value=\"es-ES\">Espa\303\261ol (Espa\303\261a / LATAM)</option>\n                <option value=\"fr-FR\">Fran\303\247ais</option>\n                <option value=\"de-DE\">Deutsch</option>\n              </select>\n            </div>\n\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-xs font-semibold text-slate-500\">Real-time Auto-Sync</label>\n              <div className=\"flex items-center gap-2 pt-2\">\n                <input\n                  type=\"checkbox\"\n                  checked={autoSync}\n                  onChange={(e) => setAutoSync(e.target.checked)}\n                  className=\"w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n                />\n                <span className=\"text-xs text-slate-700 font-medium\">\n                  Auto-save draft changes every 30 seconds\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Save button */}\n        <div className=\"flex justify-end gap-3 pt-2\">\n          <button\n            onClick={handleSave}\n            className=\"px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-md shadow-indigo-100 transition-all cursor-pointer\"\n          >\n            Save Changes\n          </button>\n        </div>"
        replacement_content: "  const handleSave = () => {\n    onShowToast(\'Configuraci\303\263n actualizada y sincronizada con \303\251xito.\');\n  };\n\n  return (\n    <div className=\"flex-1 overflow-y-auto p-4 md:p-8 bg-slate-50 custom-scrollbar\">\n      <div className=\"max-w-4xl mx-auto pb-24 space-y-6\">\n        <div>\n          <h1 className=\"text-2xl md:text-3xl font-bold text-slate-900 tracking-tight\">\n            Configuraci\303\263n e Integraciones\n          </h1>\n          <p className=\"text-sm text-slate-500 mt-1\">\n            Configura canales de sincronizaci\303\263n ejecutiva, dictado por voz y par\303\241metros de cuenta.\n          </p>\n        </div>\n\n        {/* Profile Card */}\n        <div className=\"bento-card bg-white rounded-2xl p-6 shadow-sm border border-slate-100\">\n          <h3 className=\"text-base font-bold text-slate-900 border-b border-slate-100 pb-3 mb-4 flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-indigo-600\">person</span>\n            Perfil Ejecutivo\n          </h3>\n          <div className=\"flex flex-col sm:flex-row items-start sm:items-center gap-5\">\n            <img\n              src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBV2OuN03O8TiLGOHeUBlq6SXBGf8lu4IgMQ-YEwmkRLA3qmC5MXmTjD0hdDmGNIRi5FD7n4Jr4C5hxmvn08IMoW0D5BgnfPJ8yGD3aLGOBngDzkgC9FkjKycbeGTIzQGFyxQtY6_7j_X_OzNasGTKLIi0JyIEGvmudlvb_NOD6DAfqYwpN-un5H22BsxXmiJpZvXo-kS4kUri558jTy3GzN6mE-ugOSrdOsAVDbFg03GQqz06YZ1r2_g\"\n              alt=\"Sarah Jenkins\"\n              className=\"w-16 h-16 rounded-full object-cover border-2 border-indigo-600\"\n            />\n            <div className=\"space-y-1\">\n              <h4 className=\"font-bold text-base text-slate-900\">Sarah Jenkins</h4>\n              <p className=\"text-xs text-slate-500\">Vicepresidenta de Operaciones y Miembro del Directorio</p>\n              <p className=\"text-xs text-indigo-600 font-medium\">sarah.j@minuteflow.com</p