00 pb-3 flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-indigo-600\">mic</span>\n            Voice Dictation &amp; Transcription\n          </h3>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-xs font-semibold text-slate-500\">Dictation Primary Language</label>\n              <select\n                value={language}\n                onChange={(e) => setLanguage(e.target.value)}\n                className=\"text-xs p-2.5 rounded-xl border border-slate-200 bg-slate-50 outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500\"\n              >\n                <option value=\"en-US\">English (United States / Corporate)</option>\n                <option value=\"es-ES\">Espa\303\261ol (Espa\303\261a / LATAM)</option>\n                <option value=\"fr-FR\">Fran\303\247ais</option>\n                <option value=\"de-DE\">Deutsch</option>\n              </select>\n            </div>\n\n            <div className=\"flex flex-col gap-1.5\">\n              <label className=\"text-xs font-semibold text-slate-500\">Real-time Auto-Sync</label>\n              <div className=\"flex items-center gap-2 pt-2\">\n                <input\n                  type=\"checkbox\"\n                  checked={autoSync}\n                  onChange={(e) => setAutoSync(e.target.checked)}\n                  className=\"w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer\"\n                />\n                <span className=\"text-xs text-slate-700 font-medium\">\n                  Auto-save draft changes every 30 seconds\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Save button */}\n        <div className=\"flex justify-end gap-3 pt-2\">\n          <button\n            onClick={handleSave}\n            className=\"px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl shadow-md shadow-indigo-100 transition-all cursor-pointer\"\n          >\n            Save Changes\n          </button>\n        </div>\n      </div>\n    </div>\n  );"
