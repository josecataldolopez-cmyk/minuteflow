  file_change {
    absolute_path_uri: "file:///src/components/ExportShareModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { MeetingMinute } from \'../types\';\n\ninterface ExportShareModalProps {\n  minute: MeetingMinute | null;\n  isOpen: boolean;\n  onClose: () => void;\n  onExportSuccess: (channel: string) => void;\n}\n\nexport const ExportShareModal: React.FC<ExportShareModalProps> = ({\n  minute,\n  isOpen,\n  onClose,\n  onExportSuccess\n}) => {\n  const [selectedChannel, setSelectedChannel] = useState<\'drive\' | \'whatsapp\' | \'email\'>(\'drive\');\n  const [previewTab, setPreviewTab] = useState<\'whatsapp\' | \'email\'>(\'whatsapp\');\n  const [folderPath, setFolderPath] = useState(\n    minute?.folderPath || \'Q3 Board Meetings / Oct\'\n  );\n  const [isEditingFolder, setIsEditingFolder] = useState(false);\n  const [isExporting, setIsExporting] = useState(false);\n  const [copied, setCopied] = useState(false);\n\n  if (!isOpen || !minute) return null;\n\n  const handleExport = () => {\n    setIsExporting(true);\n    setTimeout(() => {\n      setIsExporting(false);\n      onExportSuccess(selectedChannel);\n      onClose();\n    }, 900);\n  };\n\n  const whatsappMessage = `\360\237\223\213 *MinuteFlow Summary: ${minute.title}*\n${minute.formattedDate}\n\n\360\237\216\257 *Key Decisions:*\n${\n  minute.keyDecisions.length > 0\n    ? minute.keyDecisions.map((kd) => `\342\200\242 ${kd}`).join(\'\\n\')\n    : \'\342\200\242 Approved meeting agenda and next session milestones.\'\n}\n\n\342\232\241 *Action Items:*\n${\n  minute.actionItems.length > 0\n    ? minute.actionItems\n        .map(\n          (act) =>\n            `\342\200\242 @${act.assignedTo ? act.assignedTo.name : \'Team\'} - ${act.text} (${\n              act.priority || \'Pending\'\n            })`\n        )\n        .join(\'\\n\')\n    : \'\342\200\242 Review meeting deliverables with department leads\'\n}\n\n\360\237\224\227 View full document (Drive Link)`;\n\n  const handleCopy = () => {\n    navigator.clipboard?.writeText(whatsappMessage);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2000);\n  };\n\n  return (\n    <div\n      id=\"exportModalOverlay\"\n      className=\"fixed inset-0 bg-[#1a1c1c]/50 backdrop-blur-xs z-50 flex justify-center items-end md:items-center p-0 md:p-6 animate-in fade-in duration-200\"\n    >\n      {/* Modal Container */}\n      <div className=\"bg-white w-full md:w-[820px] max-h-[92vh] md:max-h-[880px] rounded-t-2xl md:rounded-2xl shadow-2xl flex flex-col overflow-hidden animate-in slide-in-from-bottom-6 duration-200 border border-[#c6c5d4]/40\">\n        {/* Modal Header */}\n        <div className=\"px-6 py-4 border-b border-[#e2e2e2] flex justify-between items-center bg-[#f9f9f9] sticky top-0 z-10\">\n          <div>\n            <h2 className=\"text-lg font-bold text-[#1a1c1c] flex items-center gap-2\">\n              <span className=\"material-symbols-outlined text-[#000666] text-[22px]\">\n                ios_share\n              </span>\n              Export &amp; Share\n            </h2>\n            <p className=\"text-xs text-[#454652] mt-0.5\">\n              Distribute &ldquo;{minute.title}&rdquo; notes to stakeholders.\n            </p>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-full hover:bg-[#eeeeee] text-[#767683] hover:text-[#1a1c1c] transition-colors cursor-pointer\"\n          >\n            <span className=\"material-symbols-outlined text-[20px]\">close</span>\n          </button>\n        </div>\n\n        {/* Modal Body: Bento Grid Layout */}\n        <div className=\"p-6 flex-1 overflow-y-auto custom-scrollbar bg-[#f3f3f3] grid grid-cols-1 md:grid-cols-12 gap-5\">\n          {/* Left Column: Primary Sharing Options (Span 5) */}\n          <div className=\"col-span-1 md:col-span-5 flex flex-col gap-3.5\">\n            {/* Google Drive Option */}\n            <div\n              onClick={() => setSelectedChannel(\'drive\')}\n              className={`bg-white rounded-xl border p-4 relative overflow-hidden cursor-pointer transition-all ${\n                selectedChannel === \'drive\'\n                  ? \'border-[#000666] ring-2 ring-[#000666]/20 shadow-xs\'\n                  : \'border-[#c6c5d4]/40 hover:border-[#767683]\'\n              }`}\n            >\n              <div className=\"absolute top-3.5 right-3.5\">\n                <span\n                  className={`material-symbols-outlined text-[20px] ${\n                    selectedChannel === \'drive\'\n                      ? \'text-[#000666] material-symbols-fill\'\n                      : \'text-[#c6c5d4]\'\n                  }`}\n                >\n                  {selectedChannel === \'drive\' ? \'check_circle\' : \'radio_button_unchecked\'}\n                </span>\n              </div>\n              <div className=\"flex items-center gap-3 mb-2\">\n                <div className=\"w-9 h-9 rounded-lg bg-[#e2e2e2] flex items-center justify-center text-[#1a1c1c]\">\n                  <span className=\"material-symbols-outlined text-[20px]\">add_to_drive</span>\n                </div>\n                <h3 className=\"text-sm font-bold text-[#1a1c1c]\">Google Drive</h3>\n              </div>\n\n              <div className=\"mt-2\">\n                <label className=\"text-[11px] font-semibold text-[#454652] block mb-1\">\n                  Target Folder\n                </label>\n                <div className=\"flex items-center justify-between bg-[#f3f3f3] px-2.5 py-1.5 rounded-lg border border-[#c6c5d4]/50\">\n                  {isEditingFolder ? (\n                    <input\n                      type=\"text\"\n                      value={folderPath}\n                      onChange={(e) => setFolderPath(e.target.value)}\n                      onBlur={() => setIsEditingFolder(false)}\n                      autoFocus\n                      className=\"text-xs bg-white border border-[#000666]/30 px-1.5 py-0.5 rounded w-full outline-none\"\n                    />\n                  ) : (\n                    <span className=\"text-xs text-[#1a1c1c] font-medium flex items-center gap-1.5 truncate\">\n                      <span className=\"material-symbols-outlined text-[16px] text-[#767683] material-symbols-fill\">\n                        folder\n                      </span>\n                      {folderPath}\n                    </span>\n                  )}\n                  <button\n                    onClick={(e) => {\n                      e.stopPropagation();\n                      setIsEditingFolder(!isEditingFolder);\n                    }}\n                    className=\"text-[#767683] hover:text-[#000666] ml-2\"\n                  >\n                    <span className=\"material-symbols-outlined text-[16px]\">edit</span>\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"mt-3 flex items-center gap-1.5 text-[#1b6d24]\">\n                <span className=\"material-symbols-outlined text-[16px] material-symbols-fill\">\n                  sync\n                </span>\n                <span className=\"text-[11px] font-semibold\">Ready to sync as PDF &amp; GDoc</span>\n              </div>\n            </div>\n\n            {/* WhatsApp Option */}\n            <div\n              onClick={() => {\n                setSelectedChannel(\'whatsapp\');\n                setPreviewTab(\'whatsapp\');\n              }}\n              className={`bg-white rounded-xl border p-4 relative cursor-pointer transition-all ${\n                selectedChannel === \'whatsapp\'\n                  ? \'border-[#25D366] ring-2 ring-[#25D366]/20 shadow-xs\'\n                  : \'border-[#c6c5d4]/40 hover:border-[#767683]\'\n              }`}\n            >\n              <div className=\"absolute top-3.5 right-3.5\">\n                <span\n                  className={`material-symbols-outlined text-[20px] ${\n                    selectedChannel === \'whatsapp\'\n                      ? \'text-[#25D366] material-symbols-fill\'\n                      : \'text-[#c6c5d4]\'\n                  }`}\n                >\n                  {selectedChannel === \'whatsapp\' ? \'check_circle\' : \'radio_button_unchecked\'}\n                </span>\n              </div>\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-9 h-9 rounded-lg bg-[#25D366]/10 flex items-center justify-center text-[#25D366]\">\n                  <span className=\"material-symbols-outlined text-[20px]\">chat</span>\n                </div>\n                <div>\n                  <h3 className=\"text-sm font-bold text-[#1a1c1c]\">WhatsApp</h3>\n                  <p className=\"text-[11px] text-[#454652]\">Executive Summary</p>\n                </div>\n              </div>\n            </div>\n\n            {/* Email Option */}\n            <div\n              onClick={() => {\n                setSelectedChannel(\'email\');\n                setPreviewTab(\'email\');\n              }}\n              className={`bg-white rounded-xl border p-4 relative cursor-pointer transition-all ${\n                selectedChannel === \'email\'\n                  ? \'border-[#002c6e] ring-2 ring-[#002c6e]/20 shadow-xs\'\n                  : \'border-[#c6c5d4]/40 hover:border-[#767683]\'\n              }`}\n            >\n              <div className=\"absolute top-3.5 right-3.5\">\n                <span\n                  className={`material-symbols-outlined text-[20px] ${\n                    selectedChannel === \'email\'\n                      ? \'text-[#002c6e] material-symbols-fill\'\n                      : \'text-[#c6c5d4]\'\n                  }`}\n                >\n                  {selectedChannel === \'email\' ? \'check_circle\' : \'radio_button_unchecked\'}\n                </span>\n              </div>\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-9 h-9 rounded-lg bg-[#d9e2ff] flex items-center justify-center text-[#002c6e]\">\n                  <span className=\"material-symbols-outlined text-[20px]\">mail</span>\n                </div>\n                <div>\n                  <h3 className=\"text-sm font-bold text-[#1a1c1c]\">Email</h3>\n                  <p className=\"text-[11px] text-[#454652]\">Formal Distribution</p>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Right Column: Live Preview Area (Span 7) */}\n          <div className=\"col-span-1 md:col-span-7 flex flex-col\">\n            <div className=\"bg-white rounded-2xl border border-[#c6c5d4]/40 flex flex-col h-full overflow-hidden shadow-xs\">\n              {/* Preview Header Tabs */}\n              <div className=\"flex border-b border-[#e2e2e2] bg-[#f9f9f9] px-4 pt-2\">\n                <button\n                  onClick={() => setPreviewTab(\'whatsapp\')}\n                  className={`px-4 py-2 text-xs font-semibold border-b-2 transition-all cursor-pointer ${\n                    previewTab === \'whatsapp\'\n                      ? \'text-[#000666] border-[#000666]\'\n                      : \'text-[#454652] border-transparent hover:text-[#1a1c1c]\'\n                  }`}\n                >\n                  WhatsApp Preview\n                </button>\n                <button\n                  onClick={() => setPreviewTab(\'email\')}\n                  className={`px-4 py-2 text-xs font-semibold border-b-2 transition-all cursor-pointer ${\n                    previewTab === \'email\'\n                      ? \'text-[#000666] border-[#000666]\'\n                      : \'text-[#454652] border-transparent hover:text-[#1a1c1c]\'\n                  }`}\n                >\n                  Email Template\n                </button>\n              </div>\n\n              {/* WhatsApp Preview Content */}\n              {previewTab === \'whatsapp\' ? (\n                <div className=\"p-4 bg-[#efeae2] flex-1 overflow-y-auto custom-scrollbar relative min-h-[280px]\">\n                  {/* WhatsApp Background Subtle Dot Pattern */}\n                  <div\n                    className=\"absolute inset-0 opacity-10 pointer-events-none\"\n                    style={{\n                      backgroundImage: \'radial-gradient(#767683 1px, transparent 1px)\',\n                      backgroundSize: \'20px 20px\'\n                    }}\n                  />\n\n                  <div className=\"bg-[#d9fdd3] text-[#111b21] p-3.5 rounded-xl rounded-tr-none shadow-xs max-w-[95%] ml-auto relative z-10 text-xs leading-relaxed\">\n                    <p className=\"font-bold text-[13px] text-[#111b21]\">\n                      \360\237\223\213 *MinuteFlow Summary: {minute.title}*\n                    </p>\n                    <p className=\"text-[11px] text-[#454652] mt-0.5\">{minute.formattedDate}</p>\n\n                    <p className=\"mt-2.5 font-bold text-[12px] text-[#111b21]\">\360\237\216\257 Key Decisions:</p>\n                    <ul className=\"list-none pl-0 mt-1 space-y-1 text-[12px]\">\n                      {minute.keyDecisions.length > 0 ? (\n                        minute.keyDecisions.map((dec, i) => (\n                          <li key={i}>\342\200\242 {dec}</li>\n                        ))\n                      ) : (\n                        <li>\342\200\242 Approved revised Q4 marketing budget (Shift to digital APAC).</li>\n                      )}\n                    </ul>\n\n                    <p className=\"mt-2.5 font-bold text-[12px] text-[#111b21]\">\342\232\241 Action Items:</p>\n                    <ul className=\"list-none pl-0 mt-1 space-y-1 text-[12px]\">\n                      {minute.actionItems.length > 0 ? (\n                        minute.actionItems.map((act) => (\n                          <li key={act.id}>\n                            \342\200\242 @{act.assignedTo ? act.assignedTo.name : \'Team\'} - {act.text}\n                          </li>\n                        ))\n                      ) : (\n                        <>\n                          <li>\342\200\242 @Finance - Prepare financial models (High)</li>\n                          <li>\342\200\242 @Legal - Draft NDA for AlphaCorp</li>\n                        </>\n                      )}\n                    </ul>\n\n                    <p className=\"mt-3 text-[11px] text-blue-600 underline cursor-pointer\">\n                      View full document (Drive Link)\n                    </p>\n                    <div className=\"text-right mt-1\">\n                      <span className=\"text-[10px] text-[#767683]\">10:42 AM</span>\n                    </div>\n                  </div>\n                </div>\n              ) : (\n                /* Email Template Content */\n                <div className=\"p-4 bg-white flex-1 overflow-y-auto custom-scrollbar flex flex-col justify-between min-h-[280px]\">\n                  <div>\n                    <div className=\"border-b border-[#e2e2e2] pb-2.5 mb-3 text-xs\">\n                      <p className=\"text-[#454652]\">\n                        To:{\' \'}\n                        <span className=\"text-[#1a1c1c] font-semibold\">\n                          executive-board@minuteflow.com\n                        </span>\n                      </p>\n                      <p className=\"text-[#454652] mt-1\">\n                        Subject:{\' \'}\n                        <span className=\"text-[#1a1c1c] font-bold\">\n                          Minutes: {minute.title} [{minute.formattedDate}]\n                        </span>\n                      </p>\n                    </div>\n\n                    <div className=\"text-xs text-[#1a1c1c] space-y-2 leading-relaxed\">\n                      <p>Dear Executive Leadership Team,</p>\n                      <p>\n                        Please find attached the formalized minutes, resolutions, and action items\n                        from today&apos;s <strong>{minute.title}</strong>.\n                      </p>\n                      <p className=\"text-[#454652]\">\n                        Key objectives covered: {minute.objectives || \'Q3 Alignment and review.\'}\n                      </p>\n                    </div>\n                  </div>\n\n                  {/* Attachment Pill */}\n                  <div className=\"mt-4 flex items-center gap-2 p-2.5 border border-[#c6c5d4]/50 rounded-xl bg-[#f9f9f9] hover:bg-[#f3f3f3] cursor-pointer transition-colors w-max\">\n                    <span className=\"material-symbols-outlined text-[#ba1a1a] text-[20px] material-symbols-fill\">\n                      picture_as_pdf\n                    </span>\n                    <span className=\"text-xs font-semibold text-[#1a1c1c]\">\n                      {minute.title.replace(/\\s+/g, \'_\')}_Minutes.pdf\n                    </span>\n                    <span className=\"text-[10px] text-[#767683]\">1.2 MB</span>\n                  </div>\n                </div>\n              )}\n            </div>\n          </div>\n        </div>\n\n        {/* Modal Footer Actions */}\n        <div className=\"px-6 py-4 border-t border-[#e2e2e2] bg-[#f9f9f9] flex flex-wrap justify-between items-center gap-3\">\n          <button\n            onClick={handleCopy}\n            className=\"text-xs font-semibold text-[#000666] hover:bg-white px-3 py-1.5 rounded-lg border border-[#c6c5d4]/40 transition-colors flex items-center gap-1.5 cursor-pointer\"\n          >\n            <span className=\"material-symbols-outlined text-[16px]\">\n              {copied ? \'check\' : \'content_copy\'}\n            </span>\n            <span>{copied ? \'Copied!\' : \'Copy Summary\'}</span>\n          </button>\n\n          <div className=\"flex items-center gap-2 ml-auto\">\n            <button\n              onClick={onClose}\n              className=\"px-4 py-2 rounded-full text-xs font-semibold text-[#000666] hover:bg-[#eeeeee] transition-colors cursor-pointer\"\n            >\n              Cancel\n            </button>\n            <button\n              onClick={handleExport}\n              disabled={isExporting}\n              id=\"btn-export-and-send\"\n              className=\"px-5 py-2 rounded-full bg-[#1a237e] hover:bg-[#000666] text-white text-xs font-bold shadow-md hover:shadow-lg transition-all active:scale-95 flex items-center gap-1.5 cursor-pointer\"\n            >\n              <span className={`material-symbols-outlined text-[16px] ${isExporting ? \'animate-spin\' : \'material-symbols-fill\'}`}>\n                {isExporting ? \'sync\' : \'send\'}\n              </span>\n              <span>{isExporting ? \'Distributing...\' : \'Export & Send\'}</span>\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
