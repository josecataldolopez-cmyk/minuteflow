        target_content: "export const INITIAL_SCHEDULE: ScheduleItem[] = [\n  {\n    id: \'sch-1\',\n    time: \'10:00\',\n    ampm: \'AM\',\n    title: \'Alineaci\303\263n Estrat\303\251gica Q3\',\n    participants: \'Equipo Ejecutivo + 3\',\n    platform: \'Zoom\',\n    link: \'https://zoom.us/j/982374623\'\n  },\n  {\n    id: \'sch-2\',\n    time: \'01:30\',\n    ampm: \'PM\',\n    title: \'Sincronizaci\303\263n de Producto: Flow V2\',\n    participants: \'L\303\255deres de Dise\303\261o e Ingenier\303\255a\',\n    platform: \'Sala A\'\n  },\n  {\n    id: \'sch-3\',\n    time: \'04:15\',\n    ampm: \'PM\',\n    title: \'Reuni\303\263n General de la Empresa y Preguntas\',\n    participants: \'Toda la Empresa (142 miembros)\',\n    platform: \'Auditorio Principal\'\n  }\n];\n\nexport const INITIAL_ACTION_ITEMS: ActionItem[] = [\n  {\n    id: \'act-1\',\n    text: \'Finalizar propuesta de presupuesto Q3\',\n    completed: false,\n    dueDate: \'2026-08-30\',\n    dueLabel: \'Vence hoy\',\n    priority: \'High\',\n    assignedTo: INITIAL_ATTENDEES[0]\n  },\n  {\n    id: \'act-2\',\n    text: \'Revisar contratos de proveedores para expansi\303\263n TI\',\n    completed: false,\n    dueDate: \'2026-09-02\',\n    dueLabel: \'Asignado a m\303\255\',\n    priority: \'Medium\',\n    assignedTo: INITIAL_ATTENDEES[0]\n  },\n  {\n    id: \'act-3\',\n    text: \'Preparar modelos financieros para fusi\303\263n con AlphaCorp\',\n    completed: false,\n    dueDate: \'2026-09-05\',\n    dueLabel: \'Alta\',\n    priority: \'High\',\n    assignedTo: INITIAL_ATTENDEES[3]\n  },\n  {\n    id: \'act-4\',\n    text: \'Redactar acuerdo de confidencialidad (NDA) para negociaciones con AlphaCorp\',\n    completed: true,\n    dueDate: \'2026-08-28\',\n    dueLabel: \'Completado\',\n    priority: \'High\',\n    assignedTo: INITIAL_ATTENDEES[5]\n  }\n];"
