  file_change {
    absolute_path_uri: "file:///src/components/LibraryView.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <div className=\"flex-1 overflow-y-auto p-4 md:p-8 bg-[#f9f9f9] custom-scrollbar\">\n      <div className=\"max-w-7xl mx-auto pb-24 flex flex-col gap-6\">\n        {/* Page Header & View Switcher */}\n        <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-4\">\n          <div>\n            <h1 className=\"text-2xl md:text-3xl font-bold text-[#1a1c1c] tracking-tight mb-1\">\n              Library Overview\n            </h1>\n            <p className=\"text-sm text-[#454652]\">\n              Manage and organize all executive minutes and documentation.\n            </p>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <button\n              onClick={onNewMinute}\n              className=\"text-xs font-semibold text-white bg-[#000666] hover:bg-[#1a237e] px-4 py-2.5 rounded-xl transition-all shadow-xs flex items-center gap-2 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">add</span>\n              <span>New Minute</span>\n            </button>\n            <div className=\"flex bg-[#f3f3f3] rounded-xl p-1 border border-[#c6c5d4]/40\">\n              <button\n                onClick={() => setViewFormat(\'card\')}\n                className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\n                  viewFormat === \'card\'\n                    ? \'bg-white text-[#1a1c1c] shadow-xs\'\n                    : \'text-[#454652] hover:text-[#1a1c1c]\'\n                }`}\n              >\n                <span className=\"material-symbols-outlined text-[16px]\">grid_view</span>\n                <span>Card</span>\n              </button>\n              <button\n                onClick={() => setViewFormat(\'list\')}\n                className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\n                  viewFormat === \'list\'\n                    ? \'bg-white text-[#1a1c1c] shadow-xs\'\n                    : \'text-[#454652] hover:text-[#1a1c1c]\'\n                }`}\n              >\n                <span className=\"material-symbols-outlined text-[16px]\">view_list</span>\n                <span>List</span>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Bento Grid Layout */}\n        <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6\">\n          {/* Directories & Smart Tags Sidebar (Span 3) */}\n          <div className=\"col-span-12 md:col-span-3 bg-white rounded-2xl shadow-xs border border-[#c6c5d4]/30 p-6 flex flex-col gap-6 self-start\">\n            {/* Directories Section */}\n            <div>\n              <div className=\"flex items-center justify-between border-b border-[#e2e2e2] pb-3 mb-3\">\n                <h3 className=\"text-sm font-bold text-[#1a1c1c] uppercase tracking-wider\">\n                  Directories\n                </h3>\n                {selectedDirectory && (\n                  <button\n                    onClick={() => setSelectedDirectory(null)}\n                    className=\"text-[11px] text-[#000666] font-semibold hover:underline\"\n                  >\n                    Clear Filter\n                  </button>\n                )}\n              </div>\n              <ul className=\"flex flex-col gap-1 text-sm font-medium\">\n                <li\n                  onClick={() => setSelectedDirectory(null)}\n                  className={`flex items-center justify-between p-2 rounded-xl cursor-pointer transition-colors ${\n                    selectedDirectory === null\n                      ? \'bg-[#f3f3f3] text-[#000666] font-bold\'\n                      : \'hover:bg-[#f9f9f9] text-[#454652]\'\n                  }`}\n                >\n                  <div className=\"flex items-center gap-2.5\">\n                    <span className=\"material-symbols-outlined text-[20px] text-[#000666]\">\n                      folder_open\n                    </span>\n                    <span>All Folders</span>\n                  </div>\n                  <span className=\"text-xs text-[#767683] font-normal\">{minutes.length}</span>\n                </li>\n\n                {directories.map((dir) => {\n                  const isSelected = selectedDirectory === dir.name;\n                  const count = minutes.filter((m) => m.directory === dir.name).length;\n                  return (\n                    <li\n                      key={dir.id}\n                      onClick={() => setSelectedDirectory(isSelected ? null : dir.name)}\n                      className={`flex items-center justify-between p-2 rounded-xl cursor-pointer transition-colors ${\n                        isSelected\n                          ? \'bg-[#f3f3f3] text-[#000666] font-bold\'\n                          : \'hover:bg-[#f9f9f9] text-[#454652]\'\n                      }`}\n                    >\n                      <div className=\"flex items-center gap-2.5 truncate\">\n                        <span\n                          className={`material-symbols-outlined text-[20px] ${\n                            isSelected ? \'material-symbols-fill text-[#000666]\' : \'text-[#767683]\'\n                          }`}\n                        >\n                          {isSelected ? \'folder_open\' : \'folder\'}\n                        </span>\n                        <span className=\"truncate\">{dir.name}</span>\n                      </div>\n                      <span\n                        className={`text-xs ${\n                          isSelected ? \'text-[#000666] font-bold\' : \'text-[#767683]\'\n                        }`}\n                      >\n                        {count || dir.count}\n                      </span>\n                    </li>\n                  );\n                })}\n              </ul>\n            </div>\n\n            {/* Smart Tags */}\n            <div>\n              <h3 className=\"text-sm font-bold text-[#1a1c1c] uppercase tracking-wider border-b border-[#e2e2e2] pb-3 mb-3\">\n                Smart Tags\n              </h3>\n              <div className=\"flex flex-wrap gap-2\">\n                <button\n                  onClick={() => setSelectedTag(\'All\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold transition-colors cursor-pointer border ${\n                    selectedTag === \'All\'\n                      ? \'bg-[#000666] text-white border-[#000666]\'\n                      : \'bg-[#eeeeee] text-[#454652] border-transparent hover:bg-[#e2e2e2]\'\n                  }`}\n                >\n                  All ({minutes.length})\n                </button>\n                <button\n                  onClick={() => setSelectedTag(\'Draft\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold transition-colors cursor-pointer border ${\n                    selectedTag === \'Draft\'\n                      ? \'bg-[#1a237e] text-white border-[#1a237e]\'\n                      : \'bg-[#eeeeee] text-[#1a1c1c] border-[#c6c5d4]/40 hover:bg-[#e2e2e2]\'\n                  }`}\n                >\n                  Draft\n                </button>\n                <button\n                  onClick={() => setSelectedTag(\'Approved\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold transition-colors cursor-pointer border ${\n                    selectedTag === \'Approved\'\n                      ? \'bg-[#1b6d24] text-white border-[#1b6d24]\'\n                      : \'bg-[#a0f399]/40 text-[#217128] border-[#a0f399] hover:bg-[#a0f399]/60\'\n                  }`}\n                >\n                  Approved\n                </button>\n                <button\n                  onClick={() => setSelectedTag(\'Pending Sig\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold transition-colors cursor-pointer border ${\n                    selectedTag === \'Pending Sig\'\n                      ? \'bg-[#002c6e] text-white border-[#002c6e]\'\n                      : \'bg-[#d9e2ff]/50 text-[#002c6e] border-[#d9e2ff] hover:bg-[#d9e2ff]\'\n                  }`}\n                >\n                  Pending Sig\n                </button>\n                <button\n                  onClick={() => setSelectedTag(\'Finished\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold transition-colors cursor-pointer border ${\n                    selectedTag === \'Finished\'\n                      ? \'bg-[#454652] text-white border-[#454652]\'\n                      : \'bg-[#dadada] text-[#454652] border-[#c6c5d4]/50 hover:bg-[#c6c5d4]\'\n                  }`}\n                >\n                  Finished\n                </button>\n              </div>\n            </div>\n          </div>\n\n          {/* Main Minutes Content Area (Span 9) */}\n          <div className=\"col-span-12 md:col-span-9 flex flex-col gap-4\">\n            {/* Bulk Actions Bar */}\n            <div className=\"bg-[#f3f3f3] rounded-xl p-3.5 border border-[#c6c5d4]/40 flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <input\n                  type=\"checkbox\"\n                  checked={\n                    filteredMinutes.length > 0 &&\n                    selectedMinuteIds.length === filteredMinutes.length\n                  }\n                  onChange={handleSelectAll}\n                  className=\"rounded border-[#767683] text-[#000666] focus:ring-[#000666] w-4 h-4 ml-1 cursor-pointer\"\n                />\n                <span className=\"text-xs md:text-sm font-medium text-[#454652]\">\n                  {selectedMinuteIds.length > 0\n                    ? `${selectedMinuteIds.length} Selected`\n                    : \'Select All\'}\n                </span>\n              </div>\n\n              <div\n                className={`flex gap-1.5 items-center transition-opacity ${\n                  selectedMinuteIds.length === 0 ? \'opacity-40 pointer-events-none\' : \'opacity-100\'\n                }`}\n              >\n                <button\n                  onClick={() => {\n                    const selected = minutes.filter((m) => selectedMinuteIds.includes(m.id));\n                    if (selected.length > 0) onOpenExport(selected[0]);\n                  }}\n                  className=\"p-2 rounded-lg hover:bg-white text-[#454652] hover:text-[#000666] transition-colors cursor-pointer\"\n                  title=\"Export / Download\"\n                >\n                  <span className=\"material-symbols-outlined text-[20px]\">download</span>\n                </button>\n                <button\n                  onClick={() => alert(`Moved ${selectedMinuteIds.length} minutes to folder`)}\n                  className=\"p-2 rounded-lg hover:bg-white text-[#454652] hover:text-[#000666] transition-colors cursor-pointer\"\n                  title=\"Move to Folder\"\n                >\n                  <span className=\"material-symbols-outlined text-[20px]\">drive_file_move</span>\n                </button>\n                <button\n                  onClick={handleBulkDelete}\n                  className=\"p-2 rounded-lg hover:bg-[#ffdad6] text-[#ba1a1a] transition-colors cursor-pointer\"\n                  title=\"Delete Selected\"\n                >\n                  <span className=\"material-symbols-outlined text-[20px]\">delete</span>\n                </button>\n              </div>\n            </div>\n\n            {/* Minutes Display: Cards or List */}\n            {filteredMinutes.length === 0 ? (\n              <div className=\"bg-white rounded-2xl p-12 text-center border border-[#c6c5d4]/30\">\n                <span className=\"material-symbols-outlined text-[48px] text-[#767683] mb-2\">\n                  folder_off\n                </span>\n                <h4 className=\"text-base font-semibold text-[#1a1c1c]\">No minutes found</h4>\n                <p className=\"text-xs text-[#767683] mt-1 mb-4\">\n                  No meeting minutes matching the current filter.\n                </p>\n                <button\n                  onClick={onNewMinute}\n                  className=\"text-xs bg-[#000666] text-white font-semibold px-4 py-2 rounded-xl\"\n                >\n                  Create New Minute\n                </button>\n              </div>\n            ) : viewFormat === \'card\' ? (\n              <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n                {filteredMinutes.map((minute) => {\n                  const isSelected = selectedMinuteIds.includes(minute.id);\n                  return (\n                    <div\n                      key={minute.id}\n                      onClick={() => onSelectMinute(minute)}\n                      className={`bg-white rounded-2xl p-5 border shadow-xs hover:shadow-lg hover:border-[#000666]/40 transition-all cursor-pointer group relative flex flex-col h-full ${\n                        isSelected ? \'border-[#000666] ring-2 ring-[#000666]/20\' : \'border-[#c6c5d4]/40\'\n                      }`}\n                    >\n                      {/* Checkbox Hover Reveal */}\n                      <div\n                        onClick={(e) => handleToggleSelect(minute.id, e)}\n                        className={`absolute top-4 left-4 z-10 transition-opacity ${\n                          isSelected ? \'opacity-100\' : \'opacity-0 group-hover:opacity-100\'\n                        }`}\n                      >\n                        <input\n                          type=\"checkbox\"\n                          checked={isSelected}\n                          onChange={() => {}}\n                          className=\"rounded border-[#767683] text-[#000666] focus:ring-[#000666] w-4 h-4 cursor-pointer\"\n                        />\n                      </div>\n\n                      {/* Header Area */}\n                      <div className=\"flex justify-between items-start mb-3 pl-6 group-hover:pl-6 transition-all\">\n                        <div className=\"w-10 h-10 rounded-xl bg-[#eeeeee] flex items-center justify-center text-[#000666] shadow-2xs\">\n                          <span className=\"material-symbols-outlined text-[20px] material-symbols-fill\">\n                            description\n                          </span>\n                        </div>\n\n                        {/* 3-dot dropdown menu */}\n                        <div className=\"relative\">\n                          <button\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              setOpenMenuId(openMenuId === minute.id ? null : minute.id);\n                            }}\n                            className=\"p-1 rounded-lg text-[#767683] hover:text-[#1a1c1c] hover:bg-[#eeeeee] transition-colors\"\n                          >\n                            <span className=\"material-symbols-outlined text-[20px]\">more_vert</span>\n                          </button>\n\n                          {openMenuId === minute.id && (\n                            <div\n                              onClick={(e) => e.stopPropagation()}\n                              className=\"absolute right-0 top-full mt-1 w-44 bg-white rounded-xl shadow-xl border border-[#c6c5d4]/40 py-1.5 z-30\"\n                            >\n                              <button\n                                onClick={() => {\n                                  onSelectMinute(minute);\n                                  setOpenMenuId(null);\n                                }}\n                                className=\"w-full text-left px-3 py-2 text-xs text-[#1a1c1c] hover:bg-[#f3f3f3] flex items-center gap-2\"\n                              >\n                                <span className=\"material-symbols-outlined text-[16px]\">edit</span>\n                                Open Editor\n                              </button>\n                              <button\n                                onClick={() => {\n                                  onOpenExport(minute);\n                                  setOpenMenuId(null);\n                                }}\n                                className=\"w-full text-left px-3 py-2 text-xs text-[#1a1c1c] hover:bg-[#f3f3f3] flex items-center gap-2\"\n                              >\n                                <span className=\"material-symbols-outlined text-[16px]\">\n                                  ios_share\n                                </span>\n                                Export & Share\n                              </button>\n                              <button\n                                onClick={() => {\n                                  onDuplicateMinute(minute);\n                                  setOpenMenuId(null);\n                                }}\n                                className=\"w-full text-left px-3 py-2 text-xs text-[#1a1c1c] hover:bg-[#f3f3f3] flex items-center gap-2\"\n                              >\n                                <span className=\"material-symbols-outlined text-[16px]\">\n                                  content_copy\n                                </span>\n                                Duplicate\n                              </button>\n                              <div className=\"my-1 border-t border-[#e2e2e2]\" />\n                              <button\n                                onClick={() => {\n                                  onDeleteMinute(minute.id);\n                                  setOpenMenuId(null);\n                                }}\n                                className=\"w-full text-left px-3 py-2 text-xs text-[#ba1a1a] hover:bg-[#ffdad6]/40 flex items-center gap-2\"\n                              >\n                                <span className=\"material-symbols-outlined text-[16px]\">delete</span>\n                                Delete\n                              </button>\n                            </div>\n                          )}\n                        </div>\n                      </div>\n\n                      {/* Title and Summary */}\n                      <h4 className=\"font-semibold text-sm text-[#1a1c1c] mb-1 line-clamp-1 group-hover:text-[#000666] transition-colors\">\n                        {minute.title}\n                      </h4>\n                      <p className=\"text-xs text-[#454652] mb-4 line-clamp-2 flex-1 leading-relaxed\">\n                        {minute.objectives ||\n                          minute.pointsTreated.split(\'\\n\')[0] ||\n                          \'Executive meeting notes and discussion takeaways.\'}\n                      </p>\n\n                      {/* Footer Info */}\n                      <div className=\"mt-auto\">\n                        <div className=\"flex justify-between items-center mb-3\">\n                          <span\n                            className={`px-2.5 py-0.5 rounded-md text-[11px] font-bold border ${\n                              minute.status === \'Approved\'\n                                ? \'bg-[#a0f399]/30 text-[#217128] border-[#a0f399]\'\n                                : minute.status === \'Draft\'\n                                ? \'bg-[#eeeeee] text-[#1a1c1c] border-[#c6c5d4]/50\'\n                                : minute.status === \'Pending Sig\'\n                                ? \'bg-[#d9e2ff]/50 text-[#002c6e] border-[#d9e2ff]\'\n                                : \'bg-[#dadada] text-[#454652] border-[#c6c5d4]\'\n                            }`}\n                          >\n                            {minute.status}\n                          </span>\n                          <span className=\"text-[11px] text-[#767683] font-medium\">\n                            {minute.formattedDate}\n                          </span>\n                        </div>\n\n                        <div className=\"flex items-center justify-between pt-3 border-t border-[#e2e2e2]/60\">\n                          <div className=\"flex items-center gap-1.5\">\n                            <div className=\"flex -space-x-1.5 overflow-hidden\">\n                              {minute.attendees.map((att) => (\n                                <img\n                                  key={att.id}\n                                  src={att.avatarUrl}\n                                  alt={att.name}\n                                  title={att.name}\n                                  className=\"w-5 h-5 rounded-full border border-white object-cover\"\n                                />\n                              ))}\n                            </div>\n                            <span className=\"text-[11px] text-[#767683]\">\n                              {minute.attendees.length > 2\n                                ? `+${minute.attendees.length - 2} attendees`\n                                : `${minute.attendees.length} attendee${minute.attendees.length > 1 ? \'s\' : \'\'}`}\n                            </span>\n                          </div>\n\n                          <button\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              onOpenExport(minute);\n                            }}\n                            className=\"text-[#000666] hover:text-[#1a237e] p-1 text-xs font-semibold flex items-center gap-0.5\"\n                          >\n                            <span className=\"material-symbols-outlined text-[16px]\">ios_share</span>\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            ) : (\n              /* List View Table */\n              <div className=\"bg-white rounded-2xl border border-[#c6c5d4]/40 overflow-hidden shadow-xs\">\n                <table className=\"w-full text-left text-xs\">\n                  <thead className=\"bg-[#f3f3f3] border-b border-[#e2e2e2] text-[#767683] uppercase font-semibold text-[10px] tracking-wider\">\n                    <tr>\n                      <th className=\"p-3 w-10 text-center\">\n                        <input\n                          type=\"checkbox\"\n                          checked={\n                            filteredMinutes.length > 0 &&\n                            selectedMinuteIds.length === filteredMinutes.length\n                          }\n                          onChange={handleSelectAll}\n                          className=\"rounded border-[#767683] text-[#000666]\"\n                        />\n                      </th>\n                      <th className=\"p-3\">Title</th>\n                      <th className=\"p-3 hidden sm:table-cell\">Directory</th>\n                      <th className=\"p-3\">Status</th>\n                      <th className=\"p-3 hidden md:table-cell\">Date</th>\n                      <th className=\"p-3 text-right\">Actions</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-[#e2e2e2]\">\n                    {filteredMinutes.map((minute) => (\n                      <tr\n                        key={minute.id}\n                        onClick={() => onSelectMinute(minute)}\n                        className=\"hover:bg-[#f9f9f9] cursor-pointer transition-colors\"\n                      >\n                        <td className=\"p-3 text-center\" onClick={(e) => e.stopPropagation()}>\n                          <input\n                            type=\"checkbox\"\n                            checked={selectedMinuteIds.includes(minute.id)}\n                            onChange={(e) => handleToggleSelect(minute.id, e as unknown as React.MouseEvent)}\n                            className=\"rounded border-[#767683] text-[#000666]\"\n                          />\n                        </td>\n                        <td className=\"p-3 font-semibold text-[#1a1c1c]\">{minute.title}</td>\n                        <td className=\"p-3 text-[#454652] hidden sm:table-cell\">{minute.directory}</td>\n                        <td className=\"p-3\">\n                          <span\n                            className={`px-2 py-0.5 rounded-full text-[10px] font-bold ${\n                              minute.status === \'Approved\'\n                                ? \'bg-[#a0f399]/40 text-[#217128]\'\n                                : minute.status === \'Draft\'\n                                ? \'bg-[#eeeeee] text-[#1a1c1c]\'\n                                : \'bg-[#d9e2ff] text-[#002c6e]\'\n                            }`}\n                          >\n                            {minute.status}\n                          </span>\n                        </td>\n                        <td className=\"p-3 text-[#767683] hidden md:table-cell\">\n                          {minute.formattedDate}\n                        </td>\n                        <td className=\"p-3 text-right\">\n                          <button\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              onOpenExport(minute);\n                            }}\n                            className=\"p-1 text-[#000666] hover:bg-[#eeeeee] rounded\"\n                            title=\"Export\"\n                          >\n                            <span className=\"material-symbols-outlined text-[18px]\">ios_share</span>\n                          </button>\n                        </td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"flex-1 overflow-y-auto p-4 md:p-8 bg-slate-50 custom-scrollbar\">\n      <div className=\"max-w-7xl mx-auto pb-24 flex flex-col gap-6\">\n        {/* Page Header & View Switcher */}\n        <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-4\">\n          <div>\n            <h1 className=\"text-2xl md:text-3xl font-bold text-slate-900 tracking-tight mb-1\">\n              Library Overview\n            </h1>\n            <p className=\"text-sm text-slate-500\">\n              Manage and organize all executive minutes and documentation.\n            </p>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <button\n              onClick={onNewMinute}\n              className=\"text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 px-4 py-2.5 rounded-xl transition-all shadow-md shadow-indigo-100 flex items-center gap-2 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">add</span>\n              <span>New Minute</span>\n            </button>\n            <div className=\"flex bg-slate-100 rounded-xl p-1 border border-slate-200\">\n              <button\n                onClick={() => setViewFormat(\'card\')}\n                className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\n                  viewFormat === \'card\'\n                    ? \'bg-white text-slate-900 shadow-xs\'\n                    : \'text-slate-500 hover:text-slate-900\'\n                }`}\n              >\n                <span className=\"material-symbols-outlined text-[16px]\">grid_view</span>\n                <span>Card</span>\n              </button>\n              <button\n                onClick={() => setViewFormat(\'list\')}\n                className={`px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-all cursor-pointer ${\n                  viewFormat === \'list\'\n                    ? \'bg-white text-slate-900 shadow-xs\'\n                    : \'text-slate-500 hover:text-slate-900\'\n                }`}\n              >\n                <span className=\"material-symbols-outlined text-[16px]\">view_list</span>\n                <span>List</span>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Bento Grid Layout */}\n        <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6\">\n          {/* Directories & Smart Tags Sidebar (Span 3) */}\n          <div className=\"col-span-12 md:col-span-3 bg-white rounded-2xl shadow-sm border border-slate-100 p-6 flex flex-col gap-6 self-start\">\n            {/* Directories Section */}\n            <div>\n              <div className=\"flex items-center justify-between border-b border-slate-100 pb-3 mb-3\">\n                <h3 className=\"text-sm font-bold text-slate-900 uppercase tracking-wider\">\n                  Directories\n                </h3>\n                {selectedDirectory && (\n                  <button\n                    onClick={() => setSelectedDirectory(null)}\n                    className=\"text-[11px] text-indigo-600 font-semibold hover:underline\"\n                  >\n                    Clear Filter\n                  </button>\n                )}\n              </div>\n              <ul className=\"flex flex-col gap-1 text-sm font-medium\">\n                <li\n                  onClick={() => setSelectedDirectory(null)}\n                  className={`flex items-center justify-between p-2.5 rounded-xl cursor-pointer transition-colors ${\n                    selectedDirectory === null\n                      ? \'bg-indigo-50 text-indigo-700 font-bold\'\n                      : \'hover:bg-slate-50 text-slate-600\'\n                  }`}\n                >\n                  <div className=\"flex items-center gap-2.5\">\n                    <span className=\"material-symbols-outlined text-[20px] text-indigo-600\">\n                      folder_open\n                    </span>\n                    <span>All Folders</span>\n                  </div>\n                  <span className=\"text-xs text-slate-400 font-normal\">{minutes.length}</span>\n                </li>\n\n                {directories.map((dir) => {\n                  const isSelected = selectedDirectory === dir.name;\n                  const count = minutes.filter((m) => m.directory === dir.name).length;\n                  return (\n                    <li\n                      key={dir.id}\n                      onClick={() => setSelectedDirectory(isSelected ? null : dir.name)}\n                      className={`flex items-center justify-between p-2.5 rounded-xl cursor-pointer transition-colors ${\n                        isSelected\n                          ? \'bg-indigo-50 text-indigo-700 font-bold\'\n                          : \'hover:bg-slate-50 text-slate-600\'\n                      }`}\n                    >\n                      <div className=\"flex items-center gap-2.5 truncate\">\n                        <span\n                          className={`material-symbols-outlined text-[20px] ${\n                            isSelected ? \'material-symbols-fill text-indigo-600\' : \'text-slate-400\'\n                          }`}\n                        >\n                          {isSelected ? \'folder_open\' : \'folder\'}\n                        </span>\n                        <span className=\"truncate\">{dir.name}</span>\n                      </div>\n                      <span\n                        className={`text-xs ${\n                          isSelected ? \'text-indigo-600 font-bold\' : \'text-slate-400\'\n                        }`}\n                      >\n                        {count || dir.count}\n                      </span>\n                    </li>\n                  );\n                })}\n              </ul>\n            </div>\n\n            {/* Smart Tags */}\n            <div>\n              <h3 className=\"text-sm font-bold text-slate-900 uppercase tracking-wider border-b border-slate-100 pb-3 mb-3\">\n                Smart Tags\n              </h3>\n              <div className=\"flex flex-wrap gap-2\">\n                <button\n                  onClick={() => setSelectedTag(\'All\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold transition-colors cursor-pointer border ${\n                    selectedTag === \'All\'\n                      ? \'bg-indigo-600 text-white border-indigo-600\'\n                      : \'bg-slate-100 text-slate-600 border-slate-200 hover:bg-slate-200/70\'\n                  }`}\n                >\n                  All ({minutes.length})\n                </button>\n                <button\n                  onClick={() => setSelectedTag(\'Draft\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold transition-colors cursor-pointer border ${\n                    selectedTag === \'Draft\'\n                      ? \'bg-indigo-600 text-white border-indigo-600\'\n                      : \'bg-indigo-50 text-indigo-700 border-indigo-200/50 hover:bg-indigo-100\'\n                  }`}\n                >\n                  Draft\n                </button>\n                <button\n                  onClick={() => setSelectedTag(\'Approved\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold transition-colors cursor-pointer border ${\n                    selectedTag === \'Approved\'\n                      ? \'bg-emerald-600 text-white border-emerald-600\'\n                      : \'bg-emerald-50 text-emerald-700 border-emerald-200/50 hover:bg-emerald-100\'\n                  }`}\n                >\n                  Approved\n                </button>\n                <button\n                  onClick={() => setSelectedTag(\'Pending Sig\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold transition-colors cursor-pointer border ${\n                    selectedTag === \'Pending Sig\'\n                      ? \'bg-amber-600 text-white border-amber-600\'\n                      : \'bg-amber-50 text-amber-700 border-amber-200/50 hover:bg-amber-100\'\n                  }`}\n                >\n                  Pending Sig\n                </button>\n                <button\n                  onClick={() => setSelectedTag(\'Finished\')}\n                  className={`px-3 py-1 rounded-full text-xs font-semibold transition-colors cursor-pointer border ${\n                    selectedTag === \'Finished\'\n                      ? \'bg-slate-800 text-white border-slate-800\'\n                      : \'bg-slate-100 text-slate-600 border-slate-200 hover:bg-slate-200\'\n                  }`}\n                >\n                  Finished\n                </button>\n              </div>\n            </div>\n          </div>\n\n          {/* Main Minutes Content Area (Span 9) */}\n          <div className=\"col-span-12 md:col-span-9 flex flex-col gap-4\">\n            {/* Bulk Actions Bar */}\n            <div className=\"bg-white rounded-2xl p-3.5 border border-slate-100 shadow-sm flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <input\n                  type=\"checkbox\"\n                  checked={\n                    filteredMinutes.length > 0 &&\n                    selectedMinuteIds.length === filteredMinutes.length\n                  }\n                  onChange={handleSelectAll}\n                  className=\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-4 h-4 ml-1 cursor-pointer\"\n                />\n                <span className=\"text-xs md:text-sm font-medium text-slate-600\">\n                  {selectedMinuteIds.length > 0\n                    ? `${selectedMinuteIds.length} Selected`\n                    : \'Select All\'}\n                </span>\n              </div>\n\n              <div\n                className={`flex gap-1.5 items-center transition-opacity ${\n                  selectedMinuteIds.length === 0 ? \'opacity-40 pointer-events-none\' : \'opacity-100\'\n                }`}\n              >\n                <button\n                  onClick={() => {\n                    const selected = minutes.filter((m) => selectedMinuteIds.includes(m.id));\n                    if (selected.length > 0) onOpenExport(selected[0]);\n                  }}\n                  className=\"p-2 rounded-lg hover:bg-slate-50 text-slate-500 hover:text-indigo-600 transition-colors cursor-pointer\"\n                  title=\"Export / Download\"\n                >\n                  <span className=\"material-symbols-outlined text-[20px]\">download</span>\n                </button>\n                <button\n                  onClick={() => alert(`Moved ${selectedMinuteIds.length} minutes to folder`)}\n                  className=\"p-2 rounded-lg hover:bg-slate-50 text-slate-500 hover:text-indigo-600 transition-colors cursor-pointer\"\n                  title=\"Move to Folder\"\n                >\n                  <span className=\"material-symbols-outlined text-[20px]\">drive_file_move</span>\n                </button>\n                <button\n                  onClick={handleBulkDelete}\n                  className=\"p-2 rounded-lg hover:bg-rose-50 text-rose-600 transition-colors cursor-pointer\"\n                  title=\"Delete Selected\"\n                >\n                  <span className=\"material-symbols-outlined text-[20px]\">delete</span>\n                </button>\n              </div>\n            </div>\n\n            {/* Minutes Display: Cards or List */}\n            {filteredMinutes.length === 0 ? (\n              <div className=\"bg-white rounded-2xl p-12 text-center border border-slate-100 shadow-sm\">\n                <span className=\"material-symbols-outlined text-[48px] text-slate-400 mb-2\">\n                  folder_off\n                </span>\n                <h4 className=\"text-base font-semibold text-slate-900\">No minutes found</h4>\n                <p className=\"text-xs text-slate-500 mt-1 mb-4\">\n                  No meeting minutes matching the current filter.\n                </p>\n                <button\n                  onClick={onNewMinute}\n                  className=\"text-xs bg-indigo-600 text-white font-semibold px-4 py-2 rounded-xl hover:bg-indigo-700 shadow-sm\"\n                >\n                  Create New Minute\n                </button>\n              </div>\n            ) : viewFormat === \'card\' ? (\n              <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5\">\n                {filteredMinutes.map((minute) => {\n                  const isSelected = selectedMinuteIds.includes(minute.id);\n                  return (\n                    <div\n                      key={minute.id}\n                      onClick={() => onSelectMinute(minute)}\n                      className={`bg-white rounded-2xl p-5 border shadow-sm hover:shadow-md hover:border-indigo-200 transition-all cursor-pointer group relative flex flex-col h-full ${\n                        isSelected ? \'border-indigo-600 ring-2 ring-indigo-100\' : \'border-slate-100\'\n                      }`}\n                    >\n                      {/* Checkbox Hover Reveal */}\n                      <div\n                        onClick={(e) => handleToggleSelect(minute.id, e)}\n                        className={`absolute top-4 left-4 z-10 transition-opacity ${\n                          isSelected ? \'opacity-100\' : \'opacity-0 group-hover:opacity-100\'\n                        }`}\n                      >\n                        <input\n                          type=\"checkbox\"\n                          checked={isSelected}\n                          onChange={() => {}}\n                          className=\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-4 h-4 cursor-pointer\"\n                        />\n                      </div>\n\n                      {/* Header Area */}\n                      <div className=\"flex justify-between items-start mb-3 pl-6 group-hover:pl-6 transition-all\">\n                        <div className=\"w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600 shadow-2xs\">\n                          <span className=\"material-symbols-outlined text-[20px] material-symbols-fill\">\n                            description\n                          </span>\n                        </div>\n\n                        {/* 3-dot dropdown menu */}\n                        <div className=\"relative\">\n                          <button\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              setOpenMenuId(openMenuId === minute.id ? null : minute.id);\n                            }}\n                            className=\"p-1 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-50 transition-colors\"\n                          >\n                            <span className=\"material-symbols-outlined text-[20px]\">more_vert</span>\n                          </button>\n\n                          {openMenuId === minute.id && (\n                            <div\n                              onClick={(e) => e.stopPropagation()}\n                              className=\"absolute right-0 top-full mt-1 w-44 bg-white rounded-2xl shadow-xl border border-slate-100 py-1.5 z-30\"\n                            >\n                              <button\n                                onClick={() => {\n                                  onSelectMinute(minute);\n                                  setOpenMenuId(null);\n                                }}\n                                className=\"w-full text-left px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 flex items-center gap-2\"\n                              >\n                                <span className=\"material-symbols-outlined text-[16px] text-slate-400\">edit</span>\n                                Open Editor\n                              </button>\n                              <button\n                                onClick={() => {\n                                  onOpenExport(minute);\n                                  setOpenMenuId(null);\n                                }}\n                                className=\"w-full text-left px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 flex items-center gap-2\"\n                              >\n                                <span className=\"material-symbols-outlined text-[16px] text-slate-400\">\n                                  ios_share\n                                </span>\n                                Export & Share\n                              </button>\n                              <button\n                                onClick={() => {\n                                  onDuplicateMinute(minute);\n                                  setOpenMenuId(null);\n                                }}\n                                className=\"w-full text-left px-3 py-2 text-xs text-slate-700 hover:bg-slate-50 flex items-center gap-2\"\n                              >\n                                <span className=\"material-symbols-outlined text-[16px] text-slate-400\">\n                                  content_copy\n                                </span>\n                                Duplicate\n                              </button>\n                              <div className=\"my-1 border-t border-slate-100\" />\n                              <button\n                                onClick={() => {\n                                  onDeleteMinute(minute.id);\n                                  setOpenMenuId(null);\n                                }}\n                                className=\"w-full text-left px-3 py-2 text-xs text-rose-600 hover:bg-rose-50 flex items-center gap-2\"\n                              >\n                                <span className=\"material-symbols-outlined text-[16px]\">delete</span>\n                                Delete\n                              </button>\n                            </div>\n                          )}\n                        </div>\n                      </div>\n\n                      {/* Title and Summary */}\n                      <h4 className=\"font-semibold text-sm text-slate-900 mb-1 line-clamp-1 group-hover:text-indigo-600 transition-colors\">\n                        {minute.title}\n                      </h4>\n                      <p className=\"text-xs text-slate-500 mb-4 line-clamp-2 flex-1 leading-relaxed\">\n                        {minute.objectives ||\n                          minute.pointsTreated.split(\'\\n\')[0] ||\n                          \'Executive meeting notes and discussion takeaways.\'}\n                      </p>\n\n                      {/* Footer Info */}\n                      <div className=\"mt-auto\">\n                        <div className=\"flex justify-between items-center mb-3\">\n                          <span\n                            className={`px-2.5 py-0.5 rounded-full text-[11px] font-bold border ${\n                              minute.status === \'Approved\'\n                                ? \'bg-emerald-50 text-emerald-700 border-emerald-200/50\'\n                                : minute.status === \'Draft\'\n                                ? \'bg-indigo-50 text-indigo-700 border-indigo-200/50\'\n                                : minute.status === \'Pending Sig\'\n                                ? \'bg-amber-50 text-amber-700 border-amber-200/50\'\n                                : \'bg-slate-100 text-slate-600 border-slate-200\'\n                            }`}\n                          >\n                            {minute.status}\n                          </span>\n                          <span className=\"text-[11px] text-slate-400 font-medium\">\n                            {minute.formattedDate}\n                          </span>\n                        </div>\n\n                        <div className=\"flex items-center justify-between pt-3 border-t border-slate-100\">\n                          <div className=\"flex items-center gap-1.5\">\n                            <div className=\"flex -space-x-1.5 overflow-hidden\">\n                              {minute.attendees.map((att) => (\n                                <img\n                                  key={att.id}\n                                  src={att.avatarUrl}\n                                  alt={att.name}\n                                  title={att.name}\n                                  className=\"w-5 h-5 rounded-full border border-white object-cover\"\n                                />\n                              ))}\n                            </div>\n                            <span className=\"text-[11px] text-slate-400\">\n                              {minute.attendees.length > 2\n                                ? `+${minute.attendees.length - 2} attendees`\n                                : `${minute.attendees.length} attendee${minute.attendees.length > 1 ? \'s\' : \'\'}`}\n                            </span>\n                          </div>\n\n                          <button\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              onOpenExport(minute);\n                            }}\n                            className=\"text-indigo-600 hover:text-indigo-700 p-1 text-xs font-semibold flex items-center gap-0.5\"\n                          >\n                            <span className=\"material-symbols-outlined text-[16px]\">ios_share</span>\n                          </button>\n                        </div>\n                      </div>\n                    </div>\n                  );\n                })}\n              </div>\n            ) : (\n              /* List View Table */\n              <div className=\"bg-white rounded-2xl border border-slate-100 overflow-hidden shadow-sm\">\n                <table className=\"w-full text-left text-xs\">\n                  <thead className=\"bg-slate-50/70 border-b border-slate-100 text-slate-400 uppercase font-semibold text-[10px] tracking-wider\">\n                    <tr>\n                      <th className=\"p-3 w-10 text-center\">\n                        <input\n                          type=\"checkbox\"\n                          checked={\n                            filteredMinutes.length > 0 &&\n                            selectedMinuteIds.length === filteredMinutes.length\n                          }\n                          onChange={handleSelectAll}\n                          className=\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500\"\n                        />\n                      </th>\n                      <th className=\"p-3\">Title</th>\n                      <th className=\"p-3 hidden sm:table-cell\">Directory</th>\n                      <th className=\"p-3\">Status</th>\n                      <th className=\"p-3 hidden md:table-cell\">Date</th>\n                      <th className=\"p-3 text-right\">Actions</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-slate-100\">\n                    {filteredMinutes.map((minute) => (\n                      <tr\n                        key={minute.id}\n                        onClick={() => onSelectMinute(minute)}\n                        className=\"hover:bg-slate-50 cursor-pointer transition-colors\"\n                      >\n                        <td className=\"p-3 text-center\" onClick={(e) => e.stopPropagation()}>\n                          <input\n                            type=\"checkbox\"\n                            checked={selectedMinuteIds.includes(minute.id)}\n                            onChange={(e) => handleToggleSelect(minute.id, e as unknown as React.MouseEvent)}\n                            className=\"rounded border-slate-300 text-indigo-600 focus:ring-indigo-500\"\n                          />\n                        </td>\n                        <td className=\"p-3 font-semibold text-slate-900\">{minute.title}</td>\n                        <td className=\"p-3 text-slate-500 hidden sm:table-cell\">{minute.directory}</td>\n                        <td className=\"p-3\">\n                          <span\n                            className={`px-2.5 py-0.5 rounded-full text-[10px] font-bold ${\n                              minute.status === \'Approved\'\n                                ? \'bg-emerald-50 text-emerald-700 border border-emerald-200/50\'\n                                : minute.status === \'Draft\'\n                                ? \'bg-indigo-50 text-indigo-700 border border-indigo-200/50\'\n                                : \'bg-amber-50 text-amber-700 border border-amber-200/50\'\n                            }`}\n                          >\n                            {minute.status}\n                          </span>\n                        </td>\n                        <td className=\"p-3 text-slate-400 hidden md:table-cell\">\n                          {minute.formattedDate}\n                        </td>\n                        <td className=\"p-3 text-right\">\n                          <button\n                            onClick={(e) => {\n                              e.stopPropagation();\n                              onOpenExport(minute);\n                            }}\n                            className=\"p-1 text-indigo-600 hover:bg-indigo-50 rounded-lg\"\n                            title=\"Export\"\n                          >\n                            <span className=\"material-symbols-outlined text-[18px]\">ios_share</span>\n                          </button>\n                        </td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );"
