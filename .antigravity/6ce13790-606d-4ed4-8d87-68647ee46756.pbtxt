    instruction: "Apply Sleek Interface theme styling to TopAppBar component"
    replacement_infos {
      original_chunk {
        target_content: "    <header className=\"bg-[#f9f9f9] border-b border-[#c6c5d4]/30 w-full h-16 shadow-xs flex justify-between items-center px-4 md:px-8 flex-shrink-0 z-30 sticky top-0\">\n      {/* Mobile Branding */}\n      <div className=\"md:hidden flex items-center gap-2\">\n        <div className=\"w-8 h-8 rounded-lg bg-[#1a237e] text-white flex items-center justify-center font-bold text-xs\">\n          MF\n        </div>\n        <span className=\"text-lg font-bold text-[#000666]\">MinuteFlow</span>\n      </div>\n\n      {/* Global Search Bar */}\n      <div ref={searchRef} className=\"hidden md:flex flex-1 max-w-xl mx-auto relative\">\n        <span className=\"material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-[#767683] text-[20px] pointer-events-none\">\n          search\n        </span>\n        <input\n          id=\"global-search-input\"\n          type=\"text\"\n          value={searchQuery}\n          onChange={(e) => {\n            onSearchChange(e.target.value);\n            setShowSearchDropdown(true);\n          }}\n          onFocus={() => setShowSearchDropdown(true)}\n          placeholder=\"Search meetings, tasks, or decisions...\"\n          className=\"w-full bg-[#eeeeee] hover:bg-[#e8e8e8] focus:bg-white text-[#1a1c1c] placeholder-[#767683] border border-transparent focus:border-[#000666]/30 rounded-full py-2 pl-10 pr-10 focus:ring-2 focus:ring-[#000666]/20 font-medium text-sm transition-all outline-none\"\n        />\n        {searchQuery ? (\n          <button\n            onClick={() => onSearchChange(\'\')}\n            className=\"absolute right-3 top-1/2 -translate-y-1/2 text-[#767683] hover:text-[#1a1c1c] text-xs\"\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">close</span>\n          </button>\n        ) : (\n          <button\n            title=\"Filter search\"\n            className=\"absolute right-3.5 top-1/2 -translate-y-1/2 text-[#767683] hover:text-[#000666] transition-colors\"\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">tune</span>\n          </button>\n        )}\n\n        {/* Live Search Results Dropdown */}\n        {showSearchDropdown && searchQuery.trim().length > 0 && (\n          <div className=\"absolute left-0 right-0 top-full mt-2 bg-white rounded-xl shadow-xl border border-[#c6c5d4]/40 p-2 z-50 max-h-80 overflow-y-auto\">\n            <div className=\"text-[11px] font-semibold uppercase tracking-wider text-[#767683] px-3 py-1.5 border-b border-[#c6c5d4]/20\">\n              Matching Minutes ({filteredResults.length})\n            </div>\n            {filteredResults.length > 0 ? (\n              filteredResults.map((m) => (\n                <div\n                  key={m.id}\n                  onClick={() => {\n                    onSelectMinute(m);\n                    setShowSearchDropdown(false);\n                  }}\n                  className=\"flex items-center justify-between p-2.5 rounded-lg hover:bg-[#f3f3f3] cursor-pointer transition-colors\"\n                >\n                  <div className=\"flex items-center gap-3\">\n                    <span className=\"material-symbols-outlined text-[#1a237e] text-[20px]\">\n                      description\n                    </span>\n                    <div>\n                      <h4 className=\"text-sm font-semibold text-[#1a1c1c]\">{m.title}</h4>\n                      <p className=\"text-xs text-[#767683] line-clamp-1\">{m.objectives || m.directory}</p>\n                    </div>\n                  </div>\n                  <span\n                    className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${\n                      m.status === \'Approved\'\n                        ? \'bg-[#a0f399]/40 text-[#217128]\'\n                        : m.status === \'Draft\'\n                        ? \'bg-[#e0e0ff] text-[#1a237e]\'\n                        : \'bg-[#d9e2ff] text-[#002c6e]\'\n                    }`}\n                  >\n                    {m.status}\n                  </span>\n                </div>\n              ))\n            ) : (\n              <div className=\"p-4 text-center text-xs text-[#767683]\">\n                No minutes found matching &quot;{searchQuery}&quot;\n              </div>\n            )}\n          </div>\n        )}\n      </div>\n\n      {/* Right Actions */}\n      <div className=\"flex items-center gap-2 md:gap-3 ml-auto md:ml-0\">\n        {/* Quick View switcher on mobile */}\n        <button\n          onClick={() => onNavigate(currentView === \'library\' ? \'dashboard\' : \'library\')}\n          title=\"Switch view\"\n          className=\"text-[#000666] hover:bg-[#eeeeee] transition-colors p-2 rounded-full active:scale-95 cursor-pointer\"\n        >\n          <span className=\"material-symbols-outlined text-[22px]\">\n            {currentView === \'library\' ? \'dashboard\' : \'filter_list\'}\n          </span>\n        </button>\n\n        {/* Notifications */}\n        <div ref={notifRef} className=\"relative\">\n          <button\n            onClick={() => setShowNotifications(!showNotifications)}\n            id=\"btn-notifications\"\n            title=\"Notifications\"\n            className=\"text-[#000666] hover:bg-[#eeeeee] transition-colors p-2 rounded-full active:scale-95 relative cursor-pointer\"\n          >\n            <span className=\"material-symbols-outlined text-[22px]\">notifications</span>\n            {unreadCount > 0 && (\n              <span className=\"absolute top-1.5 right-1.5 w-2.5 h-2.5 bg-[#ba1a1a] rounded-full ring-2 ring-[#f9f9f9]\" />\n            )}\n          </button>\n\n          {/* Notifications Dropdown */}\n          {showNotifications && (\n            <div className=\"absolute right-0 top-full mt-2 w-80 bg-white rounded-xl shadow-xl border border-[#c6c5d4]/40 p-3 z-50\">\n              <div className=\"flex items-center justify-between pb-2 mb-2 border-b border-[#c6c5d4]/30\">\n                <h4 className=\"font-semibold text-sm text-[#1a1c1c]\">Executive Alerts</h4>\n                <button\n                  onClick={() =>\n                    setNotifications(notifications.map((n) => ({ ...n, unread: false })))\n                  }\n                  className=\"text-[11px] text-[#000666] hover:underline font-medium\"\n                >\n                  Mark all as read\n                </button>\n              </div>\n              <div className=\"space-y-2 max-h-60 overflow-y-auto\">\n                {notifications.map((n) => (\n                  <div\n                    key={n.id}\n                    className={`p-2.5 rounded-lg text-xs flex gap-2.5 items-start ${\n                      n.unread ? \'bg-[#e0e0ff]/30 font-medium\' : \'hover:bg-[#f3f3f3]\'\n                    }`}\n                  >\n                    <span className=\"w-2 h-2 rounded-full bg-[#1a237e] mt-1 shrink-0\" />\n                    <div className=\"flex-1\">\n                      <p className=\"text-[#1a1c1c]\">{n.text}</p>\n                      <span className=\"text-[10px] text-[#767683]\">{n.time}</span>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* User Profile */}\n        <div ref={profileRef} className=\"relative\">\n          <button\n            onClick={() => setShowProfileMenu(!showProfileMenu)}\n            id=\"btn-user-profile\"\n            className=\"flex items-center gap-2 p-1 rounded-full hover:ring-2 hover:ring-[#000666]/30 transition-all cursor-pointer\"\n          >\n            <img\n              src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBV2OuN03O8TiLGOHeUBlq6SXBGf8lu4IgMQ-YEwmkRLA3qmC5MXmTjD0hdDmGNIRi5FD7n4Jr4C5hxmvn08IMoW0D5BgnfPJ8yGD3aLGOBngDzkgC9FkjKycbeGTIzQGFyxQtY6_7j_X_OzNasGTKLIi0JyIEGvmudlvb_NOD6DAfqYwpN-un5H22BsxXmiJpZvXo-kS4kUri558jTy3GzN6mE-ugOSrdOsAVDbFg03GQqz06YZ1r2_g\"\n              alt=\"Sarah J.\"\n              className=\"w-8 h-8 rounded-full object-cover border border-[#c6c5d4]\"\n            />\n          </button>\n\n          {showProfileMenu && (\n            <div className=\"absolute right-0 top-full mt-2 w-56 bg-white rounded-xl shadow-xl border border-[#c6c5d4]/40 p-3 z-50\">\n              <div className=\"flex items-center gap-3 pb-3 border-b border-[#c6c5d4]/30\">\n                <img\n                  src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBV2OuN03O8TiLGOHeUBlq6SXBGf8lu4IgMQ-YEwmkRLA3qmC5MXmTjD0hdDmGNIRi5FD7n4Jr4C5hxmvn08IMoW0D5BgnfPJ8yGD3aLGOBngDzkgC9FkjKycbeGTIzQGFyxQtY6_7j_X_OzNasGTKLIi0JyIEGvmudlvb_NOD6DAfqYwpN-un5H22BsxXmiJpZvXo-kS4kUri558jTy3GzN6mE-ugOSrdOsAVDbFg03GQqz06YZ1r2_g\"\n                  alt=\"Sarah J.\"\n                  className=\"w-10 h-10 rounded-full object-cover\"\n                />\n                <div>\n                  <div className=\"font-semibold text-sm text-[#1a1c1c]\">Sarah Jenkins</div>\n                  <div className=\"text-xs text-[#767683]\">VP Operations</div>\n                </div>\n              </div>\n              <div className=\"py-2 space-y-1 text-xs text-[#1a1c1c]\">\n                <button\n                  onClick={() => {\n                    onNavigate(\'settings\');\n                    setShowProfileMenu(false);\n                  }}\n                  className=\"w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-[#f3f3f3] flex items-center gap-2\"\n                >\n                  <span className=\"material-symbols-outlined text-[16px]\">person</span>\n                  Account & Settings\n                </button>\n                <button\n                  onClick={() => {\n                    onNavigate(\'library\');\n                    setShowProfileMenu(false);\n                  }}\n                  className=\"w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-[#f3f3f3] flex items-center gap-2\"\n                >\n                  <span className=\"material-symbols-outlined text-[16px]\">inventory_2</span>\n                  My Minutes Archive\n                </button>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </header>"
        replacement_content: "    <header className=\"bg-white border-b border-slate-200 w-full h-16 shadow-xs flex justify-between items-center px-4 md:px-8 flex-shrink-0 z-30 sticky top-0\">\n      {/* Mobile Branding */}\n      <div className=\"md:hidden flex items-center gap-2\">\n        <div className=\"w-8 h-8 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold text-xs shadow-sm shadow-indigo-100\">\n          MF\n        </div>\n        <span className=\"text-lg font-bold text-slate-900\">MinuteFlow</span>\n      </div>\n\n      {/* Global Search Bar */}\n      <div ref={searchRef} className=\"hidden md:flex flex-1 max-w-xl mx-auto relative\">\n        <span className=\"material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-[20px] pointer-events-none\">\n          search\n        </span>\n        <input\n          id=\"global-search-input\"\n          type=\"text\"\n          value={searchQuery}\n          onChange={(e) => {\n            onSearchChange(e.target.value);\n            setShowSearchDropdown(true);\n          }}\n          onFocus={() => setShowSearchDropdown(true)}\n          placeholder=\"Search meetings, tasks, or decisions...\"\n          className=\"w-full bg-slate-50 hover:bg-slate-100/70 focus:bg-white text-slate-800 placeholder-slate-400 border border-slate-200 focus:border-indigo-500 rounded-xl py-2 pl-10 pr-10 focus:ring-2 focus:ring-indigo-100 font-medium text-sm transition-all outline-none\"\n        />\n        {searchQuery ? (\n          <button\n            onClick={() => onSearchChange(\'\')}\n            className=\"absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs\"\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">close</span>\n          </button>\n        ) : (\n          <button\n            title=\"Filter search\"\n            className=\"absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-indigo-600 transition-colors\"\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">tune</span>\n          </button>\n        )}\n\n        {/* Live Search Results Dropdown */}\n        {showSearchDropdown && searchQuery.trim().length > 0 && (\n          <div className=\"absolute left-0 right-0 top-full mt-2 bg-white rounded-2xl shadow-xl border border-slate-100 p-2 z-50 max-h-80 overflow-y-auto\">\n            <div className=\"text-[11px] font-semibold uppercase tracking-wider text-slate-400 px-3 py-1.5 border-b border-slate-100\">\n              Matching Minutes ({filteredResults.length})\n            </div>\n            {filteredResults.length > 0 ? (\n              filteredResults.map((m) => (\n                <div\n                  key={m.id}\n                  onClick={() => {\n                    onSelectMinute(m);\n                    setShowSearchDropdown(false);\n                  }}\n                  className=\"flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50 cursor-pointer transition-colors\"\n                >\n                  <div className=\"flex items-center gap-3\">\n                    <span className=\"material-symbols-outlined text-indigo-600 text-[20px]\">\n                      description\n                    </span>\n                    <div>\n                      <h4 className=\"text-sm font-semibold text-slate-800\">{m.title}</h4>\n                      <p className=\"text-xs text-slate-500 line-clamp-1\">{m.objectives || m.directory}</p>\n                    </div>\n                  </div>\n                  <span\n                    className={`text-[10px] font-bold px-2.5 py-0.5 rounded-full ${\n                      m.status === \'Approved\'\n                        ? \'bg-emerald-50 text-emerald-700 border border-emerald-200/50\'\n                        : m.status === \'Draft\'\n                        ? \'bg-indigo-50 text-indigo-700 border border-indigo-200/50\'\n                        : \'bg-amber-50 text-amber-700 border border-amber-200/50\'\n                    }`}\n                  >\n                    {m.status}\n                  </span>\n                </div>\n              ))\n            ) : (\n              <div className=\"p-4 text-center text-xs text-slate-400\">\n                No minutes found matching &quot;{searchQuery}&quot;\n              </div>\n            )}\n          </div>\n        )}\n      </div>\n\n      {/* Right Actions */}\n      <div className=\"flex items-center gap-2 md:gap-3 ml-auto md:ml-0\">\n        {/* Quick View switcher on mobile */}\n        <button\n          onClick={() => onNavigate(currentView === \'library\' ? \'dashboard\' : \'library\')}\n          title=\"Switch view\"\n          className=\"text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-colors p-2 rounded-xl active:scale-95 cursor-pointer\"\n        >\n          <span className=\"material-symbols-outlined text-[22px]\">\n            {currentView === \'library\' ? \'dashboard\' : \'filter_list\'}\n          </span>\n        </button>\n\n        {/* Notifications */}\n        <div ref={notifRef} className=\"relative\">\n          <button\n            onClick={() => setShowNotifications(!showNotifications)}\n            id=\"btn-notifications\"\n            title=\"Notifications\"\n            className=\"text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-colors p-2 rounded-xl active:scale-95 relative cursor-pointer\"\n          >\n            <span className=\"material-symbols-outlined text-[22px]\">notifications</span>\n            {unreadCount > 0 && (\n              <span className=\"absolute top-1.5 right-1.5 w-2.5 h-2.5 bg-rose-500 rounded-full ring-2 ring-white\" />\n            )}\n          </button>\n\n          {/* Notifications Dropdown */}\n          {showNotifications && (\n            <div className=\"absolute right-0 top-full mt-2 w-80 bg-white rounded-2xl shadow-xl border border-slate-100 p-3 z-50\">\n              <div className=\"flex items-center justify-between pb-2 mb-2 border-b border-slate-100\">\n                <h4 className=\"font-semibold text-sm text-slate-800\">Executive Alerts</h4>\n                <button\n                  onClick={() =>\n                    setNotifications(notifications.map((n) => ({ ...n, unread: false })))\n                  }\n                  className=\"text-[11px] text-indigo-600 hover:underline font-medium\"\n                >\n                  Mark all as read\n                </button>\n              </div>\n              <div className=\"space-y-2 max-h-60 overflow-y-auto\">\n                {notifications.map((n) => (\n                  <div\n                    key={n.id}\n                    className={`p-2.5 rounded-xl text-xs flex gap-2.5 items-start ${\n                      n.unread ? \'bg-indigo-50/50 font-medium\' : \'hover:bg-slate-50\'\n                    }`}\n                  >\n                    <span className=\"w-2 h-2 rounded-full bg-indigo-600 mt-1 shrink-0\" />\n                    <div className=\"flex-1\">\n                      <p className=\"text-slate-800\">{n.text}</p>\n                      <span className=\"text-[10px] text-slate-400\">{n.time}</span>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n\n        {/* User Profile */}\n        <div ref={profileRef} className=\"relative\">\n          <button\n            onClick={() => setShowProfileMenu(!showProfileMenu)}\n            id=\"btn-user-profile\"\n            className=\"flex items-center gap-2 p-0.5 rounded-full hover:ring-2 hover:ring-indigo-300 transition-all cursor-pointer\"\n          >\n            <img\n              src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBV2OuN03O8TiLGOHeUBlq6SXBGf8lu4IgMQ-YEwmkRLA3qmC5MXmTjD0hdDmGNIRi5FD7n4Jr4C5hxmvn08IMoW0D5BgnfPJ8yGD3aLGOBngDzkgC9FkjKycbeGTIzQGFyxQtY6_7j_X_OzNasGTKLIi0JyIEGvmudlvb_NOD6DAfqYwpN-un5H22BsxXmiJpZvXo-kS4kUri558jTy3GzN6mE-ugOSrdOsAVDbFg03GQqz06YZ1r2_g\"\n              alt=\"Sarah J.\"\n              className=\"w-8 h-8 rounded-full object-cover border border-slate-200\"\n            />\n          </button>\n\n          {showProfileMenu && (\n            <div className=\"absolute right-0 top-full mt-2 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 p-3 z-50\">\n              <div className=\"flex items-center gap-3 pb-3 border-b border-slate-100\">\n                <img\n                  src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuBV2OuN03O8TiLGOHeUBlq6SXBGf8lu4IgMQ-YEwmkRLA3qmC5MXmTjD0hdDmGNIRi5FD7n4Jr4C5hxmvn08IMoW0D5BgnfPJ8yGD3aLGOBngDzkgC9FkjKycbeGTIzQGFyxQtY6_7j_X_OzNasGTKLIi0JyIEGvmudlvb_NOD6DAfqYwpN-un5H22BsxXmiJpZvXo-kS4kUri558jTy3GzN6mE-ugOSrdOsAVDbFg03GQqz06YZ1r2_g\"\n                  alt=\"Sarah J.\"\n                  className=\"w-10 h-10 rounded-full object-cover\"\n                />\n                <div>\n                  <div className=\"font-semibold text-sm text-slate-800\">Sarah Jenkins</div>\n                  <div className=\"text-xs text-slate-500\">VP Operations</div>\n                </div>\n              </div>\n              <div className=\"py-2 space-y-1 text-xs text-slate-700\">\n                <button\n                  onClick={() => {\n                    onNavigate(\'settings\');\n                    setShowProfileMenu(false);\n                  }}\n                  className=\"w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-slate-50 flex items-center gap-2 text-slate-700 hover:text-slate-900 cursor-pointer\"\n                >\n                  <span className=\"material-symbols-outlined text-[16px] text-slate-400\">person</span>\n                  Account & Settings\n                </button>\n                <button\n                  onClick={() => {\n                    onNavigate(\'library\');\n                    setShowProfileMenu(false);\n                  }}\n                  className=\"w-full text-left px-2.5 py-1.5 rounded-lg hover:bg-slate-50 flex items-center gap-2 text-slate-700 hover:text-slate-900 cursor-pointer\"\n                >\n                  <span className=\"material-symbols-outlined text-[16px] text-slate-400\">inventory_2</span>\n                  My Minutes Archive\n                </button>\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </header>"
      }
