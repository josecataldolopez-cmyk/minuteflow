Propagation();\n                              onOpenExport(minute);\n                            }}\n                            className=\"p-1 text-indigo-600 hover:bg-indigo-50 rounded-lg\"\n                            title=\"Exportar\"\n                          >\n                            <span className=\"material-symbols-outlined text-[18px]\">ios_share</span>\n                          </button>\n                        </td>\n                      </tr>\n                    ))}\n                  </tbody>\n                </table>\n              </div>\n            )}\n          </div>\n        </div>"
