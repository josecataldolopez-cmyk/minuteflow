    instruction: "Add due date and priority controls for each action item in MinuteEditorView"
    replacement_infos {
      original_chunk {
        target_content: "                    <div className=\"flex items-center justify-end gap-2 pl-7 sm:pl-0 relative\">\n                      {/* Assignee Picker */}\n                      {action.assignedTo ? (\n                        <div className=\"relative\">\n                          <button\n                            type=\"button\"\n                            onClick={() =>\n                              setAssigningActionId(\n                                assigningActionId === action.id ? null : action.id\n                              )\n                            }\n                            className=\"bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200/60 px-2.5 py-1 rounded-full text-[11px] font-semibold flex items-center gap-1.5 transition-colors cursor-pointer\"\n                          >\n                            <img\n                              src={action.assignedTo.avatarUrl}\n                              alt={action.assignedTo.name}\n                              className=\"w-4 h-4 rounded-full object-cover\"\n                            />\n                            <span>{action.assignedTo.name}</span>\n                            <span className=\"material-symbols-outlined text-[12px] text-emerald-600\">\n                              expand_more\n                            </span>\n                          </button>\n                        </div>\n                      ) : (\n                        <button\n                          type=\"button\"\n                          onClick={() =>\n                            setAssigningActionId(\n                              assigningActionId === action.id ? null : action.id\n                            )\n                          }\n                          className=\"text-slate-600 text-[11px] font-medium hover:text-indigo-600 flex items-center gap-1 bg-slate-100 px-2.5 py-1 rounded-full hover:bg-indigo-50 transition-colors cursor-pointer\"\n                        >\n                          <span className=\"material-symbols-outlined text-[14px]\">person_add</span>\n                          <span>Asignar</span>\n                        </button>\n                      )}"
        replacement_content: "                    <div className=\"flex flex-wrap items-center justify-end gap-2 pl-7 sm:pl-0 relative\">\n                      {/* Due Date Picker */}\n                      <div className=\"flex items-center gap-1 bg-slate-100 px-2 py-1 rounded-full text-[11px] text-slate-600 border border-slate-200/50\">\n                        <span className=\"material-symbols-outlined text-[13px] text-slate-400\">event</span>\n                        <input\n                          type=\"date\"\n                          value={action.dueDate || date}\n                          onChange={(e) => handleUpdateActionItemDueDate(action.id, e.target.value)}\n                          className=\"bg-transparent text-[11px] text-slate-700 font-medium border-none p-0 outline-none cursor-pointer\"\n                        />\n                      </div>\n\n                      {/* Priority Dropdown */}\n                      <select\n                        value={action.priority || \'Medium\'}\n                        onChange={(e) =>\n                          handleUpdateActionItemPriority(\n                            action.id,\n                            e.target.value as \'Low\' | \'Medium\' | \'High\'\n                          )\n                        }\n                        className={`text-[11px] font-semibold px-2 py-1 rounded-full border outline-none cursor-pointer ${\n                          action.priority === \'High\'\n                            ? \'bg-rose-50 text-rose-700 border-rose-200\'\n                            : action.priority === \'Low\'\n                            ? \'bg-slate-100 text-slate-600 border-slate-200\'\n                            : \'bg-amber-50 text-amber-700 border-amber-200\'\n                        }`}\n                      >\n                        <option value=\"High\">Alta</option>\n                        <option value=\"Medium\">Media</option>\n                        <option value=\"Low\">Baja</option>\n                      </select>\n\n                      {/* Assignee Picker */}\n                      {action.assignedTo ? (\n                        <div className=\"relative\">\n                          <button\n                            type=\"button\"\n                            onClick={() =>\n                              setAssigningActionId(\n                                assigningActionId === action.id ? null : action.id\n                              )\n                            }\n                            className=\"bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200/60 px-2.5 py-1 rounded-full text-[11px] font-semibold flex items-center gap-1.5 transition-colors cursor-pointer\"\n                          >\n                            <img\n                              src={action.assignedTo.avatarUrl}\n                              alt={action.assignedTo.name}\n                              className=\"w-4 h-4 rounded-full object-cover\"\n                            />\n                            <span className=\"truncate max-w-[80px]\">{action.assignedTo.name}</span>\n                            <span className=\"material-symbols-outlined text-[12px] text-emerald-600\">\n                              expand_more\n                            </span>\n                          </button>\n                        </div>\n                      ) : (\n                        <button\n                          type=\"button\"\n                          onClick={() =>\n                            setAssigningActionId(\n                              assigningActionId === action.id ? null : action.id\n                            )\n                          }\n                          className=\"text-slate-600 text-[11px] font-medium hover:text-indigo-600 flex items-center gap-1 bg-slate-100 px-2.5 py-1 rounded-full hover:bg-indigo-50 transition-colors cursor-pointer\"\n                        >\n                          <span className=\"material-symbols-outlined text-[14px]\">person_add</span>\n                          <span>Asignar</span>\n                        </button>\n                      )}"
