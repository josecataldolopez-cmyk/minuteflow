    instruction: "Upgrade ContactPickerModal to support searching preloaded attendees, adding custom attendees with avatars/roles, and managing directory contacts"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { Attendee } from \'../types\';\nimport { INITIAL_ATTENDEES } from \'../data/mockData\';\n\ninterface ContactPickerModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  currentAttendees: Attendee[];\n  onAddAttendee: (attendee: Attendee) => void;\n}\n\nexport const ContactPickerModal: React.FC<ContactPickerModalProps> = ({\n  isOpen,\n  onClose,\n  currentAttendees,\n  onAddAttendee\n}) => {\n  const [search, setSearch] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  const filtered = INITIAL_ATTENDEES.filter(\n    (c) =>\n      c.name.toLowerCase().includes(search.toLowerCase()) ||\n      c.email.toLowerCase().includes(search.toLowerCase()) ||\n      (c.role && c.role.toLowerCase().includes(search.toLowerCase()))\n  );\n\n  return (\n    <div className=\"fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n      <div className=\"bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100 animate-in fade-in\">\n        <div className=\"flex justify-between items-center pb-3 border-b border-slate-100\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"material-symbols-outlined text-indigo-600\">contacts</span>\n            <h3 className=\"font-bold text-base text-slate-900\">Seleccionar Asistentes</h3>\n          </div>\n          <button onClick={onClose} className=\"text-slate-400 hover:text-slate-700 p-1 cursor-pointer\">\n            <span className=\"material-symbols-outlined text-[20px]\">close</span>\n          </button>\n        </div>\n\n        <div className=\"my-4\">\n          <input\n            type=\"text\"\n            value={search}\n            onChange={(e) => setSearch(e.target.value)}\n            placeholder=\"Buscar por nombre, cargo o correo...\"\n            className=\"w-full text-xs px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500\"\n            autoFocus\n          />\n        </div>\n\n        <div className=\"space-y-2 max-h-64 overflow-y-auto custom-scrollbar pr-1\">\n          {filtered.map((contact) => {\n            const isAlreadyAdded = currentAttendees.some((a) => a.id === contact.id);\n            return (\n              <div\n                key={contact.id}\n                onClick={() => {\n                  if (!isAlreadyAdded) {\n                    onAddAttendee(contact);\n                    onClose();\n                  }\n                }}\n                className={`flex items-center justify-between p-2.5 rounded-xl transition-colors ${\n                  isAlreadyAdded\n                    ? \'bg-slate-100/70 opacity-60 cursor-not-allowed\'\n                    : \'hover:bg-slate-50 cursor-pointer border border-transparent hover:border-slate-200\'\n                }`}\n              >\n                <div className=\"flex items-center gap-3\">\n                  <img\n                    src={contact.avatarUrl}\n                    alt={contact.name}\n                    className=\"w-9 h-9 rounded-full object-cover border border-slate-200\"\n                  />\n                  <div>\n                    <h4 className=\"text-xs font-bold text-slate-900\">{contact.name}</h4>\n                    <p className=\"text-[11px] text-slate-500\">{contact.role} \342\200\242 {contact.email}</p>\n                  </div>\n                </div>\n\n                <span\n                  className={`text-xs px-2.5 py-1 rounded-full font-semibold ${\n                    isAlreadyAdded\n                      ? \'text-slate-500 bg-slate-100\'\n                      : \'text-indigo-600 bg-indigo-50 hover:bg-indigo-100\'\n                  }`}\n                >\n                  {isAlreadyAdded ? \'Agregado\' : \'+ Agregar\'}\n                </span>\n              </div>\n            );\n          })}\n        </div>\n\n        <div className=\"mt-4 pt-3 border-t border-slate-100 text-right\">\n          <button\n            onClick={onClose}\n            className=\"text-xs text-slate-600 hover:text-slate-900 font-semibold px-4 py-2 hover:bg-slate-100 rounded-xl cursor-pointer\"\n          >\n            Listo\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};"
        replacement_content: "import React, { useState } from \'react\';\nimport { Attendee } from \'../types\';\nimport { AVATAR_PRESETS } from \'../data/mockData\';\n\ninterface ContactPickerModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  currentAttendees: Attendee[];\n  allContacts: Attendee[];\n  onToggleAttendee: (attendee: Attendee) => void;\n  onCreateContact: (newContact: Attendee) => void;\n  onDeleteContact?: (id: string) => void;\n}\n\nexport const ContactPickerModal: React.FC<ContactPickerModalProps> = ({\n  isOpen,\n  onClose,\n  currentAttendees,\n  allContacts,\n  onToggleAttendee,\n  onCreateContact,\n  onDeleteContact\n}) => {\n  const [activeTab, setActiveTab] = useState<\'directory\' | \'create\'>(\'directory\');\n  const [search, setSearch] = useState(\'\');\n\n  // New Contact Form State\n  const [newName, setNewName] = useState(\'\');\n  const [newRole, setNewRole] = useState(\'\');\n  const [newEmail, setNewEmail] = useState(\'\');\n  const [selectedAvatar, setSelectedAvatar] = useState(AVATAR_PRESETS[0]);\n  const [customAvatarUrl, setCustomAvatarUrl] = useState(\'\');\n  const [formError, setFormError] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  const filtered = allContacts.filter(\n    (c) =>\n      c.name.toLowerCase().includes(search.toLowerCase()) ||\n      c.email.toLowerCase().includes(search.toLowerCase()) ||\n      (c.role && c.role.toLowerCase().includes(search.toLowerCase()))\n  );\n\n  const handleCreateSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newName.trim()) {\n      setFormError(\'Por favor ingresa el nombre completo del asistente.\');\n      return;\n    }\n\n    const email = newEmail.trim()\n      ? newEmail.trim()\n      : `${newName.toLowerCase().replace(/\\s+/g, \'.\')}@empresa.com`;\n\n    const avatar = customAvatarUrl.trim() || selectedAvatar;\n\n    const newContact: Attendee = {\n      id: `att-custom-${Date.now()}`,\n      name: newName.trim(),\n      role: newRole.trim() || \'Asistente / Invitado\',\n      email,\n      avatarUrl: avatar\n    };\n\n    onCreateContact(newContact);\n    // Also toggle/add them into the current meeting\n    onToggleAttendee(newContact);\n\n    // Reset Form\n    setNewName(\'\');\n    setNewRole(\'\');\n    setNewEmail(\'\');\n    setCustomAvatarUrl(\'\');\n    setFormError(\'\');\n    setActiveTab(\'directory\');\n  };\n\n  return (\n    <div className=\"fixed inset-0 bg-slate-900/50 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n      <div className=\"bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 animate-in fade-in flex flex-col max-h-[90vh]\">\n        {/* Header */}\n        <div className=\"flex justify-between items-center pb-3 border-b border-slate-100\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600\">\n              <span className=\"material-symbols-outlined text-[20px]\">groups</span>\n            </div>\n            <div>\n              <h3 className=\"font-bold text-base text-slate-900\">Gesti\303\263n de Asistentes</h3>\n              <p className=\"text-xs text-slate-500\">\n                Selecciona del listado o agrega nuevos miembros externos\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"text-slate-400 hover:text-slate-700 p-1.5 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer\"\n          >\n            <span className=\"material-symbols-outlined text-[20px]\">close</span>\n          </button>\n        </div>\n\n        {/* Tab Switcher */}\n        <div className=\"flex border-b border-slate-200 mt-4\">\n          <button\n            onClick={() => setActiveTab(\'directory\')}\n            className={`flex-1 py-2.5 text-xs font-bold border-b-2 flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\n              activeTab === \'directory\'\n                ? \'border-indigo-600 text-indigo-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-900\'\n            }`}\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">contacts</span>\n            <span>Directorio ({allContacts.length})</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'create\')}\n            className={`flex-1 py-2.5 text-xs font-bold border-b-2 flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\n              activeTab === \'create\'\n                ? \'border-indigo-600 text-indigo-600\'\n                : \'border-transparent text-slate-500 hover:text-slate-900\'\n            }`}\n          >\n            <span className=\"material-symbols-outlined text-[18px]\">person_add</span>\n            <span>+ Crear Nuevo Asistente</span>\n          </button>\n        </div>\n\n        {/* Tab 1: Directory List */}\n        {activeTab === \'directory\' && (\n          <div className=\"flex flex-col flex-1 min-h-0 pt-4\">\n            <div className=\"mb-3 relative\">\n              <span className=\"material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]\">\n                search\n              </span>\n              <input\n                type=\"text\"\n                value={search}\n                onChange={(e) => setSearch(e.target.value)}\n                placeholder=\"Buscar por nombre, cargo o correo...\"\n                className=\"w-full text-xs pl-9 pr-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500 transition-all\"\n                autoFocus\n              />\n            </div>\n\n            <div className=\"space-y-2 flex-1 overflow-y-auto custom-scrollbar pr-1 min-h-[220px]\">\n              {filtered.map((contact) => {\n                const isSelected = currentAttendees.some((a) => a.id === contact.id);\n                const isCustom = contact.id.startsWith(\'att-custom-\');\n\n                return (\n                  <div\n                    key={contact.id}\n                    onClick={() => onToggleAttendee(contact)}\n                    className={`flex items-center justify-between p-3 rounded-xl transition-all cursor-pointer border ${\n                      isSelected\n                        ? \'bg-indigo-50/60 border-indigo-200 shadow-xs\'\n                        : \'bg-white hover:bg-slate-50 border-slate-100\'\n                    }`}\n                  >\n                    <div className=\"flex items-center gap-3 min-w-0\">\n                      <img\n                        src={contact.avatarUrl}\n                        alt={contact.name}\n                        className=\"w-10 h-10 rounded-full object-cover border border-slate-200 shrink-0\"\n                      />\n                      <div className=\"min-w-0\">\n                        <div className=\"flex items-center gap-1.5\">\n                          <h4 className=\"text-xs font-bold text-slate-900 truncate\">\n                            {contact.name}\n                          </h4>\n                          {isCustom && (\n                            <span className=\"text-[9px] bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded font-medium\">\n                              Personalizado\n                            </span>\n                          )}\n                        </div>\n                        <p className=\"text-[11px] text-slate-500 truncate\">\n                          {contact.role || \'Asistente\'} \342\200\242 {contact.email}\n                        </p>\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center gap-2 shrink-0\">\n                      <span\n                        className={`text-xs px-3 py-1 rounded-full font-semibold flex items-center gap-1 transition-all ${\n                          isSelected\n                            ? \'bg-indigo-600 text-white shadow-xs\'\n                            : \'text-indigo-600 bg-indigo-50 hover:bg-indigo-100\'\n                        }`}\n                      >\n                        <span className=\"material-symbols-outlined text-[14px]\">\n                          {isSelected ? \'check\' : \'add\'}\n                        </span>\n                        {isSelected ? \'Incluido\' : \'Agregar\'}\n                      </span>\n\n                      {isCustom && onDeleteContact && (\n                        <button\n                          type=\"button\"\n                          onClick={(e) => {\n                            e.stopPropagation();\n                            onDeleteContact(contact.id);\n                          }}\n                          className=\"text-slate-300 hover:text-rose-600 p-1 rounded transition-colors\"\n                          title=\"Eliminar asistente del directorio\"\n                        >\n                          <span className=\"material-symbols-outlined text-[16px]\">delete</span>\n                        </button>\n                      )}\n                    </div>\n                  </div>\n                );\n              })}\n\n              {filtered.length === 0 && (\n                <div className=\"text-center py-8 bg-slate-50 rounded-2xl border border-dashed border-slate-200\">\n                  <span className=\"material-symbols-outlined text-slate-300 text-4xl mb-1\">\n                    person_search\n                  </span>\n                  <p className=\"text-xs text-slate-600 font-semibold\">\n                    No se encontr\303\263 a nadie con &quot;{search}&quot;\n                  </p>\n                  <button\n                    onClick={() => {\n                      setNewName(search);\n                      setActiveTab(\'create\');\n                    }}\n                    className=\"mt-3 text-xs bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-xl transition-all shadow-sm\"\n                  >\n                    + Registrar &quot;{search}&quot; como nuevo asistente\n                  </button>\n                </div>\n              )}\n            </div>\n\n            <div className=\"mt-4 pt-3 border-t border-slate-100 flex items-center justify-between\">\n              <span className=\"text-xs text-slate-500 font-medium\">\n                {currentAttendees.length} asistente(s) seleccionado(s)\n              </span>\n              <button\n                onClick={onClose}\n                className=\"text-xs bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-5 py-2 rounded-xl shadow-md shadow-indigo-100 transition-all cursor-pointer\"\n              >\n                Listo\n              </button>\n            </div>\n          </div>\n        )}\n\n        {/* Tab 2: Create Custom Attendee Form */}\n        {activeTab === \'create\' && (\n          <form onSubmit={handleCreateSubmit} className=\"flex flex-col flex-1 min-h-0 pt-4\">\n            <div className=\"space-y-3.5 flex-1 overflow-y-auto custom-scrollbar pr-1\">\n              {formError && (\n                <div className=\"p-2.5 bg-rose-50 border border-rose-200 text-rose-700 text-xs rounded-xl flex items-center gap-2\">\n                  <span className=\"material-symbols-outlined text-[16px]\">error</span>\n                  <span>{formError}</span>\n                </div>\n              )}\n\n              <div>\n                <label className=\"text-xs font-semibold text-slate-700 block mb-1\">\n                  Nombre Completo <span className=\"text-rose-500\">*</span>\n                </label>\n                <input\n                  type=\"text\"\n                  value={newName}\n                  onChange={(e) => {\n                    setNewName(e.target.value);\n                    if (formError) setFormError(\'\');\n                  }}\n                  placeholder=\"ej. Lic. Carlos Mendoza o Ing. Sof\303\255a Reyes\"\n                  className=\"w-full text-xs px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500 transition-all\"\n                  autoFocus\n                />\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 block mb-1\">\n                    Cargo / Rol en la Reuni\303\263n\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={newRole}\n                    onChange={(e) => setNewRole(e.target.value)}\n                    placeholder=\"ej. Asesor Legal Externo, Gerente TI\"\n                    className=\"w-full text-xs px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500 transition-all\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 block mb-1\">\n                    Correo Electr\303\263nico\n                  </label>\n                  <input\n                    type=\"email\"\n                    value={newEmail}\n                    onChange={(e) => setNewEmail(e.target.value)}\n                    placeholder=\"carlos.m@empresa.com\"\n                    className=\"w-full text-xs px-3.5 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white outline-none focus:ring-2 focus:ring-indigo-100 focus:border-indigo-500 transition-all\"\n                  />\n                </div>\n              </div>\n\n              {/* Avatar Selector */}\n              <div>\n                <label className=\"text-xs font-semibold text-slate-700 block mb-1.5\">\n                  Foto de Perfil / Avatar\n                </label>\n                <div className=\"flex items-center gap-2 mb-2 overflow-x-auto pb-1\">\n                  {AVATAR_PRESETS.map((preset, idx) => (\n                    <button\n                      key={idx}\n                      type=\"button\"\n                      onClick={() => {\n                        setSelectedAvatar(preset);\n                        setCustomAvatarUrl(\'\');\n                      }}\n                      className={`relative rounded-full p-0.5 transition-all cursor-pointer shrink-0 ${\n                        selectedAvatar === preset && !customAvatarUrl\n                          ? \'ring-2 ring-indigo-600 scale-105\'\n                          : \'opacity-70 hover:opacity-100\'\n                      }`}\n                    >\n                      <img\n                        src={preset}\n                        alt=\"Avatar preset\"\n                        className=\"w-9 h-9 rounded-full object-cover border border-slate-200\"\n                      />\n                    </button>\n                  ))}\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <input\n                    type=\"text\"\n                    value={customAvatarUrl}\n                    onChange={(e) => setCustomAvatarUrl(e.target.value)}\n                    placeholder=\"O pega una URL de imagen personalizada (opcional)...\"\n                    className=\"flex-1 text-[11px] px-3 py-1.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white outline-none focus:ring-1 focus:ring-indigo-500\"\n                  />\n                </div>\n              </div>\n            </div>\n\n            <div className=\"mt-4 pt-3 border-t border-slate-100 flex items-center justify-between\">\n              <button\n                type=\"button\"\n                onClick={() => setActiveTab(\'directory\')}\n                className=\"text-xs text-slate-600 hover:text-slate-900 font-semibold px-4 py-2 hover:bg-slate-100 rounded-xl cursor-pointer\"\n              >\n                Volver al Directorio\n              </button>\n              <button\n                type=\"submit\"\n                className=\"text-xs bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-5 py-2 rounded-xl shadow-md shadow-indigo-100 transition-all flex items-center gap-1.5 cursor-pointer\"\n              >\n                <span className=\"material-symbols-outlined text-[16px]\">check</span>\n                <span>Guardar e Incluir en el Acta</span>\n              </button>\n            </div>\n          </form>\n        )}\n      </div>\n    </div>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
