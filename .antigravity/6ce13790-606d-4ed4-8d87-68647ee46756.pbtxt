    priority: \'Medium\',\n    assignedTo: INITIAL_ATTENDEES[0]\n  },\n  {\n    id: \'act-3\',\n    text: \'Prepare financial models for AlphaCorp merger\',\n    completed: false,\n    dueDate: \'2026-09-05\',\n    dueLabel: \'High\',\n    priority: \'High\',\n    assignedTo: INITIAL_ATTENDEES[3]\n  },\n  {\n    id: \'act-4\',\n    text: \'Draft NDA for AlphaCorp negotiations\',\n    completed: true,\n    dueDate: \'2026-08-28\',\n    dueLabel: \'Completed\',\n    priority: \'High\',\n    assignedTo: INITIAL_ATTENDEES[5]\n  }\n];\n\nexport const INITIAL_DIRECTORIES: DirectoryItem[] = [\n  { id: \'dir-1\', name: \'Q3 Board Meetings\', count: 12, icon: \'folder\' },\n  { id: \'dir-2\', name: \'Client Alpha Mergers\', count: 8, icon: \'folder\' },\n  { id: \'dir-3\', name: \'Department HR\', count: 24, icon: \'folder_open\' },\n  { id: \'dir-4\', name: \'Annual Reviews 2023\', count: 5, icon: \'folder\' }\n];\n\nexport const INITIAL_MINUTES: MeetingMinute[] = [\n  {\n    id: \'min-1\',\n    title: \'Weekly Marketing Sync\',\n    directory: \'Client Alpha Mergers\',\n    date: \'2026-08-29\',\n    formattedDate: \'Yesterday\',\n    time: \'11:00 AM\',\n    status: \'Approved\',\n    location: \'Conference Room B / Google Meet\',\n    objectives: \'Finalize branding color palettes and campaign timeline for Fall 2026.\',\n    pointsTreated: `\342\200\242 Reviewed market survey results across tier-1 regions.\n\342\200\242 Approved the final color palette and typography hierarchy for the Fall 2026 campaign.\n\342\200\242 Creative department will deliver prototype video reels by next Thursday.\n\342\200\242 Social media schedule synchronized across LinkedIn, X, and Instagram.`,\n    keyDecisions: [\n      \'Approved final autumn color palette and brand book revisions.\',\n      \'Allocated $45,000 for targeted social advertising campaigns.\'\n    ],\n    actionItems: [\n      {\n        id: \'act-m1-1\',\n        text: \'Distribute updated brand guidelines to agency partners