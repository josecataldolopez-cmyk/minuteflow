    instruction: "Connect userProfile into DashboardView for personalized greeting"
    replacement_infos {
      original_chunk {
        target_content: "import React, { useState } from \'react\';\nimport { MeetingMinute, ScheduleItem, ActionItem, ViewMode } from \'../types\';\n\ninterface DashboardViewProps {\n  schedule: ScheduleItem[];\n  actionItems: ActionItem[];\n  recentMinutes: MeetingMinute[];\n  onToggleActionItem: (id: string) => void;\n  onAddActionItem: (text: string) => void;\n  onSelectMinute: (minute: MeetingMinute) => void;\n  onOpenExport: (minute: MeetingMinute) => void;\n  onNewMinute: () => void;\n  onNavigate: (view: ViewMode) => void;\n}\n\nexport const DashboardView: React.FC<DashboardViewProps> = ({\n  schedule,\n  actionItems,\n  recentMinutes,\n  onToggleActionItem,\n  onAddActionItem,\n  onSelectMinute,\n  onOpenExport,\n  onNewMinute,\n  onNavigate\n}) => {\n  const [newActionText, setNewActionText] = useState(\'\');\n  const [isAddingAction, setIsAddingAction] = useState(false);\n  const [calendarModalOpen, setCalendarModalOpen] = useState(false);\n\n  const handleActionSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (newActionText.trim()) {\n      onAddActionItem(newActionText.trim());\n      setNewActionText(\'\');\n      setIsAddingAction(false);\n    }\n  };\n\n  return (\n    <div className=\"flex-1 overflow-y-auto p-4 md:p-8 bg-slate-50 custom-scrollbar\">\n      <div className=\"max-w-7xl mx-auto pb-24\">\n        {/* Welcome Briefing Header */}\n        <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4\">\n          <div>\n            <h2 className=\"text-2xl md:text-3xl font-bold text-slate-900 tracking-tight\">\n              Bienvenida de nuevo, Sarah\n            </h2>\n            <p className=\"text-sm text-slate-500 mt-1\">Este es tu resumen ejecutivo para hoy.</p>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={() => onNavigate(\'library\')}\n              className=\"text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 px-3.5 py-2 rounded-xl transition-all shadow-xs flex items-center gap-1.5 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[18px] text-slate-500\">inventory_2</span>\n              <span>Todas las Actas ({recentMinutes.length})</span>\n            </button>\n            <button\n              onClick={onNewMinute}\n              className=\"text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 px-3.5 py-2 rounded-xl transition-all shadow-md shadow-indigo-100 flex items-center gap-1.5 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">add</span>\n              <span>Crear Acta</span>\n            </button>\n          </div>\n        </div>"
        replacement_content: "import React, { useState } from \'react\';\nimport { MeetingMinute, ScheduleItem, ActionItem, ViewMode, UserProfile } from \'../types\';\n\ninterface DashboardViewProps {\n  schedule: ScheduleItem[];\n  actionItems: ActionItem[];\n  recentMinutes: MeetingMinute[];\n  onToggleActionItem: (id: string) => void;\n  onAddActionItem: (text: string) => void;\n  onSelectMinute: (minute: MeetingMinute) => void;\n  onOpenExport: (minute: MeetingMinute) => void;\n  onNewMinute: () => void;\n  onNavigate: (view: ViewMode) => void;\n  userProfile: UserProfile;\n}\n\nexport const DashboardView: React.FC<DashboardViewProps> = ({\n  schedule,\n  actionItems,\n  recentMinutes,\n  onToggleActionItem,\n  onAddActionItem,\n  onSelectMinute,\n  onOpenExport,\n  onNewMinute,\n  onNavigate,\n  userProfile\n}) => {\n  const [newActionText, setNewActionText] = useState(\'\');\n  const [isAddingAction, setIsAddingAction] = useState(false);\n  const [calendarModalOpen, setCalendarModalOpen] = useState(false);\n\n  const handleActionSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (newActionText.trim()) {\n      onAddActionItem(newActionText.trim());\n      setNewActionText(\'\');\n      setIsAddingAction(false);\n    }\n  };\n\n  const firstName = userProfile.name.split(\' \')[0] || userProfile.name;\n\n  return (\n    <div className=\"flex-1 overflow-y-auto p-4 md:p-8 bg-slate-50 custom-scrollbar\">\n      <div className=\"max-w-7xl mx-auto pb-24\">\n        {/* Welcome Briefing Header */}\n        <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4\">\n          <div>\n            <h2 className=\"text-2xl md:text-3xl font-bold text-slate-900 tracking-tight flex items-center gap-2\">\n              <span>Bienvenida/o de nuevo, {firstName}</span>\n            </h2>\n            <p className=\"text-sm text-slate-500 mt-1\">\n              {userProfile.role} \342\200\242 {userProfile.department || \'Direcci\303\263n General\'} \342\200\224 Este es tu resumen ejecutivo para hoy.\n            </p>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={() => onNavigate(\'library\')}\n              className=\"text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 px-3.5 py-2 rounded-xl transition-all shadow-xs flex items-center gap-1.5 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[18px] text-slate-500\">inventory_2</span>\n              <span>Todas las Actas ({recentMinutes.length})</span>\n            </button>\n            <button\n              onClick={onNewMinute}\n              className=\"text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 px-3.5 py-2 rounded-xl transition-all shadow-md shadow-indigo-100 flex items-center gap-1.5 cursor-pointer\"\n            >\n              <span className=\"material-symbols-outlined text-[18px]\">add</span>\n              <span>Crear Acta</span>\n            </button>\n          </div>\n        </div>"
      }
      num_matches: 1
    }
  }
}
