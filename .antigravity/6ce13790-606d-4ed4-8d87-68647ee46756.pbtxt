    replacement_chunks {
      replacement_content: "import { useState, useEffect } from \'react\';\nimport { Sidebar } from \'./components/Sidebar\';\nimport { TopAppBar } from \'./components/TopAppBar\';\nimport { DashboardView } from \'./components/DashboardView\';\nimport { LibraryView } from \'./components/LibraryView\';\nimport { MinuteEditorView } from \'./components/MinuteEditorView\';\nimport { ExportShareModal } from \'./components/ExportShareModal\';\nimport { ContactPickerModal } from \'./components/ContactPickerModal\';\nimport { SettingsView } from \'./components/SettingsView\';\nimport { Toast } from \'./components/Toast\';\nimport {\n  MeetingMinute,\n  ViewMode,\n  ActionItem,\n  Attendee\n} from \'./types\';\nimport {\n  INITIAL_MINUTES,\n  INITIAL_ACTION_ITEMS,\n  INITIAL_SCHEDULE,\n  INITIAL_DIRECTORIES,\n  INITIAL_ATTENDEES\n} from \'./data/mockData\';\n\nexport default function App() {\n  // Navigation State\n  const [currentView, setCurrentView] = useState<ViewMode>(\'dashboard\');\n\n  // Core Data with Local Storage fallback\n  const [minutes, setMinutes] = useState<MeetingMinute[]>(() => {\n    const saved = localStorage.getItem(\'minuteflow_minutes\');\n    return saved ? JSON.parse(saved) : INITIAL_MINUTES;\n  });\n\n  const [actionItems, setActionItems] = useState<ActionItem[]>(() => {\n    const saved = localStorage.getItem(\'minuteflow_action_items\');\n    return saved ? JSON.parse(saved) : INITIAL_ACTION_ITEMS;\n  });\n\n  const [schedule] = useState(INITIAL_SCHEDULE);\n  const [directories] = useState(INITIAL_DIRECTORIES);\n  const [allAttendees, setAllAttendees] = useState<Attendee[]>(INITIAL_ATTENDEES);\n\n  // Active Editor and Modal States\n  const [activeMinute, setActiveMinute] = useState<MeetingMinute | null>(null);\n  const [exportModalOpen, setExportModalOpen] = useState(false);\n  const [exportTargetMinute, setExportTargetMinute] = useState<MeetingMinute | null>(null);\n  const [contactPickerOpen, setContactPickerOpen] = useState(false);\n\n  // Search & Status\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [isSyncing, setIsSyncing] = useState(false);\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  // Persist data on change\n  useEffect(() => {\n    localStorage.setItem(\'minuteflow_minutes\', JSON.stringify(minutes));\n  }, [minutes]);\n\n  useEffect(() => {\n    localStorage.setItem(\'minuteflow_action_items\', JSON.stringify(actionItems));\n  }, [actionItems]);\n\n  const showToast = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => {\n      setToastMessage((prev) => (prev === msg ? null : prev));\n    }, 3500);\n  };\n\n  // Actions\n  const handleNewMinute = () => {\n    setActiveMinute(null);\n    setCurrentView(\'editor\');\n  };\n\n  const handleSelectMinute = (min: MeetingMinute) => {\n    setActiveMinute(min);\n    setCurrentView(\'editor\');\n  };\n\n  const handleOpenExport = (min: MeetingMinute) => {\n    setExportTargetMinute(min);\n    setExportModalOpen(true);\n  };\n\n  const handleSaveMinute = (savedMinute: MeetingMinute, isDraft: boolean) => {\n    setMinutes((prev) => {\n      const exists = prev.some((m) => m.id === savedMinute.id);\n      if (exists) {\n        return prev.map((m) => (m.id === savedMinute.id ? savedMinute : m));\n      } else {\n        return [savedMinute, ...prev];\n      }\n    });\n\n    // Also update global action items if any new ones were added\n    if (savedMinute.actionItems && savedMinute.actionItems.length > 0) {\n      setActionItems((prev) => {\n        const newActions = [...prev];\n        savedMinute.actionItems.forEach((newItem) => {\n          const idx = newActions.findIndex((a) => a.id === newItem.id);\n          if (idx >= 0) {\n            newActions[idx] = newItem;\n          } else {\n            newActions.unshift(newItem);\n          }\n        });\n        return newActions;\n      });\n    }\n\n    showToast(isDraft ? \'Draft saved successfully\' : \'Minute published and synced\');\n    setActiveMinute(savedMinute);\n    setCurrentView(\'library\');\n  };\n\n  const handleDeleteMinute = (id: string) => {\n    setMinutes((prev) => prev.filter((m) => m.id !== id));\n    showToast(\'Meeting minute deleted\');\n  };\n\n  const handleDuplicateMinute = (min: MeetingMinute) => {\n    const duplicated: MeetingMinute = {\n      ...min,\n      id: `min-${Date.now()}`,\n      title: `${min.title} (Copy)`,\n      status: \'Draft\',\n      formattedDate: \'Today\'\n    };\n    setMinutes((prev) => [duplicated, ...prev]);\n    showToast(\'Minute duplicated to Drafts\');\n  };\n\n  const handleToggleActionItem = (id: string) => {\n    setActionItems((prev) =>\n      prev.map((item) => (item.id === id ? { ...item, completed: !item.completed } : item))\n    );\n  };\n\n  const handleAddActionItem = (text: string) => {\n    const newItem: ActionItem = {\n      id: `act-${Date.now()}`,\n      text,\n      completed: false,\n      dueLabel: \'Due Today\',\n      dueDate: new Date().toISOString().split(\'T\')[0]\n    };\n    setActionItems((prev) => [newItem, ...prev]);\n    showToast(\'Action item added\');\n  };\n\n  const handleTriggerSync = () => {\n    setIsSyncing(true);\n    setTimeout(() => {\n      setIsSyncing(false);\n      showToast(\'Cloud Sync completed: 7 folders up to date\');\n    }, 1200);\n  };\n\n  const handleExportSuccess = (channel: string) => {\n    const channelNames: Record<string, string> = {\n      drive: \'Google Drive (PDF & GDoc generated)\',\n      whatsapp: \'WhatsApp (Executive Summary distributed)\',\n      email: \'Corporate Email (PDF attachment sent)\'\n    };\n    showToast(`Successfully exported to ${channelNames[channel] || channel}`);\n  };\n\n  const handleAddContact = (newContact: Attendee) => {\n    if (!allAttendees.some((a) => a.id === newContact.id)) {\n      setAllAttendees([...allAttendees, newContact]);\n    }\n  };\n\n  return (\n    <div className=\"flex h-screen w-screen overflow-hidden bg-[#f9f9f9] text-[#1a1c1c] font-sans antialiased\">\n      {/* Desktop Side Navigation Bar */}\n      <Sidebar\n        currentView={currentView}\n        onNavigate={(v) => setCurrentView(v)}\n        onNewMinute={handleNewMinute}\n        isSyncing={isSyncing}\n        onTriggerSync={handleTriggerSync}\n      />\n\n      {/* Main Content Area */}\n      <div className=\"flex-1 flex flex-col h-screen overflow-hidden relative\">\n        {/* Top App Bar */}\n        <TopAppBar\n          searchQuery={searchQuery}\n          onSearchChange={setSearchQuery}\n          minutes={minutes}\n          onSelectMinute={handleSelectMinute}\n          currentView={currentView}\n          onNavigate={(v) => setCurrentView(v)}\n        />\n\n        {/* Dynamic Views */}\n        {currentView === \'dashboard\' && (\n          <DashboardView\n            schedule={schedule}\n            actionItems={actionItems}\n            recentMinutes={minutes}\n            onToggleActionItem={handleToggleActionItem}\n            onAddActionItem={handleAddActionItem}\n            onSelectMinute={handleSelectMinute}\n            onOpenExport={handleOpenExport}\n            onNewMinute={handleNewMinute}\n            onNavigate={(v) => setCurrentView(v)}\n          />\n        )}\n\n        {currentView === \'library\' && (\n          <LibraryView\n            minutes={minutes}\n            directories={directories}\n            onSelectMinute={handleSelectMinute}\n            onOpenExport={handleOpenExport}\n            onDeleteMinute={handleDeleteMinute}\n            onDuplicateMinute={handleDuplicateMinute}\n            onNewMinute={handleNewMinute}\n          />\n        )}\n\n        {(currentView === \'editor\' || currentView === \'projects\') && (\n          <MinuteEditorView\n            minute={activeMinute}\n            onSave={handleSaveMinute}\n            onOpenExport={handleOpenExport}\n            onBack={() => setCurrentView(\'library\')}\n            allAttendees={allAttendees}\n            onOpenContactPicker={() => setContactPickerOpen(true)}\n          />\n        )}\n\n        {currentView === \'settings\' && (\n          <SettingsView onShowToast={showToast} />\n        )}\n\n        {/* Mobile Bottom Navigation Bar */}\n        <nav className=\"md:hidden w-full h-16 bg-white border-t border-[#c6c5d4]/40 flex justify-around items-center px-2 flex-shrink-0 z-30 pb-1\">\n          <button\n            onClick={() => setCurrentView(\'dashboard\')}\n            className={`flex flex-col items-center gap-0.5 text-xs font-medium cursor-pointer ${\n              currentView === \'dashboard\' ? \'text-[#000666] font-bold\' : \'text-[#767683]\'\n            }`}\n          >\n            <span\n              className={`material-symbols-outlined text-[20px] ${\n                currentView === \'dashboard\' ? \'material-symbols-fill\' : \'\'\n              }`}\n            >\n              dashboard\n            </span>\n            <span className=\"text-[10px]\">Dashboard</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'library\')}\n            className={`flex flex-col items-center gap-0.5 text-xs font-medium cursor-pointer ${\n              currentView === \'library\' ? \'text-[#000666] font-bold\' : \'text-[#767683]\'\n            }`}\n          >\n            <span\n              className={`material-symbols-outlined text-[20px] ${\n                currentView === \'library\' ? \'material-symbols-fill\' : \'\'\n              }`}\n            >\n              inventory_2\n            </span>\n            <span className=\"text-[10px]\">Library</span>\n          </button>\n\n          <button\n            onClick={handleNewMinute}\n            className=\"flex flex-col items-center justify-center -mt-5 bg-[#000666] text-white w-12 h-12 rounded-full shadow-lg cursor-pointer\"\n          >\n            <span className=\"material-symbols-outlined text-[24px]\">add</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'editor\')}\n            className={`flex flex-col items-center gap-0.5 text-xs font-medium cursor-pointer ${\n              currentView === \'editor\' ? \'text-[#000666] font-bold\' : \'text-[#767683]\'\n            }`}\n          >\n            <span\n              className={`material-symbols-outlined text-[20px] ${\n                currentView === \'editor\' ? \'material-symbols-fill\' : \'\'\n              }`}\n            >\n              folder_shared\n            </span>\n            <span className=\"text-[10px]\">Projects</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'settings\')}\n            className={`flex flex-col items-center gap-0.5 text-xs font-medium cursor-pointer ${\n              currentView === \'settings\' ? \'text-[#000666] font-bold\' : \'text-[#767683]\'\n            }`}\n          >\n            <span\n              className={`material-symbols-outlined text-[20px] ${\n                currentView === \'settings\' ? \'material-symbols-fill\' : \'\'\n              }`}\n            >\n              settings\n            </span>\n            <span className=\"text-[10px]\">Settings</span>\n          </button>\n        </nav>\n      </div>\n\n      {/* Export & Share Modal */}\n      <ExportShareModal\n        minute={exportTargetMinute}\n        isOpen={exportModalOpen}\n        onClose={() => setExportModalOpen(false)}\n        onExportSuccess={handleExportSuccess}\n      />\n\n      {/* Contact Picker Modal */}\n      <ContactPickerModal\n        isOpen={contactPickerOpen}\n        onClose={() => setContactPickerOpen(false)}\n        currentAttendees={activeMinute?.attendees || []}\n        onAddAttendee={handleAddContact}\n      />\n\n      {/* Global Toast Alert */}\n      <Toast message={toastMessage} onClose={() => setToastMessage(null)} />\n    </div>\n  );\n}\n"
    }
