{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/((?!api/|privacy\\.html|terms\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
